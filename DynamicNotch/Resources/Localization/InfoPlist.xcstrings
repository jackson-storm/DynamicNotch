          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "DynamicNotch wymaga dostępu do kalendarza, aby wyświetlać nadchodzące wydarzenia w notchu."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "DynamicNotch cần quyền truy cập lịch để hiển thị các sự kiện sắp tới trên notch."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "DynamicNotch memerlukan akses ke kalender untuk menampilkan acara mendatang di notch."
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DynamicNotch needs access to your camera to display a camera preview in the notch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "DynamicNotch necesita acceder a tu cámara para mostrar una vista previa en la muesca."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "DynamicNotch требуется доступ к камере для отображения превью камеры в вырезе."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "DynamicNotch, çentikte kamera önizlemesi göstermek için kameranıza erişmek istiyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "DynamicNotch 需要访问你的相机，以便在刘海中显示相机预览。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "DynamicNotch benötigt Zugriff auf Ihre Kamera, um eine Kameravorschau in der Notch anzuzeigen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "DynamicNotch a besoin d'accéder à votre caméra pour afficher un aperçu de la caméra dans l'encoche."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O DynamicNotch precisa de acesso à câmara para mostrar a pré-visualização no notch."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノッチにプレビューを表示するためにカメラへのアクセスが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "DynamicNotch가 노치에 카메라 미리보기를 표시하려면 카메라 접근 권한이 필요합니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "DynamicNotch ha bisogno dell'accesso alla fotocamera per mostrare l'anteprima nel notch."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "DynamicNotch wymaga dostępu do kamery, aby wyświetlać podgląd w notchu."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "DynamicNotch cần quyền truy cập camera để hiển thị bản xem trước trên notch."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "DynamicNotch memerlukan akses ke kamera untuk menampilkan pratinjau di notch."
          }
        }
      }
    },
    "NSHumanReadableCopyright": {
      "comment": "Copyright (human-readable)",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": ""
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app requires local network access to determine the name of your current Wi-Fi network."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La aplicación necesita acceso a la red local para determinar el nombre de tu red Wi-Fi actual."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложению требуется доступ к локальной сети, чтобы определить название вашей текущей сети Wi-Fi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama, geçerli Wi-Fi ağınızın adını belirlemek için yerel ağ erişimine ihtiyaç duyuyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用需要本地网络访问权限，以确定你当前 Wi-Fi 网络的名称。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App benötigt Zugriff auf das lokale Netzwerk, um den Namen Ihres aktuellen WLAN-Netzwerks zu ermitteln."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'application a besoin de l'accès au réseau local pour déterminer le nom de votre réseau Wi-Fi actuel."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A aplicação necessita de acesso à rede local para identificar o nome da sua rede Wi-Fi atual."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のWi-Fiネットワーク名を特定するためにローカルネットワークへのアクセスが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 Wi-Fi 네트워크 이름을 확인하려면 로컬 네트워크 접근 권한이 필요합니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app richiede l'accesso alla rete locale per identificare il nome della rete Wi-Fi attuale."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacja wymaga dostępu do sieci lokalnej, aby określić nazwę bieżącej sieci Wi-Fi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ứng dụng cần quyền truy cập mạng cục bộ để xác định tên mạng Wi-Fi hiện tại."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikasi memerlukan akses ke jaringan lokal untuk mengidentifikasi nama jaringan Wi-Fi saat ini."
          }
        }
      }
    }
  },
  "version": "1.1"
}
