            "value": "DynamicNotch требуется доступ к календарю для отображения предстоящих событий в вырезе."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "DynamicNotch, yaklaşan etkinlikleri çentikte göstermek için takviminize erişmek istiyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "DynamicNotch 需要访问你的日历，以便在刘海中显示即将到来的事件。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "DynamicNotch benötigt Zugriff auf Ihren Kalender, um anstehende Ereignisse in der Notch anzuzeigen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "DynamicNotch a besoin d'accéder à votre calendrier pour afficher les événements à venir dans l'encoche."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O DynamicNotch precisa de acesso ao seu calendário para apresentar os próximos eventos no notch."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノッチに予定を表示するためにカレンダーへのアクセスが必要です。"
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DynamicNotch needs access to your camera to display a camera preview in the notch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "DynamicNotch necesita acceder a tu cámara para mostrar una vista previa en la muesca."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "DynamicNotch требуется доступ к камере для отображения превью камеры в вырезе."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "DynamicNotch, çentikte kamera önizlemesi göstermek için kameranıza erişmek istiyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "DynamicNotch 需要访问你的相机，以便在刘海中显示相机预览。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "DynamicNotch benötigt Zugriff auf Ihre Kamera, um eine Kameravorschau in der Notch anzuzeigen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "DynamicNotch a besoin d'accéder à votre caméra pour afficher un aperçu de la caméra dans l'encoche."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O DynamicNotch precisa de acesso à câmara para mostrar a pré-visualização no notch."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノッチにプレビューを表示するためにカメラへのアクセスが必要です。"
          }
        }
      }
    },
    "NSHumanReadableCopyright": {
      "comment": "Copyright (human-readable)",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": ""
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app requires local network access to determine the name of your current Wi-Fi network."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La aplicación necesita acceso a la red local para determinar el nombre de tu red Wi-Fi actual."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложению требуется доступ к локальной сети, чтобы определить название вашей текущей сети Wi-Fi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama, geçerli Wi-Fi ağınızın adını belirlemek için yerel ağ erişimine ihtiyaç duyuyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用需要本地网络访问权限，以确定你当前 Wi-Fi 网络的名称。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App benötigt Zugriff auf das lokale Netzwerk, um den Namen Ihres aktuellen WLAN-Netzwerks zu ermitteln."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'application a besoin de l'accès au réseau local pour déterminer le nom de votre réseau Wi-Fi actuel."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A aplicação necessita de acesso à rede local para identificar o nome da sua rede Wi-Fi atual."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のWi-Fiネットワーク名を特定するためにローカルネットワークへのアクセスが必要です。"
          }
        }
      }
    }
  },
  "version": "1.1"
}
