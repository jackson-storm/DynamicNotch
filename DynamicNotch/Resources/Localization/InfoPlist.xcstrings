    "NSAppleEventsUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We need access to media data for display in Notch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se necesita acceso a los datos multimedia para mostrarlos en la muesca."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Требуется доступ к медиаданным для отображения в вырезе."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çentikte gösterebilmek için ortam verilerine erişim gerekiyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要访问媒体数据，以便在刘海中显示。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir benötigen Zugriff auf Mediendaten zur Anzeige in der Notch."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous avons besoin d'accéder aux données multimédias pour les afficher dans l'encoche."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Precisamos de acesso aos dados de reprodução multimédia para os apresentar no notch."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノッチにメディア再生情報を表示するためにメディアデータへのアクセスが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노치에 미디어 재생 정보를 표시하려면 미디어 데이터 접근 권한이 필요합니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È necessario l'accesso ai dati multimediali per visualizzarli nel notch."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wymagany jest dostęp do danych multimediów w celu ich wyświetlania w notchu."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cần quyền truy cập dữ liệu phương tiện để hiển thị trên notch."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memerlukan akses ke data media untuk menampilkannya di notch."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toegang tot mediagegevens is vereist om deze in de notch weer te geven."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要媒體資料存取權限才能在「瀏海」中顯示媒體內容。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Потрібен доступ до медіаданих для їх відображення у вирізі (notch)."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Åtkomst till mediedata krävs för att visa dem i flärpen (notch)."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro zobrazení médií ve výřezu je vyžadován přístup k mediálním datům."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "السماح بالتحكم في أحداث النظام لتوسيط نوافذ معاينة لقطات الشاشة والتسجيل تلقائياً على شاشة الشق."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नॉच डिस्प्ले पर स्क्रीनशॉट और रिकॉर्डिंग पूर्वावलोकन विंडो को स्वचालित रूप से केंद्रित करने के लिए सिस्टम इवेंट्स को नियंत्रित करने की अनुमति दें।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อนุญาตให้ควบคุม System Events เพื่อจัดหน้าต่างแสดงตัวอย่างภาพหน้าจอและการบันทึกให้อยู่ตรงกลางบนรอยบากโดยอัตโนมัติ"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Permiteți controlul evenimentelor de sistem pentru a centra automat ferestrele de previzualizare ale capturilor de ecran și înregistrărilor pe afișajul notch."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Engedélyezze a Rendszeresemények vezérlését a képernyőképek és felvételek előnézeti ablakainak automatikus középre igazításához a notch kijelzőn."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιτρέψτε τον έλεγχο των Συμβάντων Συστήματος για αυτόματο κεντράρισμα των παραθύρων προεπισκόπησης στιγμιότυπων οθόνης και εγγραφών στην οθόνη notch."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillad kontrol over Systemhændelser for automatisk at centrere skærmbillede- og optagelsesforhåndsvisningsvinduer på notch-skærmen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Salli järjestelmätapahtumien hallinta kuvakaappausten ja tallenteiden esikatseluikkunoiden automaattiseen keskittämiseen notch-näytölle."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillat kontroll over Systemhendelser for automatisk å sentrere forhåndsvisningsvinduer for skjermbilder og opptak på notch-skjermen."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Benarkan kawalan Acara Sistem untuk memusatkan tetingkap pratonton tangkapan skrin dan rakaman secara automatik pada paparan notch."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשר שליטה באירועי מערכת כדי למרכז אוטומטית חלונות תצוגה מקדימה של צילומי מסך והקלטות בתצוגת המגרעת."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешете контрол над Системни събития за автоматично центриране на прозорците за предварителен преглед на екранни снимки и записи върху дисплея на ноча."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Permet el control dels esdeveniments del sistema per centrar automàticament les finestres de previsualització de captures i gravacions a la pantalla del notch."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Povoľte ovládanie systémových udalostí na automatické centrovanie okien náhľadov snímok obrazovky a záznamov na displeji výrezu."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dozvolite kontrolu nad sistemskim događajima za automatsko centriranje prozora pretpregleda snimaka zaslona i snimanja na zaslonu ureza."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозволите контролу над системским догађајима за аутоматско центрирање прозора прегледа снимака екрана и снимака на екрану ноча."
          }
        }
      }
    },
    "NSBluetoothAlwaysUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app requires Bluetooth access to check the status of devices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La aplicación necesita acceso a Bluetooth para comprobar el estado de los dispositivos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложению требуется доступ к Bluetooth для проверки состояния устройств."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama, aygıtların durumunu denetlemek için Bluetooth erişimine ihtiyaç duyuyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用需要蓝牙访问权限，以检查设备状态。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App benötigt Bluetooth-Zugriff, um den Status von Geräten zu überprüfen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'application a besoin de l'accès Bluetooth pour vérifier l'état des appareils."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A aplicação necessita de acesso Bluetooth para verificar o estado dos dispositivos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスの状態を確認するためにBluetoothアクセスが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기 상태를 확인하려면 Bluetooth 접근 권한이 필요합니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app richiede l'accesso Bluetooth per verificare lo stato dei dispositivi."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacja wymaga dostępu do Bluetooth, aby sprawdzać stan urządzeń."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ứng dụng cần quyền truy cập Bluetooth để kiểm tra trạng thái thiết bị."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikasi memerlukan akses Bluetooth untuk memeriksa status perangkat."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De app heeft Bluetooth-toegang nodig om de apparaatstatus te controleren."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "應用程式需要藍牙存取權限以檢查裝置狀態。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Програмі потрібен доступ до Bluetooth для перевірки стану пристроїв."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Appen behöver Bluetooth-åtkomst för att kontrollera enhetsstatus."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikace potřebuje přístup k Bluetooth pro kontrolu stavu zařízení."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج DynamicNotch للوصول إلى البلوتوث لعرض حالة البطارية والاتصال لملحقاتك اللاسلكية."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "DynamicNotch को आपके वायरलेस एक्सेसरीज़ के लिए बैटरी और कनेक्शन स्थिति प्रदर्शित करने के लिए ब्लूटूथ एक्सेस की आवश्यकता होती है।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "DynamicNotch จำเป็นต้องเข้าถึงบลูทูธเพื่อแสดงสถานะแบตเตอรี่และการเชื่อมต่อสำหรับอุปกรณ์เสริมไร้สายของคุณ"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "DynamicNotch are nevoie de acces Bluetooth pentru a afișa nivelul bateriei și starea conexiunii pentru accesoriile fără fir."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A DynamicNotch-nak Bluetooth-hozzáférésre van szüksége a vezeték nélküli kiegészítők akkumulátorának és csatlakozási állapotának megjelenítéséhez."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το DynamicNotch χρειάζεται πρόσβαση Bluetooth για να εμφανίζει την κατάσταση μπαταρίας και σύνδεσης για τα ασύρματα αξεσουάρ σας."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "DynamicNotch har brug for Bluetooth-adgang til at vise batteri- og forbindelsesstatus for dit trådløse tilbehør."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "DynamicNotch tarvitsee Bluetooth-käyttöoikeuden näyttääkseen langattomien lisävarusteiden akun ja yhteyden tilan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "DynamicNotch trenger Bluetooth-tilgang for å vise batteri- og tilkoblingsstatus for det trådløse tilbehøret ditt."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "DynamicNotch memerlukan akses Bluetooth untuk memaparkan status bateri dan sambungan bagi aksesori wayarles anda."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "DynamicNotch זקוק לגישת Bluetooth כדי להציג את מצב הסוללה והחיבור של האביזרים האלחוטיים שלך."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "DynamicNotch се нуждае от Bluetooth достъп, за да показва състоянието на батерията и връзката на вашите безжични аксесоари."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "DynamicNotch necessita accés al Bluetooth per mostrar l'estat de la bateria i la connexió dels accessoris sense fil."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "DynamicNotch potrebuje prístup k Bluetooth na zobrazenie stavu batérie a pripojenia bezdrôtového príslušenstva."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "DynamicNotch treba pristup Bluetoothu za prikaz stanja baterije i veze vaših bežičnih dodataka."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "DynamicNotch захтева Bluetooth приступ за приказ статуса батерије и везе ваших бежичних додатака."
          }
        }
      }
    },
    "NSCalendarsFullAccessUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DynamicNotch needs access to your calendar to display upcoming events in the notch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "DynamicNotch necesita acceder a tu calendario para mostrar los próximos eventos en la muesca."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "DynamicNotch требуется доступ к календарю для отображения предстоящих событий в вырезе."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "DynamicNotch, yaklaşan etkinlikleri çentikte göstermek için takviminize erişmek istiyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "DynamicNotch 需要访问你的日历，以便在刘海中显示即将到来的事件。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "DynamicNotch benötigt Zugriff auf Ihren Kalender, um anstehende Ereignisse in der Notch anzuzeigen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "DynamicNotch a besoin d'accéder à votre calendrier pour afficher les événements à venir dans l'encoche."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O DynamicNotch precisa de acesso ao seu calendário para apresentar os próximos eventos no notch."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノッチに予定を表示するためにカレンダーへのアクセスが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "DynamicNotch가 예정된 이벤트를 노치에 표시하려면 캘린더 접근 권한이 필요합니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "DynamicNotch ha bisogno dell'accesso al calendario per mostrare i prossimi eventi nel notch."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "DynamicNotch wymaga dostępu do kalendarza, aby wyświetlać nadchodzące wydarzenia w notchu."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "DynamicNotch cần quyền truy cập lịch để hiển thị các sự kiện sắp tới trên notch."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "DynamicNotch memerlukan akses ke kalender untuk menampilkan acara mendatang di notch."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "DynamicNotch heeft toegang tot Agenda nodig om komende evenementen in de notch weer te geven."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "DynamicNotch 需要行事曆存取權限以在「瀏海」中顯示即將發生的行程。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "DynamicNotch потребує доступу до Календаря для відображення найближчих подій у вирізі."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "DynamicNotch behöver åtkomst till Kalender för att visa kommande händelser i flärpen."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "DynamicNotch potřebuje přístup ke Kalendáři pro zobrazení nadcházejících událostí ve výřezu."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج DynamicNotch للوصول الكامل للتقويم لعرض أحداثك القادمة في الشق."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नॉच में आपके आगामी ईवेंट प्रदर्शित करने के लिए DynamicNotch को पूर्ण कैलेंडर एक्सेस की आवश्यकता है।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "DynamicNotch จำเป็นต้องเข้าถึงปฏิทินแบบเต็มเพื่อแสดงกิจกรรมที่จะเกิดขึ้นในรอยบาก"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "DynamicNotch are nevoie de acces complet la calendar pentru a afișa evenimentele viitoare în notch."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A DynamicNotch-nak teljes naptár-hozzáférésre van szüksége a közelgő események notch-ban való megjelenítéséhez."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το DynamicNotch χρειάζεται πλήρη πρόσβαση στο ημερολόγιο για να εμφανίζει τα επερχόμενα συμβάντα σας στο notch."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "DynamicNotch har brug for fuld kalenderadgang for at vise dine kommende begivenheder i notchen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "DynamicNotch tarvitsee täydet kalenterin käyttöoikeudet tulevien tapahtumien näyttämiseen notchissa."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "DynamicNotch trenger full kalendertilgang for å vise dine kommende hendelser i notchen."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "DynamicNotch memerlukan akses kalendar penuh untuk memaparkan acara akan datang anda di notch."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "DynamicNotch זקוק לגישה מלאה ללוח השנה כדי להציג את האירועים הקרובים שלך במגרעת."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "DynamicNotch се нуждае от пълен достъп до календара, за да показва предстоящите ви събития в ноча."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "DynamicNotch necessita accés complet al calendari per mostrar els propers esdeveniments al notch."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "DynamicNotch potrebuje úplný prístup ku kalendáru na zobrazenie nadchádzajúcich udalostí vo výreze."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "DynamicNotch treba potpuni pristup kalendaru za prikaz vaših nadolazećih događaja u urezu."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "DynamicNotch захтева пун приступ календару за приказ ваших предстојећих догађаја у ночу."
          }
        }
      }
    },
