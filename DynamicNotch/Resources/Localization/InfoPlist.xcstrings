    "NSContactsUsageDescription" : {
      "comment" : "Privacy - Contacts Usage Description",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتاج DynamicNotch إلى الوصول إلى جهات اتصالك لإظهار أسماء المرسلين وصورهم في إشعارات الرسائل."
