    "settings.battery.lowBatteryStyle.headerDesc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose whether the alert uses the current detailed card or a compact charging-like layout."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige si la alerta usa la tarjeta detallada actual o un diseño compacto tipo carga."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите, использует ли уведомление подробную карточку или компактный стиль зарядки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择警报使用当前详细卡片还是紧凑的充电式布局。"
