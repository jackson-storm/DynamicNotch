            "value": "您可以通过右键点击刘海区域访问菜单。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Menüye, çentik alanına sağ tıklayarak erişebilirsiniz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst das Menü auch durch Rechtsklick auf den Notch-Bereich öffnen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez également accéder au menu par un clic droit sur la zone de l'encoche."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Também pode aceder ao menu clicando com o botão direito na área do notch."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノッチ領域を右クリックしてメニューにアクセスすることもできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노치 영역을 마우스 우클릭하여 메뉴에 접근할 수도 있습니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi anche accedere al menu facendo clic con il tasto destro sull'area del notch."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz także uzyskać dostęp do menu, klikając prawym przyciskiem myszy obszar notcha."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn cũng có thể truy cập menu bằng cách nhấp chuột phải vào vùng notch."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda juga dapat mengakses menu dengan mengklik kanan area notch."
          }
        }
      }
    },
    "settings.timer.activity.desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show the active Clock timer in the notch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar el temporizador activo del Reloj en la muesca."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отображать активный таймер приложения «Часы» в вырезе."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在刘海中显示活动中的“时钟”计时器。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etkin Saat zamanlayıcısını çentikte göster."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiven System-Timer der Uhr-App in der Notch anzeigen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher le minuteur actif de l'application Horloge dans l'encoche."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Apresentar o temporizador ativo da aplicação Relógio no notch."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「時計」アプリのアクティブなタイマーをノッチに表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노치에 '시계' 앱의 활성 타이머를 표시합니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra il timer attivo dell'app Orologio nel notch."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokaż aktywny minutnik aplikacji Zegar w notchu."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiển thị bộ hẹn giờ đang hoạt động của ứng dụng Đồng hồ trong notch."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tampilkan pengatur waktu aktif aplikasi Jam di notch."
          }
        }
      }
    },
