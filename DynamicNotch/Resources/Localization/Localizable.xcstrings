          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schakel warmere tinten in om vermoeidheid van de ogen 's nachts te verminderen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Włącz cieplejsze tony, aby zmniejszyć zmęczenie oczu w nocy."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ativar tons mais quentes para reduzir o cansaço visual durante a noite."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
