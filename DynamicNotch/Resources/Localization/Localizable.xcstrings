          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrýt tlačítko výstupního zařízení v rozbalených ovládacích prvcích."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إزالة زر جهاز الإخراج من عناصر تحكم المشغّل الموسّع."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "विस्तारित प्लेयर नियंत्रणों से आउटपुट डिवाइस बटन हटाएं।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบปุ่มอุปกรณ์เอาต์พุตออกจากการควบคุมเครื่องเล่นแบบขยาย"
          }
