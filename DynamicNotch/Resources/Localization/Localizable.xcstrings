            "state": "translated",
            "value": "Kies hoe lang de helderheids-HUD zichtbaar blijft."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇亮度 HUD 保持可見的時間。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть, як довго HUD яскравості залишатиметься видимим."
          }
        },
