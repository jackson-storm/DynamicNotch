    "settings.permissions.automation.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "السماح بالتحكم في أحداث النظام لتوسيط نوافذ معاينة لقطات الشاشة والتسجيل تلقائياً."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешете контрол над Системни събития за автоматично центриране на прозорците."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "স্বয়ংক্রিয়ভাবে উইন্ডো কেন্দ্রে রাখার জন্য সিস্টেম ইভেন্টগুলির নিয়ন্ত্রণের অনুমতি দিন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permet el control dels esdeveniments del sistema per centrar automàticament les finestres."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povolte ovládání Systémových událostí pro automatické vystředění oken náhledu záznamů a snímků na obrazovce."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillad kontrol over Systemhændelser til automatisk centrering af forhåndsvisningsvinduer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steuerung von Systemeignissen erlauben, um Vorschaufenster von Screenshots und Aufnahmen auf dem Bildschirm zu zentrieren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιτρέψτε τον έλεγχο των Συμβάντων Συστήματος για αυτόματο κεντράρισμα των παραθύρων προεπισκόπησης."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow controlling System Events to automatically center screenshot and recording preview windows on screen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite el control de System Events para centrar automáticamente las ventanas de vista previa en la pantalla."
