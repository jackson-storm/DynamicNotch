    "settings.hud.keyboard.desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replace the system keyboard brightness overlay with a custom HUD in the notch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reemplazar la superposición de brillo del teclado con un HUD personalizado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заменить системное наложение яркости клавиатуры пользовательским HUD в вырезе."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用刘海中的自定义 HUD 替换系统键盘亮度叠加层。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem klavye parlaklığı göstergesini çentikteki özel HUD ile değiştir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "System-Tastaturbeleuchtungsanzeige durch einen eigenen HUD in der Notch ersetzen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplacer l'affichage système de la luminosité du clavier par un HUD dans l'encoche."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Substituir a apresentação de brilho do teclado do sistema por um HUD no notch."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム標準のキーボード輝度表示をノッチHUDに置き換えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 키보드 밝기 표시를 노치 HUD로 대체합니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sostituisci la luminosità della tastiera di sistema con un HUD nel notch."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zastąp systemowy wskaźnik jasności klawiatury HUD-em w notchu."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thay thế hiển thị độ sáng bàn phím hệ thống bằng HUD trong notch."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ganti tampilan kecerahan keyboard sistem dengan HUD di notch."
          }
        }
      }
    },
