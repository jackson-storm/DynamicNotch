    "settings.hud.indicatorStyle.desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose between bar and circular indicator."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige entre indicador en barra o circular."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите между линейным и круговым индикатором."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择条形或圆形指示器。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çubuk ve dairesel gösterge arasında seçim yapın."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwischen linearem Balken und kreisförmigem Indikator wählen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisir entre un indicateur linéaire et un indicateur circulaire."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolher entre um indicador linear e um indicador circular."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リニアインジケータかサークルインジケータかを選択します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선형 표시기와 원형 표시기 중 선택하세요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli tra un indicatore lineare e uno circolare."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz między wskaźnikiem liniowym a kołowym."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
