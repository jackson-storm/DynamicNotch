    "settings.general.system.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Manage launch options, Dock, and menu bar icon visibility."
          }
        },
        "es": {
