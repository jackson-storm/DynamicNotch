          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "নতুন মেল বিজ্ঞপ্তি কতক্ষণ নচে প্রদর্শিত হবে তা নির্বাচন করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
