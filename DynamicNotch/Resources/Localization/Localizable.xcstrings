    "settings.focus.style.headerDesc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose whether Focus shows the On and Off labels or only the moon icon."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige si Enfoque muestra las etiquetas de activado/desactivado o solo el icono de luna."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите, показывает ли Фокусирование надписи Вкл/Выкл или только значок луны."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择专注模式是显示开/关标签还是仅显示月亮图标。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odak'ın Açık ve Kapalı etiketlerini mi yoksa yalnızca ay simgesini mi göstereceğini seçin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle, ob Fokus die Beschriftungen „Ein“ und „Aus“ oder nur das Mondsymbol anzeigt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez si Concentration affiche les libellés Activé/Désactivé ou uniquement l'icône de lune."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha se a Concentração mostra etiquetas Ativado/Desativado ou apenas o ícone da lua."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "集中モードでオン/オフラベルを表示するか、月のアイコンのみを表示するかを選択します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "집중 모드에서 켬/끔 텍스트를 표시할지 달 아이콘만 표시할지 선택하세요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli se Full immersion mostra le etichette Attiva/Non attiva o solo l'icona della luna."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz, czy tryb Skupienia ma wyświetlać etykiety Wł./Wył., czy tylko ikonę księżyca."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn xem Tập trung có hiển thị nhãn Bật/Tắt hay chỉ biểu tượng mặt trăng."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih apakah Fokus menampilkan label Nyala/Mati atau hanya ikon bulan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies of Focus de labels Aan/Uit toont of alleen het maansymbool."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇專注模式顯示開/關標籤或僅顯示月亮圖示。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть, чи показувати в режимі Фокусування написи Увімк/Вимк, або лише значок місяця."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj om fokusläget ska visa etiketter för På/Av eller bara månikonen."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvolte, zda režim Soustředění zobrazuje štítky Zapnuto/Vypnuto, nebo pouze ikonu měsíce."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر ما إذا كان التركيز يعرض عبارات التشغيل والإيقاف أو أيقونة القمر فقط."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चुनें कि क्या फ़ोकस चालू/बंद लेबल दिखाए या केवल चंद्रमा आइकन।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกว่าจะให้โฟกัสแสดงป้ายกำกับเปิด/ปิดหรือแสดงเฉพาะไอคอนดวงจันทร์"
          }
        }
      }
    },
