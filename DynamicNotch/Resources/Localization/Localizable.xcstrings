            "state": "translated",
            "value": "Naciśnij i przytrzymaj"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấn và giữ"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekan dan Tahan"
          }
        }
      }
    },
    "settings.notch.gestures.expandActivity.desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow the selected notch gesture to open the expanded live activity layout when supported."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir que el gesto seleccionado abra la vista expandida de la actividad en vivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Позволить выбранному жесту выреза открывать расширенный вид живой активности."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许选定的刘海手势打开展开的实时活动布局。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçilen çentik hareketinin, desteklendiğinde genişletilmiş canlı etkinlik düzenini açmasına izin ver."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgewählte Notch-Geste zum Öffnen der erweiterten Ansicht erlauben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autoriser le geste sélectionné pour ouvrir la vue agrandie de l'activité en direct."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir o gesto selecionado para abrir a vista expandida da atividade em tempo real."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブアクティビティの展開表示を開くジェスチャを許可します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실시간 활동의 확장 보기를 열 수 있는 제스처를 허용합니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti il gesto selezionato per aprire la vista espansa dell'attività in tempo reale."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zezwalaj na wybrany gest, aby otworzyć rozwinięty widok aktywności na żywo."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho phép cử chỉ đã chọn mở chế độ xem mở rộng của hoạt động trực tiếp."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izinkan gerakan yang dipilih untuk membuka tampilan aktivitas langsung yang diperluas."
          }
        }
      }
    },
