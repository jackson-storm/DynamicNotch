            "value" : "แสดงการแจ้งเตือนสั้นๆ เมื่อการเชื่อมต่อ VPN เริ่มทำงาน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir VPN bağlantısı etkin hale geldiğinde kısa bir bildirim göster."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показувати коротке сповіщення, коли VPN-з'єднання стає активним."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiển thị thông báo ngắn khi kết nối VPN hoạt động."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VPN 连接激活时显示短暂通知。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當 VPN 連線變為使用中時顯示簡短通知。"
          }
        }
      }
    },
    "settings.wifi.appearance.headerDesc" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر ما إذا كان نشاط نقطة الاتصال يبقى مبسّطاً أو يعرض حالة أكثر."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изберете дали дейността на точката за достъп да остане минималистична или да показва повече статус."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "হটস্পট অ্যাক্টিভিটি মিনিমাল থাকবে নাকি আরও স্থিতি দেখাবে তা চয়ন করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tria si l'activitat del punt d'accés es manté minimalista o mostra més estat."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zvolte, zda aktivita osobního hotspotu zůstane minimální, nebo zobrazí více podrobností."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg, om hotspot-aktiviteten forbliver minimalistisk eller viser mere status."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle, ob die Hotspot-Aktivität minimal bleibt oder mehr Status anzeigt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιλέξτε αν η δραστηριότητα hotspot παραμένει μινιμαλιστική ή εμφανίζει περισσότερη κατάσταση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose whether the hotspot activity stays minimal or shows more status."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige si la actividad del punto de acceso se mantiene mínima o muestra más estado."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انتخاب کنید که فعالیت هات‌اسپات مینیمال بماند یا وضعیت بیشتری را نشان دهد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valitse, pysyykö yhteyspistetoiminta minimaalisena vai näyttääkö se enemmän tilaa."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piliin kung mananatiling minimal ang aktibidad ng hotspot o magpapakita ng higit pang katayuan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez si l'activité de partage de connexion reste minimale ou affiche plus de détails."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בחר אם פעילות הנקודה החמה תישאר מינימלית או תציג יותר מצב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चुनें कि हॉटस्पॉट गतिविधि न्यूनतम रहे या अधिक स्थिति दिखाए।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odaberite ostaje li aktivnost pristupne točke minimalistička ili prikazuje više informacija."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Válassza ki, hogy a hotspot tevékenység minimális maradjon vagy több állapotot mutasson."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih apakah aktivitas hotspot tetap minimal atau menampilkan lebih banyak detail."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli se l'attività di hotspot rimane minimale o mostra maggiori dettagli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "インターネット共有のアクティビティを最小限にするか、詳細を表示するかを選択します。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кіру нүктесі әрекетінің минималистік болуын немесе қосымша күйді көрсетуін таңдаңыз."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "개인용 핫스팟 활동을 미니멀하게 유지할지 더 많은 세부 정보를 표시할지 선택하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih sama ada aktiviti hotspot kekal minimalis atau menunjukkan lebih banyak status."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velg om delt internett-aktiviteten forblir minimalistisk eller viser mer status."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies of de activiteit van de persoonlijke hotspot minimaal blijft of meer details toont."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz, czy aktywność hotspotu ma pozostać minimalna, czy pokazywać więcej szczegółów."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha se a atividade de partilha de internet permanece mínima ou apresenta mais detalhes."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alegeți dacă activitatea hotspotului rămâne minimalistă sau afișează mai multă stare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите, остаётся ли активность точки доступа минимальной или показывает больше информации."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyberte, či aktivita hotspotu zostane minimalistická alebo zobrazí viac informácií."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изаберите да ли активност приступне тачке остаје минималистичка или приказује више информација."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Välj om internetdelningsaktiviteten ska förbli minimal eller visa fler detaljer."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เลือกว่ากิจกรรมฮอตสปอตจะแสดงแบบมินิมอลหรือแสดงสถานะเพิ่มเติม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erişim noktası etkinliğinin minimal mi kalacağını yoksa daha fazla durum mu göstereceğini seçin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Виберіть, чи показувати активність точки доступу мінімалістично, чи з додатковими деталями."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chọn xem hoạt động điểm phát sóng vẫn tối giản hay hiển thị thêm chi tiết."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择热点活动是保持简约还是显示更多状态。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選擇個人熱點活動保持極簡或顯示更多詳細資訊。"
          }
        }
      }
