    "settings.hud.indicatorGlow.desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تفعيل تأثير توهج خفيف حول مؤشر تقدم العرض."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Активирайте фин ефект на сияние около индикатора за напредък на HUD."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HUD অগ্রগতি নির্দেশকের চারপাশে একটি সূক্ষ্ম আভা সক্ষম করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa un efecte de brillantor subtil al voltant de l'indicador de progrés del HUD."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapněte jemný efekt záře kolem indikátoru průběhu HUD."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiver en subtil glødeffekt omkring HUD-statusindikatoren."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dezenten Leuchteffekt um den HUD-Fortschrittsbalken aktivieren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ενεργοποίηση διακριτικού εφέ λάμψης γύρω από τον δείκτη προόδου HUD."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enable subtle glow effect around HUD progress indicator."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Habilitar efecto de brillo sutil en el indicador de HUD."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فعال‌سازی درخشش ملایم در اطراف نشانگر پیشرفت HUD."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ota käyttöön hienovarainen hehku HUD-edistymisilmaisimen ympärillä."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paganahin ang banayad na glow sa paligid ng progress indicator ng HUD."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activer un léger effet de lueur autour de la barre de progression du HUD."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אפשר אפקט זוהר עדין סביב מחוון ההתקדמות של ה-HUD."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HUD प्रगति संकेतक के चारों ओर सूक्ष्म चमक प्रभाव सक्षम करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omogućite suptilni sjaj oko indikatora napretka HUD-a."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finom ragyogási hatás engedélyezése a HUD folyamatjelzője körül."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktifkan efek cahaya halus di sekitar bilah kemajuan HUD."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abilita un leggero effetto bagliore attorno alla barra di avanzamento dell'HUD."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HUDプログレスバーの周囲に微細なグロー効果を有効にします。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HUD барысы индикаторының айналасында нәзік жарқырауды қосу."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HUD 진행률 바 주변에 은은한 글로우 효과를 활성화합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dayakan kesan cahaya halus di sekeliling penunjuk kemajuan HUD."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiver en subtil glødeffekt rundt HUD-fremdriftsindikatoren."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schakel een zacht gloeieffect in rond de HUD-voortgangsbalk."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Włącz subtelny efekt poświaty wokół paska postępu HUD."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ativar um efeito subtil de brilho à volta da barra de progresso do HUD."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activați un efect subtil de strălucire în jurul indicatorului de progres HUD."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включить эффекты свечения вокруг полосы прогресса HUD."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povoliť jemný efekt žiary okolo indikátora priebehu HUD."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Омогућите суптилни сјај око индикатора напретка HUD-а."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
