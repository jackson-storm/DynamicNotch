    "settings.calendar.ongoingHide.desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose when to hide the activity for an ongoing event."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige cuándo ocultar la actividad de un evento en curso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите момент скрытия карточки после начала события."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择何时隐藏进行中的事件活动。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Devam eden bir etkinliğin ne zaman gizleneceğini seçin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle, wann die Aktivität für ein laufendes Ereignis ausgeblendet wird."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez quand masquer l'activité d'un événement en cours."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha quando ocultar a atividade de um evento em curso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "進行中のイベントアクティビティを非表示にするタイミングを選択します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "진행 중인 이벤트 활동을 숨길 시점을 선택하세요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli quando nascondere l'attività di un evento in corso."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz, kiedy ukryć aktywność trwającego wydarzenia."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn thời điểm ẩn hoạt động sự kiện đang diễn ra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih kapan menyembunyikan aktivitas acara yang sedang berlangsung."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies wanneer de activiteit van een lopend evenement moet worden verborgen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇何時隱藏進行中行程的活動。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть, коли приховувати активність поточної події."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj när aktiviteten för en pågående händelse ska döljas."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvolte, kdy skrýt aktivitu probíhající události."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose when to hide the activity for an ongoing event."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose when to hide the activity for an ongoing event."
          }
        }
      }
    },
