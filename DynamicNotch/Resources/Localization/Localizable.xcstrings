    "settings.permissions.accessibility.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "السماح بالوصول إلى إمكانية الوصول للتعامل مع الإيماءات ومراقبة التطبيقات النشطة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешете достъп за достъпност за обработка на жестове и наблюдение на активни приложения."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অঙ্গভঙ্গি পরিচালনা এবং সক্রিয় অ্যাপ নিরীক্ষণ করতে অ্যাক্সেসিবিলিটি অ্যাক্সেসের অনুমতি দিন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permet l'accés d'accessibilitat per gestionar gestos i supervisar aplicacions actives."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povolte přístup ke Zpřístupnění pro zpracování gest a sledování aktivních aplikací."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillad Tilgængelighedsadgang til at håndtere bevægelser og overvåge aktive apps."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bedienungshilfen-Zugriff erlauben, um Gesten zu verarbeiten und aktive Anwendungen zu überwachen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιτρέψτε την πρόσβαση στην Προσβασιμότητα για χειρισμό χειρονομιών και παρακολούθηση ενεργών εφαρμογών."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow Accessibility access to handle gestures and monitor active applications."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite el acceso a Accesibilidad para gestionar gestos y supervisar aplicaciones activas."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اجازه دسترسی به قابلیت دسترسی برای مدیریت ژست‌ها و نظارت بر برنامه‌های فعال."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
