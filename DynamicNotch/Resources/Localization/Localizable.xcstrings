    "settings.support.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DynamicNotch هو مشروع مجاني ومفتوح المصدر. إذا أعجبك التطبيق، ادعم تطويره! التبرعات تساعد في تغطية التطوير والصيانة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DynamicNotch е безплатен проект с отворен код. Ако ви харесва, подкрепете разработката му!"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DynamicNotch একটি বিনামূল্যের ওপেন সোর্স প্রকল্প। আপনি যদি অ্যাপটি পছন্দ করেন তবে এর বিকাশকে সমর্থন করুন!"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DynamicNotch és un projecte gratuït de codi obert. Si t'agrada l'aplicació, dona suport al seu desenvolupament!"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DynamicNotch je bezplatný open-source projekt. Pokud se vám aplikace líbí, podpořte její vývoj! Vaše dary motivují k vytváření nových funkcí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DynamicNotch er et gratis open source-projekt. Hvis du kan lide appen, så støt dens udvikling!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DynamicNotch ist ein kostenloses Open-Source-Projekt. Wenn dir die App gefällt, unterstütze die Weiterentwicklung! Spenden motivieren, das Projekt weiter auszubauen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το DynamicNotch είναι ένα δωρεάν έργο ανοιχτού κώδικα. Εάν σας αρέσει η εφαρμογή, υποστηρίξτε την ανάπτυξή της!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DynamicNotch is a free, open-source project. If you like the app, support its development! Donations motivate to develop the project further."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DynamicNotch es un proyecto gratuito y de código abierto. Si te gusta la aplicación, ¡apoya su desarrollo! Las donaciones motivan a seguir desarrollando el proyecto."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DynamicNotch یک پروژه رایگان و متن‌باز است. اگر از برنامه لذت می‌برید، از توسعه آن حمایت کنید!"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DynamicNotch on ilmainen, avoimen lähdekoodin projekti. Jos pidät sovelluksesta, tue sen kehitystä!"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ang DynamicNotch ay isang libreng open-source na proyekto. Kung nagustuhan mo ang app, suportahan ang pagbuo nito!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DynamicNotch est un projet gratuit et open-source. Si vous appréciez l'application, soutenez son développement ! Vos dons motivent la création de nouvelles fonctionnalités."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DynamicNotch הוא פרויקט קוד פתוח בחינם. אם אתה נהנה מהאפליקציה, תמוך בפיתוח שלה!"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DynamicNotch एक मुफ्त, ओपन-सोर्स प्रोजेक्ट है। यदि आप ऐप पसंद करते हैं, तो इसके विकास का समर्थन करें!"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DynamicNotch je besplatan projekt otvorenog koda. Ako vam se sviđa aplikacija, podržite njezin razvoj!"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A DynamicNotch egy ingyenes, nyílt forráskódú projekt. Ha tetszik az alkalmazás, támogassa a fejlesztését!"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DynamicNotch adalah proyek gratis dan sumber terbuka. Jika Anda menyukai aplikasi ini, dukung pengembangannya! Donasi Anda memotivasi pembuatan fitur-fitur baru."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DynamicNotch è un progetto gratuito e open-source. Se ti piace l'app, sostieni il suo sviluppo! Le tue donazioni motivano la creazione di nuove funzionalità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DynamicNotchは無料のオープンソースプロジェクトです。アプリを気に入っていただけましたら、ぜひ開発のサポートをご検討ください！皆様のご支援が新機能開発の原動力となります。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DynamicNotch — тегін ашық бастапқы кодты жоба. Егер қолданба ұнаса, оның дамуын қолдаңыз!"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DynamicNotch는 무료 오픈 소스 프로젝트입니다. 앱이 마음에 드신다면 개발을 후원해 주세요! 여러분의 기부는 새로운 기능 개발에 큰 힘이 됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DynamicNotch ialah projek sumber terbuka percuma. Jika anda suka aplikasi ini, sokong pembangunannya!"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DynamicNotch er et gratis åpen kildekode-prosjekt. Hvis du liker appen, støtt utviklingen dens!"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DynamicNotch is een gratis en opensource project. Als je de app leuk vindt, steun dan de ontwikkeling! Jouw donaties motiveren het maken van nieuwe functies."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DynamicNotch to darmowy projekt open-source. Jeśli podoba Ci się aplikacja, wesprzyj jej rozwój! Twoje darowizny motywują do tworzenia nowych funkcji."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O DynamicNotch é um projeto gratuito e de código aberto. Se aprecia a aplicação, considere apoiar o seu desenvolvimento! Os seus donativos motivam a criação de novas funcionalidades."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DynamicNotch este un proiect gratuit, cu sursă deschisă. Dacă vă place aplicația, susțineți dezvoltarea ei!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DynamicNotch — бесплатный проект с открытым исходным кодом. Если вам нравится приложение, поддержите его разработку! Донаты мотивируют развивать проект дальше."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DynamicNotch je bezplatný open-source projekt. Ak sa vám aplikácia páči, podporte jej vývoj!"
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DynamicNotch је бесплатан пројекат отвореног кода. Ако вам се свиђа апликација, подржите њен развој!"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DynamicNotch är ett gratis projekt med öppen källkod. Om du gillar appen, stöd dess utveckling! Dina donationer motiverar skapandet av nya funktioner."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DynamicNotch เป็นโครงการฟรีและโอเพ่นซอร์ส หากคุณชอบแอปนี้ โปรดสนับสนุนการพัฒนา!"
          }
