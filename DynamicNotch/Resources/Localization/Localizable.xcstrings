          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alegeți dacă activitatea VPN rămâne compactă sau afișează detalii despre tunel."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите, остаётся ли активность VPN компактной или показывает детали туннеля."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyberte, či aktivita VPN zostane kompaktná alebo zobrazí podrobnosti tunela."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изаберите да ли VPN активност остаје компактна или приказује детаље тунела."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Välj om VPN-aktiviteten ska förbli kompakt eller visa tunneldetaljer."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เลือกว่ากิจกรรม VPN จะคงความกะทัดรัดหรือแสดงรายละเอียดอุโมงค์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VPN etkinliğinin kompakt mı kalacağını yoksa tünel ayrıntılarını mı göstereceğini seçin."
