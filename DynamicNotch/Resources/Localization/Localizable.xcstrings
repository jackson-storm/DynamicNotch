    "settings.notifications.appleMail.fullDiskAccess.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتاج DynamicNotch إلى الوصول الكامل إلى القرص لقراءة قاعدة بيانات رسائل Apple Mail المحلية وعرض إشعارات البريد الواردة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DynamicNotch се нуждае от пълен достъп до диска, за да чете локалната база данни със съобщения на Apple Mail и да показва известия."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ইনকামিং মেল বিজ্ঞপ্তিগুলি প্রদর্শন করতে Apple Mail-এর স্থানীয় বার্তা ডেটাবেস পড়তে DynamicNotch-এর সম্পূর্ণ ডিস্ক অ্যাক্সেস প্রয়োজন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DynamicNotch necessita accés total al disc per llegir la base de dades local de missatges d'Apple Mail i mostrar notificacions de correu entrant."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DynamicNotch potřebuje úplný přístup k disku, aby mohl číst místní databázi zpráv Apple Mail a zobrazovat příchozí oznámení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DynamicNotch skal bruge fuld diskadgang for at læse Apple Mails lokale beskeddatabase og vise indgående mail-notifikationer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DynamicNotch benötigt Festplattenvollzugriff, um die lokale Apple Mail-Nachrichtendatenbank zu lesen und eingehende Mitteilungen anzuzeigen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το DynamicNotch χρειάζεται πλήρη πρόσβαση στο δίσκο για να διαβάσει την τοπική βάση δεδομένων μηνυμάτων του Apple Mail και να εμφανίσει ειδοποιήσεις."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DynamicNotch needs Full Disk Access to read Apple Mail’s local message database and display incoming Mail notifications."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DynamicNotch necesita acceso total al disco para leer la base de datos local de mensajes de Apple Mail y mostrar las notificaciones de correo entrante."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برنامه DynamicNotch برای خواندن پایگاه داده پیام‌های محلی Apple Mail و نمایش اعلان‌های ایمیل به دسترسی کامل به دیسک نیاز دارد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DynamicNotch tarvitsee täyden levyn käyttöoikeuden lukeakseen Apple Mailin paikallista viestitietokantaa ja näyttääkseen saapuvat ilmoitukset."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kailangan ng DynamicNotch ng Buong Access sa Disk upang basahin ang lokal na database ng mensahe ng Apple Mail at magpakita ng mga notification."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DynamicNotch a besoin de l'Accès complet au disque pour lire la base de données locale des messages d'Apple Mail et afficher les notifications."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‏DynamicNotch זקוק לגישה מלאה לדיסק כדי לקרוא את מסד הנתונים של Apple Mail ולהציג עדכוני דואר נכנס."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इनकमिंग मेल नोटिफ़िकेशन दिखाने के लिए Apple Mail के स्थानीय मैसेज डेटाबेस को पढ़ने के लिए DynamicNotch को पूर्ण डिस्क एक्सेस की आवश्यकता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DynamicNotch treba potpuni pristup disku za čitanje lokalne baze podataka poruka Apple Maila i prikaz dolaznih obavijesti."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A DynamicNotch-nak teljes lemezhozzáférésre van szüksége az Apple Mail helyi üzenetadatbázisának olvasásához és az értesítések megjelenítéséhez."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DynamicNotch memerlukan Akses Disk Penuh untuk membaca basis data pesan lokal Apple Mail dan menampilkan pemberitahuan Mail masuk."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DynamicNotch necessita dell'Accesso completo al disco per leggere il database locale dei messaggi di Apple Mail e mostrare le notifiche."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DynamicNotchがApple Mailのローカルメッセージデータベースを読み取って新規メール通知を表示するには、フルディスクアクセスが必要です。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DynamicNotch қолданбасына кіріс хаттардың хабарландыруларын көрсету үшін Apple Mail дерекқорын оқуға толық қолжетімділік қажет."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DynamicNotch가 Apple Mail의 로컬 메시지 데이터베이스를 읽고 수신 메일 알림을 표시하려면 전체 디스크 접근 권한이 필요합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DynamicNotch memerlukan Akses Cakera Penuh untuk membaca pangkalan data mesej setempat Apple Mail dan memaparkan pemberitahuan Mail masuk."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DynamicNotch trenger full disktilgang for å lese den lokale meldingsdatabasen til Apple Mail og vise varsler om innkommende e-post."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DynamicNotch heeft volledige schijftoegang nodig om de lokale berichtendatabase van Apple Mail te lezen en inkomende meldingen te tonen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DynamicNotch potrzebuje pełnego dostępu do dysku, aby odczytywać lokalną bazę wiadomości Apple Mail i wyświetlać powiadomienia."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O DynamicNotch necessita de Acesso Total ao Disco para ler a base de dados local de mensagens do Apple Mail e apresentar notificações."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DynamicNotch are nevoie de acces complet la disc pentru a citi baza de date locală de mesaje Apple Mail și a afișa notificările primite."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DynamicNotch требуется полный доступ к диску для чтения локальной базы сообщений Apple Mail и отображения уведомлений о новых письмах."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DynamicNotch potrebuje úplný prístup k disku na čítanie lokálnej databázy správ Apple Mailu a zobrazovanie hlásení."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DynamicNotch захтева пун приступ диску за читање локалне базе порука апликације Apple Mail и приказивање обавештења."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DynamicNotch behöver full skivbehörighet för att läsa Apple Mails lokala meddelandedatabas och visa inkommande mejlnotiser."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DynamicNotch ต้องใช้สิทธิ์เข้าถึงดิสก์แบบเต็มเพื่ออ่านฐานข้อมูลข้อความในเครื่องของ Apple Mail และแสดงการแจ้งเตือนเมลขาเข้า"
