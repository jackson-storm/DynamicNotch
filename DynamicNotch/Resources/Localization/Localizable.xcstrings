    "settings.notch.height.desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fine-tune the height of the notch or Dynamic Island."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustar la altura de la muesca o Dynamic Island."
          }
        },
        "ru": {
