    "settings.permissions.accessibility.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Accessibility access to handle gestures and monitor active applications."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите доступ к Универсальному доступу для обработки жестов и отслеживания активных приложений."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite el acceso a Accesibilidad para gestionar gestos y supervisar aplicaciones activas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许辅助功能权限以处理手势和监控活动应用。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hareketleri işlemek ve etkin uygulamaları izlemek için Erişilebilirlik erişimine izin verin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bedienungshilfen-Zugriff erlauben, um Gesten zu verarbeiten und aktive Anwendungen zu überwachen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autoriser l'accès à l'Accessibilité pour gérer les gestes et surveiller les applications actives."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir acesso à Acessibilidade para gerir gestos e monitorizar aplicações ativas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ジェスチャの処理とアクティブなアプリケーションの監視のためにアクセシビリティへのアクセスを許可します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제스처 처리 및 활성 응용 프로그램을 모니터링하기 위해 손쉬운 사용 권한을 허용합니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti l'accesso ad Accessibilità per gestire i gesti e monitorare le applicazioni attive."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zezwól na dostęp do Dostępności, aby obsługiwać gesty i monitorować aktywne aplikacje."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho phép truy cập Trợ năng để xử lý cử chỉ và giám sát các ứng dụng đang hoạt động."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izinkan akses ke Aksesibilitas untuk menangani gerakan dan memantau aplikasi aktif."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verleen toegang tot Toegankelijkheid om gebaren af te handelen en actieve programma's te controleren."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許輔助使用權限以處理手勢並監控作用中的應用程式。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Надайте доступ до Спеціальних можливостей для обробки жестів та моніторингу активних програм."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ge åtkomst till Hjälpmedel för att hantera gester och övervaka aktiva program."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Povolte přístup ke Zpřístupnění pro zpracování gest a sledování aktivních aplikací."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "السماح بالوصول إلى إمكانية الوصول للتعامل مع الإيماءات ومراقبة التطبيقات النشطة."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इशारों को संभालने और सक्रिय अनुप्रयोगों की निगरानी के लिए एक्सेसिबिलिटी एक्सेस की अनुमति दें।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อนุญาตการเข้าถึงการช่วยการเข้าถึงเพื่อจัดการท่าทางและตรวจสอบแอปพลิเคชันที่ใช้งานอยู่"
          }
        }
      }
    },
