    "settings.permissions.fullDiskAccess.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسمح بالوصول الكامل إلى القرص لعرض إشعارات البريد والرسائل، والأسماء الحقيقية والأيقونات المخصصة لأوضاع التركيز."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешете пълен достъп до диска за показване на известия от Mail и Messages, както и на истинските имена и персонализираните икони на режимите Фокус."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mail ও Messages বিজ্ঞপ্তি এবং ফোকাস মোডের আসল নাম ও কাস্টম আইকন দেখাতে সম্পূর্ণ ডিস্ক অ্যাক্সেসের অনুমতি দিন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permet l’accés complet al disc per mostrar les notificacions del Mail i Missatges, i els noms reals i les icones personalitzades dels modes de Concentració."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povolte plný přístup k disku pro zobrazování oznámení z Mailu a Zpráv a skutečných názvů a vlastních ikon režimů Soustředění."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giv fuld diskadgang for at vise notifikationer fra Mail og Beskeder samt rigtige navne og tilpassede symboler for Fokus-funktioner."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube Festplattenvollzugriff, um Mitteilungen von Mail und Nachrichten sowie tatsächliche Namen und eigene Symbole von Fokusmodi anzuzeigen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιτρέψτε πλήρη πρόσβαση στον δίσκο για εμφάνιση γνωστοποιήσεων του Mail και των Μηνυμάτων, καθώς και πραγματικών ονομάτων και προσαρμοσμένων εικονιδίων λειτουργιών Συγκέντρωσης."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow Full Disk Access to display Mail and Messages notifications, and real names and custom icons of Focus modes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite el acceso total al disco para mostrar notificaciones de Mail y Mensajes, así como los nombres reales y los iconos personalizados de los modos de concentración."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای نمایش اعلان‌های Mail و Messages و نام‌ها و نمادهای سفارشی واقعی حالت‌های تمرکز، اجازهٔ دسترسی کامل به دیسک را بدهید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salli täysi levyn käyttöoikeus Mail- ja Viestit-ilmoitusten sekä Keskity-tilojen todellisten nimien ja omien kuvakkeiden näyttämiseen."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pahintulutan ang Buong Access sa Disk upang ipakita ang mga notification ng Mail at Messages, at ang mga totoong pangalan at custom na icon ng mga Focus mode."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisez l’accès complet au disque pour afficher les notifications de Mail et Messages, ainsi que les noms réels et les icônes personnalisées des modes Concentration."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אפשר גישה מלאה לדיסק כדי להציג עדכונים של Mail ו-Messages, וכן שמות אמיתיים וסמלים מותאמים אישית של מצבי ריכוז."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mail और Messages सूचनाएँ तथा फ़ोकस मोड के वास्तविक नाम और कस्टम आइकन दिखाने के लिए पूर्ण डिस्क ऐक्सेस की अनुमति दें।"
          }
        },
        "hr" : {
