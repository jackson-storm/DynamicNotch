        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies of de VPN-activiteit compact blijft of tunneldetails toont."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz, czy aktywność VPN ma pozostać kompaktowa, czy wyświetlać szczegóły tunelu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
