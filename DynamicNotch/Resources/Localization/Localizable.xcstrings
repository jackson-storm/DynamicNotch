    "settings.system.menuBarIcon.desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show a menu bar shortcut for quick access to Settings and Quit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar un acceso rápido en la barra de menús para Ajustes y Salir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показать ярлык в строке меню для быстрого доступа к Настройкам и выходу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在菜单栏中显示快捷方式以快速访问设置和退出。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarlar ve Çık'a hızlı erişim için menü çubuğu kısayolunu göster."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
