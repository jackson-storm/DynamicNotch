    "settings.bluetooth.batteryColoredStroke.desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tint Bluetooth battery styles using the current battery level color."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tintear los estilos de batería Bluetooth con el color del nivel actual."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Окрашивать стили батареи Bluetooth цветом текущего уровня заряда."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用当前电池电量颜色为蓝牙电池样式着色。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth pil stillerini geçerli pil düzeyi rengiyle renklendir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Notch-Kontur in der Farbe des Gerätestatus einfärben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Colorer le contour de l'encoche selon le niveau de batterie de l'accessoire."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Colorir o contorno do notch de acordo com o nível da bateria do acessório."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセサリのバッテリー残量に応じてノッチの枠線を色付けします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "액세서리의 배터리 잔량에 따라 노치 테두리에 색상을 적용합니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Colora il bordo del notch in base al livello della batteria dell'accessorio."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Koloruj obrys notcha zgodnie z poziomem baterii akcesorium."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tô màu viền notch theo mức pin của phụ kiện."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Warnai batas notch sesuai dengan level baterai aksesori."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kleur de rand van de notch volgens het batterijniveau van het accessoire."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "根據配件的電量為「瀏海」邊框著色。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Фарбувати контур notch відповідно до рівня заряду аксесуара."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Färglägg flärpens ram efter tillbehörets batterinivå."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zbarvit ohraničení výřezu podle úrovně baterie příslušenství."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تلوين أنماط بطارية البلوتوث باستخدام لون مستوى البطارية الحالي."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वर्तमान बैटरी स्तर के रंग का उपयोग करके ब्लूटूथ बैटरी शैलियों को टिंट करें।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ย้อมสีขอบแบตเตอรี่บลูทูธตามสีระดับแบตเตอรี่ปัจจุบัน"
          }
        }
      }
    },
