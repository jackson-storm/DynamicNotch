    "settings.nowPlaying.closeDelay.desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose how long the paused player stays visible before the notch closes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige cuánto tiempo permanece visible el reproductor en pausa antes de cerrarse."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите, как долго приостановленный плеер остаётся видимым перед закрытием."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择暂停的播放器在刘海关闭前保持可见的时长。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çentik kapanmadan önce duraklatılmış oynatıcının ne kadar süre görünür kalacağını seçin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle, wie lange der pausierte Player sichtbar bleibt, bevor die Notch schließt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez combien de temps le lecteur en pause reste visible avant la fermeture de l'encoche."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha quanto tempo o leitor em pausa permanece visível antes de fechar o notch."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノッチが閉じる前に一時停止したプレーヤーを表示し続ける時間を選択します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노치가 닫히기 전까지 일시정지된 플레이어가 표시되는 지속 시간을 선택하세요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli per quanto tempo il lettore in pausa rimane visibile prima che il notch si chiuda."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz, jak długo wstrzymany odtwarzacz pozostaje widoczny przed zamknięciem notcha."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn thời gian trình phát bị tạm dừng hiển thị trước khi notch đóng."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih berapa lama pemutar yang dijeda tetap terlihat sebelum notch ditutup."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies hoe lang de gepauzeerde speler zichtbaar blijft voordat de notch sluit."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇暫停的播放器在「瀏海」關閉前保持可見的時間。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть, як довго призупинений плеєр залишатиметься видимим до закриття notch."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj hur länge den pausade spelaren ska vara synlig innan flärpen stängs."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvolte, jak dlouho zůstane pozastavený přehrávač viditelný před zavřením výřezu."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر مدة بقاء المشغّل المتوقف مرئياً قبل إغلاق الشق."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चुनें कि नॉच बंद होने से पहले रुका हुआ प्लेयर कितने समय तक दिखाई देगा।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกระยะเวลาที่เครื่องเล่นที่หยุดไว้จะแสดงอยู่ก่อนรอยบากจะปิด"
          }
        }
      }
    },
