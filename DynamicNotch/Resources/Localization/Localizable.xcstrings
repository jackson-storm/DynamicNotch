    "settings.battery.lowPowerDuration.desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose how long the low battery notification stays visible."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige cuánto tiempo permanece visible la notificación de batería baja."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите, как долго отображается уведомление о низком заряде."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择低电量通知的显示时长。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Düşük pil bildiriminin ne kadar süre görünür kalacağını seçin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle, wie lange die Warnung für niedrigen Akkustand sichtbar bleibt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez combien de temps l'alerte de batterie faible reste visible."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha quanto tempo o alerta de bateria fraca permanece visível."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "低電力アラートを表示し続ける時間を選択します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저전력 경고가 표시되는 지속 시간을 선택하세요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli per quanto tempo l'avviso di risparmio energetico rimane visibile."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz, jak długo alert niskiego poziomu energii pozostaje widoczny."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn thời gian cảnh báo pin yếu hiển thị."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih berapa lama peringatan daya rendah tetap terlihat."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies hoe lang de waarschuwing voor een laag stroomverbruik zichtbaar blijft."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇低耗電警示保持可見的時間。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть, як довго попередження про низький заряд залишатиметься видимим."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj hur länge varningen för låg ström ska vara synlig."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvolte, jak dlouho zůstane upozornění na nízkou energii viditelné."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر مدة بقاء إشعار البطارية المنخفضة مرئياً."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चुनें कि कम बैटरी सूचना कितने समय तक दिखाई देगी।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกระยะเวลาที่การแจ้งเตือนแบตเตอรี่ต่ำจะแสดงอยู่"
          }
        }
      }
    },
