    "Keep the hotspot live activity visible until you turn it off.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hotspot-Live-Aktivität sichtbar lassen, bis sie ausgeschaltet wird."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garder l'activité en direct du partage de connexion visible jusqu'à ce que vous la désactiviez."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Manter a atividade em tempo real de partilha de internet visível até que seja desativada."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフにするまでインターネット共有のライブアクティビティを表示し続けます。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the hotspot live activity visible until you turn it off."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранять активность точки доступа видимой, пока вы не отключите ее."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantener visible la actividad en vivo del punto de acceso hasta que la apague."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持热点实时活动可见，直到您将其关闭。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapatana kadar kişisel erişim noktası canlı etkinliğini görünür tutun."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "직접 끌 때까지 핫스팟 실시간 활동을 계속 표시합니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantieni visibile l'attività in tempo reale dell'hotspot fino a quando non la disattivi."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Utrzymuj aktywność na żywo hotspotu widoczną, dopóki jej nie wyłączysz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ hoạt động trực tiếp điểm phát sóng hiển thị cho đến khi bạn tắt nó."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Biarkan aktivitas langsung hotspot tetap terlihat sampai Anda mematikannya."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd de live hotspotactiviteit zichtbaar totdat je deze uitschakelt."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保持熱點即時活動可見，直到您將其關閉。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Залишати активність точки доступу видимою, доки ви її не вимкнете."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Håll internetdelningens liveaktivitet synlig tills du stänger av den."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponechat živou aktivitu hotspotu viditelnou, dokud ji nevypnete."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إبقاء نشاط نقطة الاتصال مرئياً حتى إيقافه."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब तक आप इसे बंद नहीं करते तब तक हॉटस्पॉट लाइव गतिविधि दृश्यमान रखें।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงกิจกรรมสดของฮอตสปอตไว้จนกว่าคุณจะปิด"
          }
        }
      }
    },
