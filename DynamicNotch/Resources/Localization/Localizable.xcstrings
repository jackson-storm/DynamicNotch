    "settings.notch.gestures.swipeDismissAndRestore.subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "السماح بإيماءات السحب العمودية فوق الشق لإخفاء النشاط الحالي أو استعادة النشاط المُرفَض مؤخراً."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешете вертикални жестове за плъзгане върху ноча за скриване или възстановяване."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অ্যাক্টিভিটি লুকাতে বা পুনরুদ্ধার করতে নচের উপর উল্লম্ব সোয়াইপ অঙ্গভঙ্গি সক্ষম করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permet gestos de lliscament vertical sobre el notch per amagar o restaurar l'activitat."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povolit svislá přejetí po výřezu pro skrytí aktivní aktivity nebo obnovení naposledy zavřené."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillad lodrette strygebevægelser over notchen for at skjule eller gendanne aktivitet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vertikale Wischgesten über der Notch erlauben, um die aktive Aktivität auszublenden oder die zuletzt geschlossene wiederherzustellen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιτρέψτε κατακόρυφες χειρονομίες σάρωσης πάνω από το notch για απόκρυψη ή επαναφορά δραστηριότητας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow vertical swipe gestures over the notch to hide the active activity or restore the recently dismissed one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite gestos de deslizamiento vertical sobre la muesca para ocultar la actividad activa o restaurar la recientemente cerrada."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فعال‌سازی ژست‌های کشیدن عمودی روی ناچ برای پنهان یا بازیابی فعالیت."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salli pystysuuntaiset pyyhkäisyeleet notchin päällä toiminnan piilottamiseksi tai palauttamiseksi."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paganahin ang patayong galaw ng pag-swipe sa ibabaw ng notch upang itago o ibalik ang aktibidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autoriser les balayages verticaux sur l'encoche pour masquer l'activité active ou rétablir la dernière fermée."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אפשר מחוות החלקה אנכיות מעל המגרעת כדי להסתיר או לשחזר פעילות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सक्रिय गतिविधि को छिपाने या हाल ही में खारिज की गई गतिविधि को पुनर्स्थापित करने के लिए नॉच पर लंबवत स्वाइप जेस्चर की अनुमति दें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omogućite okomite geste povlačenja preko ureza za skrivanje ili vraćanje aktivnosti."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Függőleges legyintések engedélyezése a notch felett a tevékenység elrejtéséhez vagy visszaállításához."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izinkan gesekan vertikal pada notch untuk menyembunyikan aktivitas aktif atau memulihkan yang terakhir ditutup."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consenti scorrimenti verticali sul notch per nascondere l'attività attiva o ripristinare l'ultima chiusa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ノッチ上を縦にスワイプしてアクティブなアクティビティを非表示にしたり、直前に閉じたアクティビティを復元したりできます。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Әрекетті жасыру немесе қайтару үшін ойық үстінде тік сырғытуды қосыңыз."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "노치 위에서 수직으로 쓸어올려 활성 활동을 숨기거나 쓸어내려 마지막으로 닫은 활동을 복원합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benarkan gerak isyarat leret menegak di atas notch untuk menyembunyikan atau memulihkan aktiviti."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillat vertikale sveipebevegelser over notchen for å skjule eller gjenopprette aktivitet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sta verticale veegbewegingen op de notch toe om de actieve activiteit te verbergen of de laatst gesloten te herstellen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zezwalaj na pionowe przeciągnięcia po notchu, aby ukryć aktywność lub przywrócić ostatnio zamkniętą."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permitir deslizes verticais no notch para ocultar a atividade ativa ou restaurar a última fechada."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permiteți gesturi de glisare verticală peste notch pentru a ascunde activitatea activă sau a restaura activitatea respinsă recent."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешить вертикальные свайпы по вырезу для скрытия активной панели или восстановления недавно закрытой."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povoliť vertikálne gestá potiahnutia cez výrez na skrytie alebo obnovenie aktivity."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Омогућите вертикалне гестове превлачења преко ноча за сакривање или враћање активности."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillåt vertikala svepningar på flärpen för att dölja aktiv aktivitet eller återställa den senast stängda."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อนุญาตท่าทางปัดแนวตั้งเหนือรอยบากเพื่อซ่อนกิจกรรมหรือกู้คืนกิจกรรมที่เพิ่งปิดไป"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çentik üzerindeki dikey kaydırma hareketlerinin etkin etkinliği gizlemesine veya son kapatılanı geri getirmesine izin ver."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дозволити вертикальні змахування по вирізу notch, щоб сховати активність або відновити останню закриту."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cho phép vuốt dọc trên notch để ẩn hoạt động hiện tại hoặc khôi phục hoạt động đã đóng gần nhất."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许在刘海上进行垂直滑动以隐藏活动内容或恢复最近关闭的内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允許在「瀏海」上垂直滑動以關閉使用中活動或復原上次關閉的活動。"
          }
        }
      }
    },
