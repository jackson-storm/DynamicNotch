    "settings.notch.gestures.expandGesture.desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose whether expanded content opens on click, after holding the notch, or after hovering over it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige si el contenido expandido se abre al hacer clic, al mantener pulsado o al pasar el cursor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите, открывается ли расширенный вид по клику, удержанию или наведению на вырез."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择展开内容是通过点击、长按刘海还是悬停打开。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Genişletilmiş içeriğin tıklamayla mı, çentik basılı tutulduğunda mı yoksa üzerine gelindiğinde mi açılacağını seçin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle, ob geöffnete Inhalte per Klick, Halten oder Überfahren öffnen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisir si le contenu agrandi s'ouvre d'un clic, d'un appui prolongé ou au survol."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolher se o conteúdo expandido abre com um clique, premindo sem soltar ou ao passar o cursor."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "展開コンテンツをクリック、長押し、またはホバーで開くかを選択します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확장 콘텐츠를 클릭, 길게 누르기 또는 마우스 올리기로 열지 선택하세요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli se il contenuto espanso si apre con un clic, tenendo premuto o al passaggio del mouse."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz, czy rozwinięta zawartość otwiera się po kliknięciu, przytrzymaniu czy najechaniu kursorem."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn xem nội dung mở rộng mở bằng nhấp, nhấn và giữ hay di chuột."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih apakah konten yang diperluas terbuka dengan klik, tekan dan tahan, atau arahkan kursor."
          }
        }
      }
    },
