    "settings.general.display.unavailable.autoSwitchDisabled": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected display is unavailable right now. Dynamic Notch will stay hidden until that display returns."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La pantalla seleccionada no está disponible ahora mismo. Dynamic Notch permanecerá oculto hasta que vuelva."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбранный дисплей сейчас недоступен. Dynamic Notch останется скрытым, пока этот дисплей не вернётся."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选显示屏当前不可用。Dynamic Notch 会保持隐藏，直到该显示屏重新连接。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçilen ekran şu anda kullanılamıyor. O ekran geri dönene kadar Dynamic Notch gizli kalacak."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ausgewählte Display ist derzeit nicht verfügbar. Dynamic Notch bleibt ausgeblendet, bis das Display wieder verbunden wird."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'écran sélectionné est actuellement indisponible. Dynamic Notch restera masqué jusqu'au retour de cet écran."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O ecrã selecionado está indisponível. O Dynamic Notch permanecerá oculto até que este ecrã regresse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したディスプレイは現在利用できません。再接続されるまでDynamic Notchは非表示になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 디스플레이를 현재 사용할 수 없습니다. 해당 디스플레이가 다시 연결될 때까지 Dynamic Notch가 숨겨집니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo schermo selezionato non è al momento disponibile. Dynamic Notch rimarrà nascosto fino al ritorno di questo schermo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybrany ekran jest obecnie niedostępny. Dynamic Notch pozostanie ukryty do czasu ponownego podłączenia tego ekranu."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Màn hình đã chọn hiện không khả dụng. Dynamic Notch sẽ vẫn bị ẩn cho đến khi màn hình này hoạt động trở lại."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Layar yang dipilih saat ini tidak tersedia. Dynamic Notch akan tetap tersembunyi hingga layar ini kembali."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het geselecteerde beeldscherm is momenteel niet beschikbaar. Dynamic Notch blijft verborgen totdat dit scherm terugkeert."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所選顯示器目前無法使用。在該顯示器重新連接之前，Dynamic Notch 將保持隱藏。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вибраний дисплей зараз недоступний. Dynamic Notch залишатиметься прихованим, доки цей екран не з'явиться знову."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den valda skärmen är inte tillgänglig för närvarande. Dynamic Notch förblir dold tills denna skärm återansluts."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vybraný displej není momentálně k dispozici. Dynamic Notch zůstane skrytý, dokud se tento monitor znovu nepřipojí."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الشاشة المحددة غير متاحة حالياً. سيبقى Dynamic Notch مخفياً حتى عودة تلك الشاشة."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चयनित डिस्प्ले अभी अनुपलब्ध है। Dynamic Notch तब तक छिपा रहेगा जब तक वह डिस्प्ले वापस नहीं आ जाता।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จอแสดงผลที่เลือกไม่พร้อมใช้งานในขณะนี้ Dynamic Notch จะยังคงซ่อนอยู่จนกว่าจอนั้นจะกลับมา"
          }
        }
      }
    },
    "settings.general.display.unavailable.autoSwitchEnabled": {
