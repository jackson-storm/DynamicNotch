        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukryj przycisk urządzenia wyjściowego w rozwiniętych elementach sterujących."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ẩn nút thiết bị đầu ra khỏi các điều khiển mở rộng."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sembunyikan tombol perangkat output dari kontrol yang diperluas."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verberg de knop voor het uitvoerapparaat in de uitgebreide bedieningselementen."
          }
