    "settings.wifi.duration.desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose how long the Wi-Fi reconnect notification stays visible."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige cuánto tiempo permanece visible la notificación de reconexión Wi-Fi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите, как долго отображается уведомление о переподключении Wi-Fi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择 Wi-Fi 重连通知的显示时长。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi yeniden bağlanma bildiriminin ne kadar süre görünür kalacağını seçin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle, wie lange die WLAN-Wiederverbindungsbenachrichtigung sichtbar bleibt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
