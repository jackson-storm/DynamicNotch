    "settings.battery.charging.desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show a temporary activity when your Mac starts charging."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar una actividad temporal cuando el Mac comience a cargar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показать временную активность при начале зарядки Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 开始充电时显示临时活动。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac'iniz şarj olmaya başladığında geçici bir etkinlik göster."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ladebenachrichtigung anzeigen, wenn das Netzteil angeschlossen wird."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher une notification lorsque le chargeur est branché."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar uma notificação quando o carregador for ligado."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "充電器が接続されたときに通知を表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "충전기가 연결되었을 때 알림을 표시합니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra una notifica quando il caricabatterie è collegato."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokaż powiadomienie po podłączeniu ładowarki."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiển thị thông báo khi bộ sạc được kết nối."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tampilkan notifikasi saat pengisi daya terhubung."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toon een melding wanneer de oplader is aangesloten."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連接充電器時顯示通知。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показувати сповіщення при підключенні зарядного пристрою."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visa en avisering när laddaren ansluts."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazit oznámení při připojení nabíječky."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إظهار نشاط مؤقت عند بدء شحن Mac."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब आपका Mac चार्ज होना शुरू हो तो एक अस्थायी गतिविधि दिखाएं।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงกิจกรรมชั่วคราวเมื่อ Mac ของคุณเริ่มชาร์จ"
          }
        }
      }
    },
