          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Точная настройка высоты выреза или Dynamic Island."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jemne doladiť výšku výrezu alebo Dynamic Island."
          }
        },
        "sr" : {
