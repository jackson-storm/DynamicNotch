    "settings.lockScreen.customSound.loadError": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected file could not be loaded. Choose an MP3, WAV, AIFF, or M4A audio file."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo cargar el archivo seleccionado. Elige un archivo MP3, WAV, AIFF o M4A."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось загрузить выбранный файл. Выберите аудиофайл MP3, WAV, AIFF или M4A."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法加载所选文件。请选择 MP3、WAV、AIFF 或 M4A 音频文件。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçilen dosya yüklenemedi. MP3, WAV, AIFF veya M4A ses dosyası seçin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die ausgewählte Datei konnte nicht geladen werden. Wähle eine MP3-, WAV-, AIFF- oder M4A-Audiodatei."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de charger le fichier sélectionné. Choisissez un fichier audio MP3, WAV, AIFF ou M4A."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível carregar o ficheiro selecionado. Escolha um ficheiro áudio MP3, WAV, AIFF ou M4A."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したファイルを読み込めませんでした。MP3、WAV、AIFF、またはM4Aオーディオファイルを選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 파일을 불러올 수 없습니다. MP3, WAV, AIFF 또는 M4A 오디오 파일을 선택하세요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile caricare il file selezionato. Scegli un file audio MP3, WAV, AIFF o M4A."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się załadować wybranego pliku. Wybierz plik audio MP3, WAV, AIFF lub M4A."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể tải tệp đã chọn. Chọn tệp âm thanh MP3, WAV, AIFF hoặc M4A."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat memuat file yang dipilih. Pilih file audio MP3, WAV, AIFF, atau M4A."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan het geselecteerde bestand niet laden. Kies een MP3-, WAV-, AIFF- of M4A-audiobestand."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法載入所選檔案。請選擇 MP3、WAV、AIFF 或 M4A 音訊檔案。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося завантажити вибраний файл. Виберіть аудіофайл MP3, WAV, AIFF або M4A."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunde inte läsa in den valda filen. Välj en MP3-, WAV-, AIFF- eller M4A-ljudfil."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vybraný soubor se nepodařilo načíst. Zvolte zvukový soubor MP3, WAV, AIFF nebo M4A."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected file could not be loaded. Choose an MP3, WAV, AIFF, or M4A audio file."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected file could not be loaded. Choose an MP3, WAV, AIFF, or M4A audio file."
          }
        }
      }
    },
