    "settings.nowPlaying.artwork3D.desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحريك الغلاف بتأثير ثلاثي الأبعاد عند تغيير غلاف المسار."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Анимиране на обложката с 3D ефект при смяна на песента."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "গান পরিবর্তনের সময় 3D ফ্লিপ প্রভাব সহ আর্টওয়ার্ক অ্যানিমেট করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anima la caràtula amb un efecte de gir 3D quan canvia la cançó."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Animovat přebal alba s 3D efektem při změně skladby."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Animer coverbillede med 3D-vendeeffekt, når sporet skifter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3D-Drehanimation für das Albumcover bei Titelwechsel aktivieren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κίνηση εξωφύλλου με εφέ 3D περιστροφής κατά την αλλαγή κομματιού."
          }
        },
        "en" : {
          "stringUnit" : {
