        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ปิดการแจ้งเตือนภาพหน้าจอโดยอัตโนมัติหลังจากหน่วงเวลา"
          }
        },
        "tr" : {
          "stringUnit" : {
