    "settings.fileConverter.activity.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show the File Converter live activity after a file is dropped for conversion."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra la actividad en vivo del conversor de archivos después de arrastrar un archivo para convertir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывать Live Activity конвертера файлов после выбора или перетаскивания файла."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖放文件转换后显示文件转换器 Live Activity。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dönüştürmek üzere bir dosya bırakıldığında Dosya Dönüştürücü canlı etkinliğini göster."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateikonverter-Live-Aktivität anzeigen, nachdem eine Datei zur Konvertierung abgelegt wurde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher l'activité en direct du convertisseur de fichiers après avoir déposé un fichier à convertir."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar a atividade em tempo real do conversor de ficheiros após largar um ficheiro para converter."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変換するファイルをドロップした後にファイル変換ライブアクティビティを表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변환할 파일을 놓은 후 파일 변환기 실시간 활동을 표시합니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra l'attività in tempo reale del convertitore file dopo aver rilasciato un file da convertire."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokaż aktywność na żywo konwertera plików po upuszczeniu pliku do konwersji."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiển thị hoạt động trực tiếp của trình chuyển đổi tệp sau khi thả tệp để chuyển đổi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tampilkan aktivitas langsung pengonversi file setelah menjatuhkan file untuk dikonversi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toon de live activiteit van de bestandsomzetter nadat je een bestand hebt neergezet om te converteren."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在放置要轉換的檔案後顯示檔案轉換器即時活動。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показувати активність наживо після перетягування файлу для конвертації."
          }
        },
        "sv": {
          "stringUnit": {
