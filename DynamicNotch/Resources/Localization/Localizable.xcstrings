        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uyarının ayrıntılı kartı mı yoksa şarj benzeri kompakt bir düzeni mi kullanacağını seçin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle den Stil der Warnung bei niedrigem Akkustand."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez le style de l'alerte de batterie faible."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha o estilo visual do alerta de bateria fraca."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "低電力アラートのスタイルを選択します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "배터리 부족 경고의 스타일을 선택하세요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli lo stile dell'avviso di batteria quasi scarica."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz styl alertu niskiego poziomu baterii."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn kiểu cảnh báo pin yếu."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih gaya peringatan baterai lemah."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies de stijl van de waarschuwing voor een bijna lege batterij."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇低電量警示的樣式。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть стиль попередження про низький заряд."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj stil för varning om låg batterinivå."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte styl upozornění na slabou baterii."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر ما إذا كان التنبيه يستخدم البطاقة المفصلة الحالية أو نمط شحن مضغوط."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चुनें कि चेतावनी विस्तृत कार्ड का उपयोग करे या कॉम्पैक्ट शैली का।"
