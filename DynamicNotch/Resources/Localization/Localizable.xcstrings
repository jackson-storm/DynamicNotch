    "settings.permissions.mediaControls.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "السماح بالوصول لأحداث التحكم بالوسائط لتعمل أزرار التشغيل والإيقاف والمسار من \"يُعرض الآن\"."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешете достъп до събития за медиен контрол за работа на бутоните за пускане и пауза."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "প্লেব্যাক এবং ট্র্যাক বোতামগুলির কার্যকারিতার জন্য মিডিয়া নিয়ন্ত্রণ ইভেন্টগুলিতে অ্যাক্সেসের অনুমতি দিন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permet l'accés als controls multimèdia perquè funcionin els botons de reproducció i pista."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povolte ovládání médií, aby v 'Právě hraje' fungovala tlačítka přehrávání, pozastavení a přeskakování skladeb."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillad adgang til mediebetjeningshændelser, så afspil-, pause- og sporknapper fungerer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mediensteuerungs-Zugriff erlauben, damit Wiedergabe-, Pause- und Titeltasten in Aktuelle Wiedergabe funktionieren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιτρέψτε πρόσβαση σε συμβάντα ελέγχου πολυμέσων για τη λειτουργία των κουμπιών από το Τώρα αναπαράγεται."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow media control event access so play, pause, and track buttons work from Now Playing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite el acceso a eventos de control de medios para que funcionen los botones de reproducción, pausa y pistas."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اجازه دسترسی به رویدادهای کنترل رسانه برای عملکرد دکمه‌های پخش و قطعه."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salli medianhallintatapahtumien käyttöoikeus toisto- ja kappalepainikkeiden toimimiseksi."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pahintulutan ang access sa mga kaganapan ng kontrol sa media para sa paggana ng mga button ng playback at kanta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autoriser le contrôle multimédia afin que les boutons de lecture, pause et changement de piste fonctionnent dans À l'écoute."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אפשר גישה לאירועי בקרת מדיה כדי שלחצני הפעלה, השהיה ורצועה יפעלו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मीडिया नियंत्रण ईवेंट एक्सेस की अनुमति दें ताकि 'अब चल रहा है' से प्ले, पॉज़ और ट्रैक बटन काम करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dozvolite pristup događajima kontrole medija za funkcioniranje gumba za reprodukciju i pjesme."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Médiavezérlő események engedélyezése a lejátszás, szüneteltetés és számléptetés gombok működéséhez."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izinkan kontrol media agar tombol putar, jeda, dan lewati trek berfungsi di Sedang Diputar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consenti il controllo multimediale in modo che i pulsanti di riproduzione, pausa e cambio traccia funzionino in In riproduzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再生、一時停止、トラック移動ボタンが機能するようにメディア制御を許可します。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ойнату және трек батырмалары жұмыс істеуі үшін медианы басқару оқиғаларына рұқсат беріңіз."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지금 재생 중의 재생, 일시정지 및 트랙 넘기기 버튼이 작동할 수 있도록 미디어 제어 권한을 허용합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benarkan akses peristiwa kawalan media supaya butang main, jeda dan trek berfungsi."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillat tilgang til mediekontrollhendelser slik at avspill-, pause- og sporknapper fungerer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verleen mediabediening zodat de knoppen voor afspelen, pauzeren en overslaan werken in Huidige."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zezwól na sterowanie multimediami, aby przyciski odtwarzania, pauzy i zmiany utworu działały w Teraz odtwarzane."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permitir controlo multimédia para que os botões de reproduzir, pausar e mudar de faixa funcionem em A reproduzir."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permiteți accesul la evenimentele de control media pentru funcționarea butoanelor din În redare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешите управление медиа для работы кнопок воспроизведения, паузы и треков."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povoľte prístup k udalostiam ovládania médií pre funkčnosť tlačidiel prehrávania a skladieb."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дозволите приступ догађајима контроле медија за функционисање дугмади за репродукцију и песме."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillåt mediekontroll så att knapparna för uppspelning, paus och spårbyte fungerar i 'Spelas nu'."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อนุญาตการเข้าถึงการควบคุมสื่อเพื่อให้ปุ่มเล่น หยุด และข้ามแทร็กทำงานได้จากกำลังเล่น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oynat, duraklat ve parça düğmelerinin Çalınıyor üzerinden çalışması için ortam denetimi olaylarına erişime izin verin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Надайте доступ до керування медіа, щоб у «Зараз грає» працювали кнопки відтворення, паузи та перемикання треків."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cho phép điều khiển phương tiện để các nút phát, tạm dừng và chuyển bài hoạt động trong Đang phát."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许媒体控制事件权限，以便在正在播放中使用播放、暂停和曲目按钮。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允許媒體控制權限，以便在「播放中」使用播放、暫停和跳過曲目按鈕。"
          }
        }
      }
    },
