          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Live-Aktivität in der Notch bei Dateiübertragungen via AirDrop anzeigen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher une activité en direct dans l'encoche lors du transfert de fichiers via AirDrop."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar uma atividade em tempo real no notch ao transferir ficheiros através do AirDrop."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AirDrop経由でファイルを転送する際にノッチにライブアクティビティを表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AirDrop을 통해 파일을 전송할 때 노치에 실시간 활동을 표시합니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra un'attività in tempo reale nel notch durante il trasferimento di file tramite AirDrop."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokaż aktywność na żywo w notchu podczas przesyłania plików przez AirDrop."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
