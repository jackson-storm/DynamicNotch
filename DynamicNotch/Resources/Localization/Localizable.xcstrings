    "settings.general.appearance.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Theme and accent color preferences."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Preferencias de tema y color de acento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Параметры темы и акцентного цвета."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主题和强调色偏好。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tema ve vurgu rengi tercihleri."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle zwischen hellem, dunklem oder automatischem Systemdesign."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez entre les thèmes clair, sombre ou automatique du système."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha entre os modos claro, escuro ou automático do sistema."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライト、ダーク、またはシステムのテーマを選択します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "라이트, 다크 또는 시스템 자동 모드 중에서 선택하세요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli tra tema chiaro, scuro o automatico di sistema."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz między jasnym, ciemnym lub automatycznym motywem systemowym."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn giữa chủ đề sáng, tối hoặc tự động của hệ thống."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih antara tema terang, gelap, atau otomatis sistem."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies tussen een licht, donker of automatisch systeemthema."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在淺色、深色或系統自動主題之間選擇。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть світлу, темну або системну автоматичну тему."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
