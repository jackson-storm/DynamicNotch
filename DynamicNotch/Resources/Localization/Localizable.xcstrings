    "settings.notch.width.desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ضبط عرض الشق أو الجزيرة الديناميكية بدقة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прецизна настройка на ширината на ноча или Dynamic Island."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "নচ বা Dynamic Island-এর প্রস্থ সূক্ষ্মভাবে সমন্বয় করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajusta amb precisió l'amplada del notch o Dynamic Island."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jemně dolaďte šířku výřezu nebo Dynamic Island."
