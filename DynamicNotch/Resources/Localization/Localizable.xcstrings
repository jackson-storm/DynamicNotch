    "settings.notifications.appleMail.duration.desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحديد مدة بقاء إشعار البريد الجديد مرئياً في النوتش."
          }
        },
        "bg" : {
          "stringUnit" : {
