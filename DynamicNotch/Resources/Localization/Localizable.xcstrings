    "If the original is moved to the tray and deleted from there, you can restore it in the system trash." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذا تم نقل الأصل إلى الدرج وحذفه من هناك، يمكنك استعادته من سلة المهملات."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ако оригиналът бъде преместен в таблата и изтрит оттам, можете да го възстановите от системното кошче."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "যদি আসলটি ট্রেতে সরানো হয় এবং সেখান থেকে মুছে ফেলা হয়, আপনি এটি সিস্টেম ট্র্যাশ থেকে পুনরুদ্ধার করতে পারেন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si l'original es mou a la safata i s'elimina des d'allà, podeu restaurar-lo a la paperera del sistema."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokud je originál přesunut do přihrádky a odtud smazán, můžete jej obnovit z koše."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis originalen flyttes til bakken og slettes derfra, kan du gendanne den fra systempapirkurven."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn das Original in die Dateiablage verschoben und dort gelöscht wird, kannst du es im Papierkorb wiederherstellen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εάν το αρχικό μετακινηθεί στον δίσκο και διαγραφεί από εκεί, μπορείτε να το επαναφέρετε από τον κάδο απορριμμάτων."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If the original is moved to the tray and deleted from there, you can restore it in the system trash."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si el original se mueve a la bandeja y se elimina desde allí, puede restaurarlo en la papelera del sistema."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اگر فایل اصلی به سینی منتقل و از آنجا حذف شود، می‌توانید آن را از سطل زباله سیستم بازیابی کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jos alkuperäinen siirretään kaukaloon ja poistetaan sieltä, voit palauttaa sen roskakorista."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kung ang orihinal ay inilipat sa tray at binura mula roon, maaari mo itong ibalik sa trash ng system."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si l'original est déplacé dans le bac et supprimé à partir de là, vous pouvez le restaurer dans la corbeille du système."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אם המקור מועבר למגש ונמחק משם, ניתן לשחזר אותו מפח האשפה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यदि मूल को ट्रे में ले जाया जाता है और वहां से हटा दिया जाता है, तो आप इसे सिस्टम ट्रैश में पुनर्स्थापित कर सकते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ako se original premjesti u ladicu i odande izbriše, možete ga vratiti iz smeća sustava."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha az eredetit a tálcára helyezi és onnan törli, a rendszer kukájából visszaállíthatja."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika file asli dipindahkan ke baki dan dihapus dari sana, Anda dapat memulihkannya di tempat sampah sistem."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se l'originale viene spostato nel vassoio ed eliminato da lì, puoi ripristinarlo dal cestino di sistema."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オリジナルがトレイに移動されてそこから削除された場合、システムのゴミ箱から復元できます。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Егер түпнұсқа науаға жылжытылып, сол жерден жойылса, оны жүйелік себеттен қалпына келтіре аласыз."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "원본을 트레이로 이동한 후 삭제한 경우 시스템 휴지통에서 복원할 수 있습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika yang asal dialihkan ke dulang dan dipadamkan dari sana, anda boleh memulihkannya dalam tong sampah sistem."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis originalen flyttes til skuffen og slettes derfra, kan du gjenopprette den fra papirkurven."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als het origineel naar de lade is verplaatst en daaruit is verwijderd, kun je het herstellen vanuit de prullenmand."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli oryginał zostanie przeniesiony do tacki i stamtąd usunięty, możesz go przywrócić z kosza systemowego."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se o ficheiro original for movido para a bandeja e apagado de lá, pode restaurá-lo no lixo do sistema."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dacă originalul este mutat în tavă și șters de acolo, îl puteți restaura din coșul de gunoi al sistemului."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если оригинал перемещен в лоток и удален оттуда, вы можете восстановить его из Корзины."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ak sa originál presunie do zásobníka a odtiaľ vymaže, môžete ho obnoviť z koša."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ако се оригинал премести у фиоку и одатле обрише, можете га вратити из смећа."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om originalet flyttas till brickan och raderas därifrån kan du återställa det från papperskorgen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หากไฟล์ต้นฉบับถูกย้ายไปที่ถาดและลบจากที่นั่น คุณสามารถกู้คืนได้จากถังขยะของระบบ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orijinal dosya tepsiye taşınır ve oradan silinirse, sistem çöp kutusundan geri yükleyebilirsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо оригінал переміщено до лотка і видалено звідти, ви можете відновити його зі Смітника."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nếu bản gốc được di chuyển vào khay và bị xóa khỏi đó, bạn có thể khôi phục nó trong thùng rác hệ thống."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果原文件移动到托盘并从那里删除，您可以在系统废纸篓中恢复它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果原始檔案已移動至托盤並從中刪除，您可以從系統垃圾桶中復原它。"
          }
        }
      }
    },
