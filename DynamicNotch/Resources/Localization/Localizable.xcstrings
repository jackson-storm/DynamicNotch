    "settings.wifi.temporaryActivity.desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show a short notification when Wi-Fi reconnects."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar una notificación breve al reconectar Wi-Fi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показать короткое уведомление при повторном подключении Wi-Fi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi 重新连接时显示短暂通知。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi yeniden bağlandığında kısa bir bildirim göster."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurze Benachrichtigung anzeigen, wenn das WLAN wieder verbunden wird."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher une courte notification lors de la reconnexion au Wi-Fi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar uma notificação curta ao voltar a ligar ao Wi-Fi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fiに再接続したときに短い通知を表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi에 다시 연결될 때 짧은 알림을 표시합니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra una breve notifica quando ti riconnetti al Wi-Fi."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokaż krótkie powiadomienie po ponownym połączeniu z Wi-Fi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiển thị thông báo ngắn khi kết nối lại với Wi-Fi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tampilkan notifikasi singkat saat menyambung kembali ke Wi-Fi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toon een korte melding wanneer je opnieuw verbinding maakt met wifi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新連線至 Wi-Fi 時顯示簡短通知。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показувати коротке сповіщення при повторному підключенні до Wi-Fi."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visa en kort avisering när du återansluter till Wi-Fi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazit krátké oznámení při opětovném připojení k Wi-Fi."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إظهار إشعار قصير عند إعادة اتصال Wi-Fi."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi पुन: कनेक्ट होने पर संक्षिप्त सूचना दिखाएं।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงการแจ้งเตือนสั้นๆ เมื่อเชื่อมต่อ Wi-Fi อีกครั้ง"
          }
        }
      }
    },
