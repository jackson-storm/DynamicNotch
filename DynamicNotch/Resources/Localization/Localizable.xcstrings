    "Turn off every persistent preview and close any temporary content." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إيقاف جميع المعاينات المستمرة وإغلاق أي محتوى مؤقت."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изключете всеки постоянен предварителен преглед и затворете временното съдържание."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "প্রতিটি চলমান প্রিভিউ বন্ধ করুন এবং যেকোনো অস্থায়ী বিষয়বস্তু বন্ধ করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactiva totes les previsualitzacions persistents i tanca el contingut temporal."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vypnout všechny trvalé náhledy a zavřít veškerý dočasný obsah."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå alle vedvarende forhåndsvisninger fra, og luk midlertidigt indhold."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle dauerhaften Vorschauen ausschalten und temporäre Inhalte schließen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Απενεργοποίηση κάθε μόνιμης προεπισκόπησης και κλείσιμο προσωρινού περιεχομένου."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn off every persistent preview and close any temporary content."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactivar todas las vistas previas persistentes y cerrar cualquier contenido temporal."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خاموش کردن تمام پیش‌نمایش‌های مداوم و بستن هرگونه محتوای موقت."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
