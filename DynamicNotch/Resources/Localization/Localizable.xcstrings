        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιλέξτε αν η ειδοποίηση θα χρησιμοποιεί αναλυτική κάρτα ή συμπαγές στυλ φόρτισης."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose whether the alert uses the current detailed card or a compact charging-like layout."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige si la alerta usa la tarjeta detallada o un diseño compacto tipo carga."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
