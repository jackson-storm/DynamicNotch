    "settings.screenRecording.autoDismiss.desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically close the screenshot notification after a delay."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerrar automáticamente la notificación de captura de pantalla tras un retraso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматически закрывать уведомление о снимке экрана после задержки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "延迟后自动关闭截图通知。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran görüntüsü bildirimini bir süre sonra otomatik olarak kapat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Screenshot-Benachrichtigung nach einer Verzögerung automatisch schließen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fermer automatiquement la notification de capture d'écran après un délai."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Fechar automaticamente a notificação de captura de ecrã após um intervalo de tempo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一定時間後にスクリーンショット通知を自動的に閉じます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일정 시간이 지나면 스크린샷 알림을 자동으로 닫습니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiudi automaticamente la notifica dello screenshot dopo un intervallo di tempo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatycznie zamykaj powiadomienie o zrzucie ekranu po upływie określonego czasu."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tự động đóng thông báo chụp màn hình sau một khoảng thời gian."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutup notifikasi tangkapan layar secara otomatis setelah beberapa saat."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sluit de schermafbeeldingsmelding automatisch na een bepaalde tijd."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在一段時間後自動關閉截圖通知。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматично закривати сповіщення про знімок екрана через певний час."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Stäng skärmavbildsaviseringen automatiskt efter en tidsgräns."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Automaticky zavřít oznámení o snímku obrazovky po uplynutí časového limitu."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إغلاق إشعار لقطة الشاشة تلقائياً بعد فترة."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "देरी के बाद स्क्रीनशॉट सूचना को स्वचालित रूप से बंद करें।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปิดการแจ้งเตือนภาพหน้าจอโดยอัตโนมัติหลังจากหน่วงเวลา"
          }
        }
      }
    },
