    "settings.general.display.unavailable.autoSwitchEnabled": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected display is unavailable right now. Dynamic Notch is temporarily following the main display."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La pantalla seleccionada no está disponible ahora mismo. Dynamic Notch está siguiendo temporalmente la pantalla principal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбранный дисплей сейчас недоступен. Dynamic Notch временно следует за основным дисплеем."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选显示屏当前不可用。Dynamic Notch 正在临时跟随主显示屏。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçilen ekran şu anda kullanılamıyor. Dynamic Notch geçici olarak ana ekranı izliyor."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ausgewählte Display ist derzeit nicht verfügbar. Dynamic Notch verwendet vorübergehend das Hauptdisplay."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'écran sélectionné est actuellement indisponible. Dynamic Notch s'affiche temporairement sur l'écran principal."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O ecrã selecionado está indisponível. O Dynamic Notch é apresentado temporariamente no ecrã principal."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したディスプレイは現在利用できません。Dynamic Notchは一時的にメインディスプレイに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 디스플레이를 현재 사용할 수 없습니다. Dynamic Notch가 임시로 메인 디스플레이에 표시됩니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo schermo selezionato non è al momento disponibile. Dynamic Notch viene visualizzato temporaneamente sullo schermo principale."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybrany ekran jest obecnie niedostępny. Dynamic Notch jest tymczasowo wyświetlany na ekranie głównym."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Màn hình đã chọn hiện không khả dụng. Dynamic Notch tạm thời hiển thị trên màn hình chính."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Layar yang dipilih saat ini tidak tersedia. Dynamic Notch ditampilkan sementara di layar utama."
          }
        }
      }
    },
