    "settings.wifi.noInternet.desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إظهار إشعار قصير عند فقدان Mac الاتصال بالإنترنت."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показване на кратко известие, когато вашият Mac загуби интернет връзка."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার Mac ইন্টারনেট সংযোগ হারালে একটি সংক্ষিপ্ত বিজ্ঞপ্তি দেখান।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra una notificació breu quan el Mac perd la connexió a Internet."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobrazit krátké oznámení, když Mac ztratí připojení k internetu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vis en kort notifikation, når din Mac mister internetadgangen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kurze Benachrichtigung anzeigen, wenn dein Mac die Internetverbindung verliert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εμφάνιση σύντομης ειδοποίησης όταν το Mac χάνει την πρόσβαση στο διαδίκτυο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Show a short notification when your Mac loses internet access."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrar una notificación breve cuando el Mac pierda acceso a internet."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نمایش اعلان کوتاه هنگام قطع اتصال اینترنت مک."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näytä lyhyt ilmoitus, kun Macisi menettää internetyhteyden."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magpakita ng maikling abiso kapag nawalan ng koneksyon sa internet ang iyong Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afficher une courte notification lorsque votre Mac perd la connexion Internet."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הצג התראה קצרה כאשר ה-Mac שלך מאבד חיבור לאינטרנט."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब आपका Mac इंटरनेट एक्सेस खो देता है तो संक्षिप्त सूचना दिखाएं।"
          }
        },
        "hr" : {
          "stringUnit" : {
