      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide the x button on file cards in the expanded Tray."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocultar el botón x en las tarjetas de archivos en la Bandeja expandida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скрыть кнопку × на карточках файлов в раскрытом Лотке."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在展开的托盘中隐藏文件卡片上的 x 按钮。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Genişletilmiş Tepsi'deki dosya kartlarında x düğmesini gizle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernen-Schaltfläche (x) auf Dateikarten in der erweiterten Dateiablage ausblenden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masquer le bouton de suppression (x) sur les fiches de fichiers dans le bac agrandi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocultar o botão de remover (x) nos cartões de ficheiros da bandeja expandida."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "展開されたトレイのファイルカードから削除ボタン（x）を非表示にします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확장된 트레이의 파일 카드에서 제거 버튼(x)을 숨깁니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nascondi il pulsante di rimozione (x) sulle schede dei file nel vassoio espanso."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukryj przycisk usuwania (x) na kartach plików w rozwiniętej tacce."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ẩn nút xóa (x) trên thẻ tệp trong khay mở rộng."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sembunyikan tombol hapus (x) pada kartu file di baki yang diperluas."
          }
        }
      }
    },
