    "settings.permissions.camera.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "السماح بالوصول للكاميرا لعرض معاينة الكاميرا في الشق."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешете достъп до камерата за показване на предварителен преглед в ноча."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "নচে একটি প্রিভিউ দেখাতে ক্যামেরা অ্যাক্সেসের অনুমতি দিন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permet l'accés a la càmera per mostrar una previsualització al notch."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povolte přístup k fotoaparátu pro zobrazení náhledu videa ve výřezu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillad kameraadgang for at vise en kameraforhåndsvisning i notchen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamera-Zugriff erlauben, um eine Kameravorschau in der Notch anzuzeigen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιτρέψτε την πρόσβαση στην Κάμερα για εμφάνιση προεπισκόπησης κάμερας στο notch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow Camera access to display a camera preview in the notch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite el acceso a la Cámara para mostrar una vista previa en la muesca."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اجازه دسترسی به دوربین برای نمایش پیش‌نمایش در ناچ."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salli Kameran käyttöoikeus kameran esikatselun näyttämiseen notchissa."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pahintulutan ang access sa camera upang magpakita ng preview sa notch."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autoriser l'accès à la Caméra pour afficher un aperçu vidéo dans l'encoche."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אפשר גישה למצלמה להצגת תצוגה מקדימה במגרעת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नॉच में कैमरा पूर्वावलोकन प्रदर्शित करने के लिए कैमरा एक्सेस की अनुमति दें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dozvolite pristup kameri za prikaz pretpregleda u urezu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamerahozzáférés engedélyezése a kamera-előnézet notch-ban való megjelenítéséhez."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izinkan akses ke Kamera untuk menampilkan pratinjau video di notch."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consenti l'accesso alla Fotocamera per mostrare l'anteprima video nel notch."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ノッチにビデオプレビューを表示するためにカメラへのアクセスを許可します。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ойықта алдын ала қарауды көрсету үшін камераға кіруге рұқсат беріңіз."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "노치에 비디오 미리보기를 표시하기 위해 카메라 접근 권한을 허용합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benarkan akses Kamera untuk memaparkan pratonton kamera di notch."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillat kameratilgang for å vise en kameraforhåndsvisning i notchen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verleen toegang tot de camera om een videovoorvertoning in de notch weer te geven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zezwól na dostęp do Kamery, aby wyświetlać podgląd wideo w notchu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permitir acesso à Câmara para apresentar a pré-visualização de vídeo no notch."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permiteți accesul la Cameră pentru a afișa o previzualizare a camerei în notch."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешите доступ к Камере для отображения предварительного просмотра в вырезе."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povoľte prístup ku kamere na zobrazenie náhľadu vo výreze."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дозволите приступ камери за приказ прегледа у ночу."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ge kameraåtkomst för att visa en videoförhandsvisning i flärpen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อนุญาตการเข้าถึงกล้องเพื่อแสดงตัวอย่างกล้องในรอยบาก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çentikte kamera önizlemesi göstermek için Kamera erişimine izin verin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Надайте доступ до камери для попереднього перегляду відео у вирізі notch."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cho phép truy cập Camera để hiển thị bản xem trước video trong notch."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许相机权限以在刘海中显示相机预览。"
