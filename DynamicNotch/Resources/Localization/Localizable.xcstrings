    "settings.notifications.messages.fullDiskAccess.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتاج DynamicNotch إلى الوصول الكامل إلى القرص لاكتشاف الرسائل الواردة. تتم معالجة رسائلك على هذا الـ Mac فقط."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DynamicNotch се нуждае от пълен достъп до диска, за да открива входящи съобщения. Вашите съобщения се обработват само на този Mac."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আসন্ন বার্তা শনাক্ত করতে DynamicNotch-এর সম্পূর্ণ ডিস্ক অ্যাক্সেস প্রয়োজন। আপনার বার্তাগুলি শুধু এই Mac-এই প্রক্রিয়া করা হয়।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DynamicNotch necessita accés complet al disc per detectar els missatges entrants. Els missatges només es processen en aquest Mac."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DynamicNotch potřebuje úplný přístup k disku, aby mohl rozpoznávat příchozí zprávy. Zprávy se zpracovávají pouze na tomto Macu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DynamicNotch skal have fuld diskadgang for at registrere indgående beskeder. Dine beskeder behandles kun på denne Mac."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DynamicNotch benötigt Festplattenvollzugriff, um eingehende Nachrichten zu erkennen. Deine Nachrichten werden nur auf diesem Mac verarbeitet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το DynamicNotch χρειάζεται Πλήρη πρόσβαση στον δίσκο για να εντοπίζει εισερχόμενα μηνύματα. Τα μηνύματά σας υποβάλλονται σε επεξεργασία μόνο σε αυτό το Mac."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DynamicNotch needs Full Disk Access to detect incoming Messages. Your messages are processed only on this Mac."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DynamicNotch necesita acceso total al disco para detectar los mensajes entrantes. Tus mensajes se procesan únicamente en este Mac."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DynamicNotch برای تشخیص پیام‌های دریافتی به دسترسی کامل به دیسک نیاز دارد. پیام‌های شما فقط در این Mac پردازش می‌شوند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DynamicNotch tarvitsee täydet levy-oikeudet saapuvien viestien tunnistamiseen. Viestisi käsitellään vain tällä Macilla."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kailangan ng DynamicNotch ng Full Disk Access upang matukoy ang mga papasok na mensahe. Sa Mac na ito lamang pinoproseso ang iyong mga mensahe."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DynamicNotch a besoin d’un accès complet au disque pour détecter les messages entrants. Vos messages sont traités uniquement sur ce Mac."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DynamicNotch זקוק לגישה מלאה לכונן כדי לזהות הודעות נכנסות. ההודעות שלך מעובדות רק ב-Mac זה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आने वाले संदेशों का पता लगाने के लिए DynamicNotch को पूर्ण डिस्क एक्सेस की आवश्यकता है। आपके संदेश केवल इसी Mac पर प्रोसेस किए जाते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DynamicNotch treba puni pristup disku kako bi otkrio dolazne poruke. Vaše se poruke obrađuju samo na ovom Macu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A DynamicNotch számára teljes lemezhozzáférés szükséges a bejövő üzenetek észleléséhez. Az üzenetek feldolgozása kizárólag ezen a Macen történik."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DynamicNotch memerlukan Akses Disk Penuh untuk mendeteksi pesan masuk. Pesan Anda hanya diproses di Mac ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DynamicNotch richiede l’accesso completo al disco per rilevare i messaggi in arrivo. I tuoi messaggi vengono elaborati solo su questo Mac."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "受信メッセージを検出するには、DynamicNotchにフルディスクアクセスが必要です。メッセージはこのMac上でのみ処理されます。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DynamicNotch қолданбасына кіріс хабарларды анықтау үшін дискіге толық қол жеткізу қажет. Хабарларыңыз тек осы Mac компьютерінде өңделеді."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "수신 메시지를 감지하려면 DynamicNotch에 전체 디스크 접근 권한이 필요합니다. 메시지는 이 Mac에서만 처리됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DynamicNotch memerlukan Akses Cakera Penuh untuk mengesan mesej masuk. Mesej anda diproses pada Mac ini sahaja."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DynamicNotch trenger full disktilgang for å oppdage innkommende meldinger. Meldingene dine behandles bare på denne Macen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DynamicNotch heeft volledige schijftoegang nodig om inkomende berichten te detecteren. Je berichten worden alleen op deze Mac verwerkt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DynamicNotch wymaga pełnego dostępu do dysku, aby wykrywać przychodzące wiadomości. Wiadomości są przetwarzane wyłącznie na tym Macu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O DynamicNotch precisa de acesso total ao disco para detetar mensagens recebidas. As suas mensagens são processadas apenas neste Mac."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DynamicNotch are nevoie de acces complet la disc pentru a detecta mesajele primite. Mesajele tale sunt procesate numai pe acest Mac."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DynamicNotch требуется полный доступ к диску, чтобы обнаруживать входящие сообщения. Ваши сообщения обрабатываются только на этом Mac."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DynamicNotch potrebuje úplný prístup k disku, aby mohol zisťovať prichádzajúce správy. Vaše správy sa spracúvajú iba na tomto Macu."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DynamicNotch захтева потпун приступ диску да би открио долазне поруке. Ваше поруке се обрађују само на овом Mac-у."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DynamicNotch behöver full skivåtkomst för att upptäcka inkommande meddelanden. Dina meddelanden behandlas endast på denna Mac."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DynamicNotch ต้องใช้สิทธิ์เข้าถึงดิสก์แบบเต็มเพื่อตรวจหาข้อความเข้า ข้อความของคุณจะได้รับการประมวลผลบน Mac เครื่องนี้เท่านั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DynamicNotch, gelen mesajları algılamak için Tam Disk Erişimi’ne ihtiyaç duyar. Mesajlarınız yalnızca bu Mac’te işlenir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DynamicNotch потрібен повний доступ до диска для виявлення вхідних повідомлень. Ваші повідомлення обробляються лише на цьому Mac."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DynamicNotch cần Quyền truy cập toàn bộ ổ đĩa để phát hiện tin nhắn đến. Tin nhắn của bạn chỉ được xử lý trên máy Mac này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DynamicNotch 需要“完全磁盘访问权限”才能检测收到的信息。你的信息只会在这台 Mac 上处理。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DynamicNotch 需要「完整磁碟存取權限」才能偵測收到的訊息。你的訊息只會在這部 Mac 上處理。"
          }
        }
      }
    },
