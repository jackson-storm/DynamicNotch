    "settings.hud.style.desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose visual presentation style for volume, brightness, and keyboard HUDs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige el estilo visual para los HUD de volumen, brillo y teclado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите внешний вид и макет индикаторов HUD."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择音量、亮度和键盘 HUD 的视觉呈现样式。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses düzeyi, parlaklık ve klavye HUD'ları için görsel sunum stilini seçin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erscheinungsbild für Lautstärke-, Helligkeits- und Tastatur-HUDs wählen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisir le style d'apparence des HUD de volume, luminosité et clavier."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolher o estilo de apresentação dos HUDs de volume, brilho e teclado."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音量、輝度、キーボードHUDの表示スタイルを選択します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음량, 화면 밝기 및 키보드 HUD의 모양 스타일을 선택하세요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli lo stile di aspetto degli HUD di volume, luminosità e tastiera."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz styl wyglądu HUD głośności, jasności i klawiatury."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn kiểu giao diện của HUD âm lượng, độ sáng và bàn phím."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih gaya tampilan HUD volume, kecerahan, dan keyboard."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies de uiterlijkstijl van de HUD's voor volume, helderheid en toetsenbord."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇音量、亮度與鍵盤 HUD 的外觀樣式。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть стиль оформлення HUD для гучності, яскравості та клавіатури."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj utseendestil för volym-, ljusstyrke- och tangentbords-HUD:ar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte styl vzhledu HUD pro hlasitost, jas a klávesnici."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر نمط العرض المرئي لعروض مستوى الصوت والسطوع ولوحة المفاتيح."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वॉल्यूम, चमक और कीबोर्ड HUDs के लिए दृश्य प्रस्तुति शैली चुनें।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกรูปแบบการนำเสนอสำหรับ HUD ระดับเสียง ความสว่าง และแป้นพิมพ์"
          }
        }
      }
    },
