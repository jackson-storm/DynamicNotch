    "settings.drop.airDrop.desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show live activity in notch when transferring files via AirDrop."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar actividad en vivo en la muesca al transferir archivos por AirDrop."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывать живую активность в вырезе при передаче файлов через AirDrop."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过 AirDrop 传输文件时在刘海中显示实时活动。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
