    "settings.lockScreen.sound.desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Play a sound when the screen is locked or unlocked."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproducir un sonido al bloquear o desbloquear la pantalla."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Воспроизводить звук при блокировке или разблокировке экрана."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "锁定或解锁屏幕时播放声音。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran kilitlendiğinde veya kilidi açıldığında ses çal."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton beim Sperren oder Entsperren des Bildschirms abspielen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Émettre un son lors du verrouillage ou du déverrouillage de l'écran."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocar um som ao bloquear ou desbloquear o ecrã."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面のロックまたはロック解除時にサウンドを再生します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면을 잠그거나 잠금 해제할 때 사운드를 재생합니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riproduci un suono quando blocchi o sblocchi lo schermo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odtwarzaj dźwięk podczas blokowania lub odblokowywania ekranu."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phát âm thanh khi khóa hoặc mở khóa màn hình."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Putar suara saat mengunci atau membuka kunci layar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Speel een geluid af wanneer je het scherm vergrendelt of ontgrendelt."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "鎖定或解鎖螢幕時播放聲音。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відтворювати звук при блокуванні або розблокуванні екрана."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spela ett ljud när du låser eller låser upp skärmen."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přehrát zvuk při zamčení nebo odemčení obrazovky."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Play a sound when the screen is locked or unlocked."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
