        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VPN әрекетінің шағын болуын немесе туннель мәліметтерін көрсетуін таңдаңыз."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VPN 활동을 컴팩트하게 유지할지 터널 세부 정보를 표시할지 선택하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
