    "settings.drop.airDrop.desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show live activity in notch when transferring files via AirDrop."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar actividad en vivo en la muesca al transferir archivos por AirDrop."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывать живую активность в вырезе при передаче файлов через AirDrop."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过 AirDrop 传输文件时在刘海中显示实时活动。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "AirDrop ile dosya aktarılırken çentikte canlı etkinlik göster."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Live-Aktivität in der Notch bei Dateiübertragungen via AirDrop anzeigen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher une activité en direct dans l'encoche lors du transfert de fichiers via AirDrop."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar uma atividade em tempo real no notch ao transferir ficheiros através do AirDrop."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AirDrop経由でファイルを転送する際にノッチにライブアクティビティを表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AirDrop을 통해 파일을 전송할 때 노치에 실시간 활동을 표시합니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra un'attività in tempo reale nel notch durante il trasferimento di file tramite AirDrop."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokaż aktywność na żywo w notchu podczas przesyłania plików przez AirDrop."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiển thị hoạt động trực tiếp trong notch khi truyền tệp qua AirDrop."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tampilkan aktivitas langsung di notch saat mentransfer file melalui AirDrop."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toon een live activiteit in de notch tijdens het overbrengen van bestanden via AirDrop."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過 AirDrop 傳輸檔案時在「瀏海」中顯示即時活動。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показувати активність наживо у вирізі під час передачі файлів через AirDrop."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visa en liveaktivitet i flärpen när du överför filer via AirDrop."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazit živou aktivitu ve výřezu při přenosu souborů přes AirDrop."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Show live activity in notch when transferring files via AirDrop."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Show live activity in notch when transferring files via AirDrop."
          }
        }
      }
