            "state": "translated",
            "value": "Escolha quanto tempo a notificação de bateria cheia permanece visível."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フル充電通知を表示し続ける時間を選択します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완충 알림이 표시되는 지속 시간을 선택하세요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli per quanto tempo la notifica di carica completa rimane visibile."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz, jak długo powiadomienie o pełnym naładowaniu pozostaje widoczne."
          }
        },
        "vi": {
          "stringUnit": {
