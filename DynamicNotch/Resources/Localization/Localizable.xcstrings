    "settings.wifi.noInternet.desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show a short notification when your Mac loses internet access."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar una notificación breve cuando el Mac pierda acceso a internet."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показать короткое уведомление при потере доступа к интернету."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 失去互联网连接时显示短暂通知。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac'iniz internet erişimini kaybettiğinde kısa bir bildirim göster."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurze Benachrichtigung anzeigen, wenn dein Mac die Internetverbindung verliert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher une courte notification lorsque votre Mac perd la connexion Internet."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar uma notificação curta quando o seu Mac perder a ligação à Internet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macのインターネット接続が失われたときに短い通知を表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac의 인터넷 연결이 끊어졌을 때 짧은 알림을 표시합니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra una breve notifica quando il Mac perde la connessione Internet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokaż krótkie powiadomienie, gdy Mac utraci połączenie z Internetem."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiển thị thông báo ngắn khi máy Mac của bạn mất kết nối Internet."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tampilkan notifikasi singkat saat Mac Anda kehilangan koneksi Internet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toon een korte melding wanneer je Mac de internetverbinding verliest."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當 Mac 失去網際網路連線時顯示簡短通知。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показувати коротке сповіщення, коли Mac втрачає підключення до інтернету."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visa en kort avisering när din Mac tappar internetanslutningen."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazit krátké oznámení, když Mac ztratí připojení k internetu."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إظهار إشعار قصير عند فقدان Mac الاتصال بالإنترنت."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब आपका Mac इंटरनेट एक्सेस खो देता है तो संक्षिप्त सूचना दिखाएं।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงการแจ้งเตือนสั้นๆ เมื่อ Mac ของคุณขาดการเชื่อมต่ออินเทอร์เน็ต"
          }
        }
      }
    },
