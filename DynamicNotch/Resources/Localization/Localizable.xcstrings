    "settings.hud.indicatorTintStyle.desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose tint color style for indicator level."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige el estilo de color de tinte para el indicador."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите цвет наполнения уровня индикатора."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择指示器等级的颜色样式。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gösterge düzeyi için renk tonu stilini seçin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Farbgebung für den Füllstand des Indikators wählen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisir le style de couleur de remplissage du niveau de l'indicateur."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolher o estilo de cor de preenchimento do nível do indicador."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インジケータレベルの塗りつぶしカラースタイルを選択します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "표시기 레벨의 채우기 색상 스타일을 선택하세요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli lo stile del colore di riempimento del livello dell'indicatore."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz styl koloru wypełnienia poziomu wskaźnika."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn kiểu màu tô mức chỉ báo."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih gaya warna isi tingkat indikator."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies de vulkleurstijl van het indicatorniveau."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇指示器等級的填滿顏色樣式。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть стиль кольору заповнення рівня індикатора."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj fyllningsfärgstil för indikatornivån."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte styl barvy výplně úrovně indikátoru."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر نمط لون التلوين لمستوى المؤشر."
          }
