    "settings.language.notice": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Localization only works for settings, the notch remains in English."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La localización solo funciona en ajustes, la muesca permanece en inglés."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Локализация работает только в настройках, вырез остаётся на английском."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地化仅适用于设置，刘海区域保持英文。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerelleştirme yalnızca ayarlarda geçerlidir; çentik İngilizce kalır."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Lokalisierung gilt nur für die Einstellungen; die Notch bleibt auf Englisch."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La localisation ne fonctionne que pour les réglages, l'encoche reste en anglais."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A localização funciona apenas para as definições; o notch permanece em inglês."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカライズは設定画面のみに適用され、ノッチ本体は英語で表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현지화는 설정 화면에만 적용되며, 노치는 영어로 유지됩니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La localizzazione si applica solo alle impostazioni; il notch rimane in inglese."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokalizacja działa tylko w ustawieniach; notch pozostaje w języku angielskim."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản địa hóa chỉ áp dụng cho cài đặt; notch vẫn hiển thị bằng tiếng Anh."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokalisasi hanya berlaku untuk pengaturan; notch tetap dalam bahasa Inggris."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De lokalisatie is alleen van toepassing op de instellingen; de notch blijft in het Engels."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本地化僅適用於設定；「瀏海」仍保持為英文。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Локалізація застосовується лише до налаштувань; notch залишається англійською."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokaliseringen gäller endast inställningarna; flärpen förblir på engelska."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokalizace se vztahuje pouze na nastavení; výřez zůstává v angličtině."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Localization only works for settings, the notch remains in English."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Localization only works for settings, the notch remains in English."
          }
        }
      }
    },
