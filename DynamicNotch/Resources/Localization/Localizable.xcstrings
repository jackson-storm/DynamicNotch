    "settings.downloads.liveActivity.desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show a live activity while files are being downloaded to monitored folders like Downloads, Desktop, and Documents."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar actividad en vivo mientras se descargan archivos en carpetas monitorizadas como Descargas, Escritorio y Documentos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывать живую активность при загрузке файлов в отслеживаемые папки: Загрузки, Рабочий стол и Документы."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在文件下载到监控文件夹（如下载、桌面和文稿）时显示实时活动。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İndirilenler, Masaüstü ve Belgeler gibi izlenen klasörlere dosya indirilirken canlı etkinlik göster."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Live-Aktivität anzeigen, während Dateien in überwachte Ordner wie Downloads, Schreibtisch und Dokumente heruntergeladen werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher une activité en direct pendant le téléchargement de fichiers dans les dossiers surveillés comme Téléchargements, Bureau et Documents."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar uma atividade em tempo real durante a transferência de ficheiros em pastas monitorizadas como Descargas, Secretária e Documentos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「ダウンロード」「デスクトップ」「書類」などの監視対象フォルダへのファイルダウンロード中にライブアクティビティを表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다운로드, 데스크탑, 문서 등 감시 폴더로 파일이 다운로드되는 동안 실시간 활동을 표시합니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra un'attività in tempo reale durante il download di file nelle cartelle monitorate come Download, Scrivania e Documenti."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokaż aktywność na żywo podczas pobierania plików do monitorowanych folderów, takich jak Pobrane, Biurko i Dokumenty."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiển thị hoạt động trực tiếp trong khi tải tệp xuống các thư mục được giám sát như Tải xuống, Màn hình chính và Tài liệu."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tampilkan aktivitas langsung saat mengunduh file ke folder yang dipantau seperti Unduhan, Desktop, dan Dokumen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toon een live activiteit tijdens het downloaden van bestanden naar bewaakte mappen zoals Downloads, Bureaublad en Documenten."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在將檔案下載至「下載項目」、「桌面」和「文件」等監控資料夾時顯示即時活動。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показувати активність наживо під час завантаження файлів у відстежувані папки, такі як Завантаження, Робочий стіл і Документи."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visa en liveaktivitet när filer hämtas till övervakade mappar som Hämtade filer, Skrivbord och Dokument."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazit živou aktivitu při stahování souborů do sledovaných složek, jako jsou Stahování, Plocha a Dokumenty."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Show a live activity while files are being downloaded to monitored folders like Downloads, Desktop, and Documents."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Show a live activity while files are being downloaded to monitored folders like Downloads, Desktop, and Documents."
          }
        }
      }
    },
