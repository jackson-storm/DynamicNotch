    "settings.notch.defaultStrokeColor.desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apply the standard white stroke to supported activities instead of feature accent colors."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicar el borde blanco estándar en lugar de colores de acento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Использовать стандартную белую обводку вместо цветных акцентов."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将标准白色描边应用于支持的活动，而非功能强调色。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Desteklenen etkinliklerde özellik vurgu renkleri yerine standart beyaz kenarlığı uygula."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardmäßige weiße Kontur für unterstützte Aktivitäten statt Akzentfarben verwenden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appliquer le contour blanc standard aux activités prises en charge au lieu des couleurs d'accentuation."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicar o contorno branco padrão às atividades suportadas em vez de cores de destaque."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセントカラーの代わりに、サポートされているアクティビティに標準の白の枠線を適用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "강조 색상 대신 지원되는 활동에 표준 흰색 테두리를 적용합니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Applica il bordo bianco standard alle attività supportate anziché i colori di accento."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zastosuj standardowy biały obrys do obsługiwanych aktywności zamiast kolorów akcentu."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Áp dụng viền trắng tiêu chuẩn cho các hoạt động được hỗ trợ thay vì màu nhấn."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terapkan batas putih standar ke aktivitas yang didukung alih-alih warna aksen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de standaard witte rand toe op ondersteunde activiteiten in plaats van accentkleuren."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對支援的活動套用標準白色邊框，而非強調色。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Застосовувати стандартний білий контур до підтримуваних активностей замість акцентних кольорів."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Använd standardvit ram på aktiviteter som stöds istället för accentfärger."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Použít standardní bílé ohraničení na podporované aktivity místo barev akcentu."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apply the standard white stroke to supported activities instead of feature accent colors."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Apply the standard white stroke to supported activities instead of feature accent colors."
          }
        }
      }
    },
