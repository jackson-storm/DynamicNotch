    "settings.notch.height.desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ضبط ارتفاع الشق أو الجزيرة الديناميكية بدقة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прецизна настройка на височината на ноча или Dynamic Island."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "নচ বা Dynamic Island-এর উচ্চতা সূক্ষ্মভাবে সমন্বয় করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajusta amb precisió l'alçada del notch o Dynamic Island."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jemně dolaďte výšku výřezu nebo Dynamic Island."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finjuster højden på notchen eller Dynamic Island."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Höhe der Notch oder Dynamic Island feinjustieren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μικρορύθμιση του ύψους του notch ή του Dynamic Island."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fine-tune the height of the notch or Dynamic Island."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajustar la altura de la muesca o Dynamic Island."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تنظیم دقیق ارتفاع ناچ یا Dynamic Island."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hienosäädä notchin tai Dynamic Islandin korkeutta."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pinuhin ang taas ng notch o Dynamic Island."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajuster précisément la hauteur de l'encoche ou de la Dynamic Island."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כוונן את גובה המגרעת או ה-Dynamic Island."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नॉच या डायनामिक आइलैंड की ऊंचाई को सटीक रूप से समायोजित करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fino podesite visinu ureza ili Dynamic Islanda."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A notch vagy Dynamic Island magasságának finomhangolása."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesuaikan ketinggian notch atau Dynamic Island secara presisi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regola con precisione l'altezza del notch o della Dynamic Island."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
