            "value": "バックグラウンドでアップデートをダウンロードし、準備ができたときに通知します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백그라운드에서 업데이트를 다운로드하고 준비되면 알립니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scarica gli aggiornamenti in background e ti avvisa quando sono pronti."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pobieraj aktualizacje w tle i powiadamiaj, gdy będą gotowe."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tải xuống các bản cập nhật trong nền và thông báo cho bạn khi chúng sẵn sàng."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Unduh pembaruan di latar belakang dan beri tahu Anda saat sudah siap."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Download updates op de achtergrond en meld het wanneer ze klaar zijn."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在背景下載更新並在準備就緒時通知您。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завантажувати оновлення у фоновому режимі та повідомляти про готовність."
          }
        },
        "sv": {
