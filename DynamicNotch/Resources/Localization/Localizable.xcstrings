    "No VPN configurations found on this Mac. Please add a VPN connection in System Settings -> VPN first.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No VPN configurations found on this Mac. Please add a VPN connection in System Settings -> VPN first."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На этом Mac не найдены конфигурации VPN. Сначала добавьте VPN-подключение в Системных настройках -> VPN."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontraron configuraciones de VPN en este Mac. Agregue primero una conexión VPN en Configuración del Sistema -> VPN."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在此 Mac 上未找到 VPN 配置。请先在“系统设置”->“VPN”中添加 VPN 连接。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Mac'te VPN yapılandırması bulunamadı. Lütfen önce Sistem Ayarları -> VPN bölümünden bir VPN bağlantısı ekleyin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem Mac wurden keine VPN-Konfigurationen gefunden. Bitte füge zuerst eine VPN-Verbindung in Systemeinstellungen -> VPN hinzu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune configuration VPN trouvée sur ce Mac. Veuillez d'abord ajouter une connexion VPN dans Réglages Système -> VPN."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma configuração VPN encontrada neste Mac. Adicione primeiro uma ligação VPN nas Definições do Sistema -> VPN."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacでVPN設定が見つかりませんでした。「システム設定」->「VPN」でVPN接続を追加してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac에서 VPN 구성을 찾을 수 없습니다. 시스템 설정 -> VPN에서 먼저 VPN 연결을 추가하세요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna configurazione VPN trovata su questo Mac. Aggiungi prima una connessione VPN in Impostazioni di Sistema -> VPN."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie znaleziono konfiguracji VPN na tym Macu. Najpierw dodaj połączenie VPN w Ustawieniach systemowych -> VPN."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không tìm thấy cấu hình VPN nào trên máy Mac này. Vui lòng thêm kết nối VPN trong Cài đặt hệ thống -> VPN trước."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada konfigurasi VPN yang ditemukan di Mac ini. Silakan tambahkan koneksi VPN di Pengaturan Sistem -> VPN terlebih dahulu."
          }
        }
      }
    },
