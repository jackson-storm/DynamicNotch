    "settings.vpn.style.headerDesc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose whether the VPN activity stays compact or shows tunnel details."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige si la actividad VPN se mantiene compacta o muestra detalles del túnel."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите, остаётся ли активность VPN компактной или показывает детали туннеля."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择 VPN 活动是保持紧凑还是显示隧道详情。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN etkinliğinin kompakt mı kalacağını yoksa tünel ayrıntılarını mı göstereceğini seçin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle, ob die VPN-Aktivität kompakt bleibt oder Tunneldetails anzeigt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez si l'activité VPN reste compacte ou affiche les détails du tunnel."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha se a atividade VPN permanece compacta ou mostra detalhes do túnel."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "VPNアクティビティをコンパクトに保つか、トンネルの詳細を表示するかを選択します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN 활동을 컴팩트하게 유지할지 터널 세부 정보를 표시할지 선택하세요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli se l'attività VPN rimane compatta o mostra i dettagli del tunnel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz, czy aktywność VPN ma pozostać kompaktowa, czy wyświetlać szczegóły tunelu."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn xem hoạt động VPN vẫn nhỏ gọn hay hiển thị chi tiết đường hầm."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih apakah aktivitas VPN tetap ringkas atau menampilkan detail terowongan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies of de VPN-activiteit compact blijft of tunneldetails toont."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇 VPN 活動保持緊湊或顯示通道詳細資訊。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть, чи залишати активність VPN компактною, або показувати деталі тунелю."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj om VPN-aktiviteten ska förbli kompakt eller visa tunneldetaljer."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvolte, zda aktivita VPN zůstane kompaktní, nebo zobrazí podrobnosti o tunelu."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر ما إذا كان نشاط VPN يبقى مضغوطاً أو يعرض تفاصيل النفق."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चुनें कि VPN गतिविधि कॉम्पैक्ट रहे या टनल विवरण दिखाए।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกว่ากิจกรรม VPN จะคงความกะทัดรัดหรือแสดงรายละเอียดอุโมงค์"
          }
        }
      }
    },
