    "settings.section.lockScreen.subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انتقالات القفل والصوت وسلوك الوسائط على شاشة القفل."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Преходи при заключване, звук и поведение на медията на заключения екран."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "লক ট্রানজিশন, শব্দ এবং লক স্ক্রিনে মিডিয়া আচরণ।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transicions de bloqueig, so i comportament multimèdia a la pantalla de bloqueig."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přechody uzamčení, zvuky a chování médií na zamčené obrazovce."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Låseovergange, lyd og medieadfærd på låseskærmen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sperranimationen, Töne und Medienverhalten auf dem Sperrbildschirm."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μεταβάσεις κλειδώματος, ήχος και συμπεριφορά πολυμέσων στην οθόνη κλειδώματος."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lock transitions, sound, and lock-screen media behavior."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transiciones de bloqueo, sonido y comportamiento multimedia en pantalla de bloqueo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تغییرات صفحه قفل، صدا و رفتار رسانه در صفحه قفل."
          }
        },
