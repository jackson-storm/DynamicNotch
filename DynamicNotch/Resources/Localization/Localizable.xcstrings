    "settings.notch.priorities.customOrder.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag items to reorder priority. Upper items have higher priority."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетащите элементы для изменения приоритета. Элементы выше имеют более высокий приоритет."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra los elementos для reordenar la prioridad. Los elementos superiores tienen mayor prioridad."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动项目以重新排列优先级。上面的项目具有更高的优先级。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önceliği değiştirmek için öğeleri sürükleyin. Üstteki öğelerin önceliği daha yüksektir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Elemente ziehen, um Prioritäten neu anzuordnen. Obere Elemente haben Vorrang."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser pour réorganiser les priorités. Les éléments du haut sont prioritaires."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste para reorganizar prioridades. Os itens no topo têm prioridade."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドラッグして優先順位を変更します。上位の項目が優先されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "드래그하여 우선순위를 변경하세요. 상단 항목이 우선순위를 갖습니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina per riordinare le priorità. Gli elementi in alto hanno la priorità."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeciągaj, aby zmienić priorytety. Elementy u góry mają pierwszeństwo."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kéo để sắp xếp lại mức độ ưu tiên. Các mục ở trên cùng được ưu tiên."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seret untuk mengatur ulang prioritas. Item di bagian atas memiliki prioritas."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep om prioriteiten opnieuw te ordenen. Bovenste items hebben voorrang."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖移以重新排列優先順序。頂部項目具有優先權。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетягуйте, щоб змінити пріоритети. Верхні елементи мають перевагу."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dra för att ändra prioritetsordning. Översta objekten har företräde."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přetažením změňte pořadí priorit. Položky nahoře mají přednost."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحب العناصر لإعادة ترتيب الأولوية. العناصر العليا لها أولوية أعلى."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्राथमिकता पुनर्व्यवस्थित करने के लिए आइटम खींचें। ऊपरी आइटमों की प्राथमिकता अधिक है।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลากรายการเพื่อจัดลำดับความสำคัญ รายการด้านบนจะมีลำดับความสำคัญสูงกว่า"
          }
        }
      }
    },
