        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Helligkeit für Widgets auf dem Sperrbildschirm anpassen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuster la luminosité des widgets sur l'écran verrouillé."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustar o brilho dos widgets no ecrã bloqueado."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロック画面のウィジェットの明るさを調整します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠금 화면에서 위젯의 밝기를 조정합니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Regola la luminosità dei widget sulla schermata di blocco."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostosuj jasność widżetów na ekranie blokady."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Điều chỉnh độ sáng của các tiện ích trên màn hình khóa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesuaikan kecerahan widget di layar kunci."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de helderheid van widgets op het toegangsscherm aan."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "調整鎖定畫面上小工具的亮度。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Налаштуйте яскравість віджетів на екрані блокування."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Justera ljusstyrkan för widgetar på låsskärmen."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
