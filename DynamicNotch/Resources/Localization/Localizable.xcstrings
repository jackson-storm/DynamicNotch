    "settings.reset.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This will restore default values only for the current tab. This action cannot be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto restaurará los valores predeterminados solo para la pestaña actual. Esta acción no se puede deshacer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это восстановит значения по умолчанию только для текущей вкладки. Это действие нельзя отменить."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将仅恢复当前选项卡的默认值。此操作无法撤消。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu işlem yalnızca geçerli sekmedeki değerleri varsayılana döndürür. Bu işlem geri alınamaz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden die Standardwerte nur für die aktuelle Registerkarte wiederhergestellt. Diese Aktion kann nicht rückgängig gemacht werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action rétablira les valeurs par défaut uniquement pour l'onglet actif. Cette opération est irréversible."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta ação irá repor os valores predefinidos apenas para o separador ativo. Esta operação é irreversível."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この操作により、現在のアクティブなタブの設定のみがデフォルト値に戻ります。この操作は元に戻せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 작업을 수행하면 현재 활성 탭의 설정만 기본값으로 복원됩니다. 이 작업은 취소할 수 없습니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa azione ripristinerà i valori predefiniti solo per la scheda attiva. Questa operazione non può essere annullata."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta czynność przywróci wartości domyślne tylko dla aktywnej karty. Tej operacji nie można cofnąć."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thao tác này sẽ khôi phục các giá trị mặc định chỉ cho tab hiện đang hoạt động. Thao tác này không thể hoàn tác."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tindakan ini akan mengembalikan nilai default hanya untuk tab yang aktif saat ini. Tindakan ini tidak dapat diurungkan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Met deze actie worden de standaardwaarden alleen voor het huidige actieve tabblad hersteld. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作僅會還原目前使用中標籤頁的預設值。此操作無法復原。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ця дія відновить значення за замовчуванням лише для поточної активної вкладки. Цю дію не можна скасувати."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här åtgärden återställer standardvärdena endast för den aktiva fliken. Detta kan inte ångras."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tato akce obnoví výchozí hodnoty pouze pro aktuálně aktivní kartu. Tuto akci nelze vrátit zpět."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيؤدي هذا لاستعادة القيم الافتراضية للتبويب الحالي فقط. لا يمكن التراجع عن هذا الإجراء."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह केवल वर्तमान टैब के लिए डिफ़ॉल्ट मान पुनर्स्थापित करेगा। इस क्रिया को पूर्ववत नहीं किया जा सकता है।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การดำเนินการนี้จะคืนค่าเริ่มต้นเฉพาะสำหรับแท็บปัจจุบันเท่านั้น ไม่สามารถเลิกทำได้"
          }
        }
      }
    },
