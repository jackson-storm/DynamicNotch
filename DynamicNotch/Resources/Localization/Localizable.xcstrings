    "settings.hud.levelStrokeColor.desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تلوين حد الشق باستخدام لون مستوى العرض الحالي بدلاً من الحد الأبيض الافتراضي."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оцветяване на контура на ноча с текущия цвят на нивото вместо с бяло."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "নচ স্ট্রোকটি সাদার পরিবর্তে বর্তমান HUD স্তর রঙে রঙ করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acoloreix el traç del notch amb el color del nivell del HUD actual en lloc de blanc."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zbarvit ohraničení výřezu aktuální barvou úrovně HUD namísto výchozí bílé."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tone notch-stregen med den aktuelle HUD-niveaufarve i stedet for hvid."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notch-Kontur in der aktuellen HUD-Pegelfarbe statt des standardmäßigen Weiß färben."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χρωματισμός περιγράμματος notch με το χρώμα επιπέδου HUD αντί για λευκό."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tint the notch stroke using the current HUD level color instead of the default white stroke."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teñir el borde de la muesca con el color del nivel de HUD en lugar del blanco predeterminado."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رنگ‌آمیزی خط دور ناچ با رنگ سطح فعلی HUD به جای سفید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sävytä notchin viiva nykyisellä HUD-tasovärillä valkoisen sijaan."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kulayan ang stroke ng notch gamit ang kasalukuyang kulay ng antas ng HUD sa halip na puti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teinter le contour de l'encoche avec la couleur de niveau actuelle du HUD au lieu du blanc par défaut."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "צבע את קו המתאר של המגרעת בצבע רמת ה-HUD הנוכחי במקום בלבן."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डिफ़ॉल्ट सफेद स्ट्रोक के बजाय वर्तमान HUD स्तर के रंग का उपयोग करके नॉच स्ट्रोक को टिंट करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oboji obrub ureza trenutnom bojom razine HUD-a umjesto bijele."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A notch körvonalának színezése a HUD aktuális szintjének színével a fehér helyett."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warnai batas notch dengan warna level HUD saat ini alih-alih warna putih default."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colora il bordo del notch con il colore del livello attuale dell'HUD invece del bianco predefinito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デフォルトの白の代わりに、現在のHUDレベルカラーでノッチの枠線を色付けします。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ойық жиегін ақ түстің орнына HUD ағымдағы деңгейі түсімен бояу."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기본 흰색 대신 현재 HUD 레벨 색상으로 노치 테두리를 칠합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warnakan garis notch dengan warna tahap HUD semasa dan bukannya putih."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fargelegg notch-streken med gjeldende HUD-nivåfarge i stedet for hvit."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kleur de rand van de notch met de huidige HUD-niveaukleur in plaats van standaard wit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zabarw obrys notcha bieżącym kolorem poziomu HUD zamiast domyślnej bieli."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colorir o contorno do notch com a cor do nível atual do HUD em vez do branco padrão."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colorează conturul notch-ului folosind culoarea nivelului HUD în loc de albul implicit."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Окрашивать обводку выреза в цвет уровня HUD вместо белого по умолчанию."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zafarbiť obrys výrezu aktuálnou farbou úrovne HUD namiesto bielej."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обоји ивицу ноча тренутном бојом нивоа HUD-а уместо беле."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Färglägg flärpens ram med den aktuella HUD-nivåfärgen istället för standardvitt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ย้อมสีเส้นขอบรอยบากตามสีระดับ HUD ปัจจุบันแทนเส้นขอบสีขาวเริ่มต้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çentik kenarlığını varsayılan beyaz yerine geçerli HUD düzeyi rengiyle renklendir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фарбувати контур notch кольором поточного рівня HUD замість стандартного білого."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tô màu viền notch bằng màu mức HUD hiện tại thay vì màu trắng mặc định."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用当前 HUD 等级颜色为刘海描边着色，而非默认的白色描边。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用目前的 HUD 等級顏色為「瀏海」邊框著色，而非預設的白色。"
          }
        }
      }
    },
