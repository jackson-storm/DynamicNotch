    "settings.downloads.progressIndicator.desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose whether download progress uses a percentage label or a circular ring."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige si el progreso usa un porcentaje o un anillo circular."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите, отображается ли прогресс загрузки в процентах или кольцом."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择下载进度使用百分比标签还是圆环。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İndirme ilerlemesinin yüzde etiketi mi yoksa dairesel halka mı kullanacağını seçin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle, ob der Download-Fortschritt als Prozentangabe oder Kreisring dargestellt wird."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez si la progression du téléchargement utilise un pourcentage ou un anneau circulaire."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha se o progresso da descarga utiliza uma percentagem ou um anel circular."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロードの進捗をパーセントまたは円形リングで表示するかを選択します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다운로드 진행률을 백분율로 표시할지 원형 링으로 표시할지 선택하세요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli se l'avanzamento del download utilizza una percentuale o un anello circolare."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz, czy postęp pobierania ma używać procentu czy okrągłego pierścienia."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn xem tiến trình tải xuống hiển thị theo phần trăm hay vòng tròn."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih apakah kemajuan unduhan menggunakan persentase atau cincin melingkar."
          }
        }
      }
    },
