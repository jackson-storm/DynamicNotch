    "settings.notch.gestures.swipeDismissAndRestore.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow vertical swipe gestures over the notch to hide the active activity or restore the recently dismissed one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite gestos de deslizamiento vertical sobre la muesca para ocultar la actividad activa o restaurar la recientemente cerrada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешить вертикальные свайпы по вырезу для скрытия активной панели или восстановления недавно закрытой."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许在刘海上进行垂直滑动以隐藏活动内容或恢复最近关闭的内容。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çentik üzerindeki dikey kaydırma hareketlerinin etkin etkinliği gizlemesine veya son kapatılanı geri getirmesine izin ver."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vertikale Wischgesten über der Notch erlauben, um die aktive Aktivität auszublenden oder die zuletzt geschlossene wiederherzustellen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autoriser les balayages verticaux sur l'encoche pour masquer l'activité active ou rétablir la dernière fermée."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir deslizes verticais no notch para ocultar a atividade ativa ou restaurar a última fechada."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノッチ上を縦にスワイプしてアクティブなアクティビティを非表示にしたり、直前に閉じたアクティビティを復元したりできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노치 위에서 수직으로 쓸어올려 활성 활동을 숨기거나 쓸어내려 마지막으로 닫은 활동을 복원합니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti scorrimenti verticali sul notch per nascondere l'attività attiva o ripristinare l'ultima chiusa."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zezwalaj na pionowe przeciągnięcia po notchu, aby ukryć aktywność lub przywrócić ostatnio zamkniętą."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho phép vuốt dọc trên notch để ẩn hoạt động hiện tại hoặc khôi phục hoạt động đã đóng gần nhất."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izinkan gesekan vertikal pada notch untuk menyembunyikan aktivitas aktif atau memulihkan yang terakhir ditutup."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sta verticale veegbewegingen op de notch toe om de actieve activiteit te verbergen of de laatst gesloten te herstellen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許在「瀏海」上垂直滑動以關閉使用中活動或復原上次關閉的活動。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозволити вертикальні змахування по вирізу notch, щоб сховати активність або відновити останню закриту."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillåt vertikala svepningar på flärpen för att dölja aktiv aktivitet eller återställa den senast stängda."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Povolit svislá přejetí po výřezu pro skrytí aktivní aktivity nebo obnovení naposledy zavřené."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "السماح بإيماءات السحب العمودية فوق الشق لإخفاء النشاط الحالي أو استعادة النشاط المُرفَض مؤخراً."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सक्रिय गतिविधि को छिपाने या हाल ही में खारिज की गई गतिविधि को पुनर्स्थापित करने के लिए नॉच पर लंबवत स्वाइप जेस्चर की अनुमति दें।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อนุญาตท่าทางปัดแนวตั้งเหนือรอยบากเพื่อซ่อนกิจกรรมหรือกู้คืนกิจกรรมที่เพิ่งปิดไป"
          }
        }
      }
    },
    "settings.notch.gestures.swipeDismissAndRestore.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swipe up to hide / down to restore"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza hacia arriba para ocultar / abajo para restaurar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Свайп вверх для скрытия / вниз для возврата"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上滑以隐藏 / 下滑以恢复"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gizlemek için yukarı, geri getirmek için aşağı kaydır"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach oben wischen zum Ausblenden / nach unten zum Wiederherstellen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Balayer vers le haut pour masquer / vers le bas pour rétablir"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Deslizar para cima para ocultar / para baixo para restaurar"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上スワイプで非表示 / 下スワイプで復元"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위로 쓸어올려 숨기기 / 아래로 쓸어내려 복원"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scorri verso l'alto per chiudere / verso il basso per ripristinare"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przesuń w górę, aby ukryć / w dół, aby przywrócić"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuốt lên để ẩn / vuốt xuống để khôi phục"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesek ke atas untuk menutup / ke bawah untuk memulihkan"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Omhoog vegen om te sluiten / omlaag vegen om te herstellen"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "向上滑動以關閉 / 向下滑動以復原"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Змах вгору для приховування / змах вниз для відновлення"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Svep uppåt för att stänga / svep nedåt för att återställa"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přejetí nahoru pro zavření / přejetí dolů pro obnovení"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحب للأعلى للإخفاء / للأسفل للاستعادة"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "छिपाने के लिए ऊपर / पुनर्स्थापित करने के लिए नीचे स्वाइप करें"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปัดขึ้นเพื่อซ่อน / ปัดลงเพื่อกู้คืน"
          }
        }
      }
    },
