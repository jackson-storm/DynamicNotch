          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jednorazowa darowizna za pomocą karty lub kryptowaluty"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quyên góp một lần qua thẻ hoặc tiền điện tử"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Donasi sekali pakai melalui kartu atau kripto"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eenmalige donatie via kaart of crypto"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過信用卡或加密貨幣進行單次捐贈"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Разовий донат картою або криптовалютою"
          }
        },
        "sv": {
