    "settings.notch.gestures.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Configure click, hover, and scroll gestures."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Configura los gestos de clic, deslizamiento y desplazamiento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройте жесты нажатия, наведения и прокрутки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配置点击、悬停和滚动手势。"
          }
        },
