    "Run every debug event in sequence, keep each item visible for its configured duration, and wait 1 second between items." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تشغيل كل أحداث التصحيح بالتتابع، وإبقاء كل عنصر مرئياً للمدة المحددة، والانتظار ثانية واحدة بين العناصر."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изпълнете всяко събитие за отстраняване на грешки последователно, задръжте всеки елемент видим за зададената продължителност и изчакайте 1 секунда между елементите."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "প্রতিটি ডিবাগ ইভেন্ট ক্রমানুসারে চালান, প্রতিটি আইটেম নির্দিষ্ট সময়কালের জন্য দৃশ্যমান রাখুন এবং আইটেমগুলির মধ্যে ১ সেকেন্ড অপেক্ষা করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
