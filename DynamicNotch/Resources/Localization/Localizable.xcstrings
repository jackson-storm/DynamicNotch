        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DynamicNotch потребує повного доступу до диска для читання локальної бази повідомлень Apple Mail і відображення сповіщень про нові листи."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DynamicNotch cần quyền Truy cập toàn bộ đĩa để đọc cơ sở dữ liệu thư cục bộ của Apple Mail và hiển thị thông báo thư đến."
