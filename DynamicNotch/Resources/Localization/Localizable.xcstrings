    "settings.vpn.style.headerDesc" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر ما إذا كان نشاط VPN يبقى مضغوطاً أو يعرض تفاصيل النفق."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изберете дали VPN дейността да остане компактна или да показва подробности."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VPN অ্যাক্টিভিটি কমপ্যাক্ট থাকবে নাকি টানেলের বিবরণ দেখাবে তা চয়ন করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tria si l'activitat VPN es manté compacta o mostra detalls del túnel."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zvolte, zda aktivita VPN zůstane kompaktní, nebo zobrazí podrobnosti o tunelu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg, om VPN-aktiviteten forbliver kompakt eller viser tunneldetaljer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle, ob die VPN-Aktivität kompakt bleibt oder Tunneldetails anzeigt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιλέξτε αν η δραστηριότητα VPN θα παραμένει συμπαγής ή θα εμφανίζει λεπτομέρειες σήραγγας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose whether the VPN activity stays compact or shows tunnel details."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige si la actividad VPN se mantiene compacta o muestra detalles del túnel."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انتخاب کنید که فعالیت VPN فشرده بماند یا جزئیات تونل را نشان دهد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valitse, pysyykö VPN-toiminta kompaktina vai näyttääkö se tunnelin yksityiskohdat."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piliin kung mananatiling compact ang aktibidad ng VPN o magpapakita ng mga detalye ng tunnel."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez si l'activité VPN reste compacte ou affiche les détails du tunnel."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בחר אם פעילות ה-VPN תישאר קומפקטית או תציג פרטי מנהרה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चुनें कि VPN गतिविधि कॉम्पैक्ट रहे या टनल विवरण दिखाए।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
