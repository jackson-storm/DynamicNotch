    "settings.drop.dragAndDrop.desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show AirDrop and Tray targets when you drag files over the notch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar destinos AirDrop y Bandeja al arrastrar archivos sobre la muesca."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывать цели AirDrop и Лотка при перетаскивании файлов на вырез."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将文件拖到刘海上方时显示 AirDrop 和托盘目标。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosyaları çentiğin üzerine sürüklediğinizde AirDrop ve Tepsi hedeflerini göster."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "AirDrop- und Dateiablage-Ziele anzeigen, wenn Dateien über die Notch gezogen werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher les cibles AirDrop et Bac lorsque vous faites glisser des fichiers sur l'encoche."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar os destinos AirDrop e Bandeja ao arrastar ficheiros para o notch."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルをノッチにドラッグしたときにAirDropおよびトレイターゲットを表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일을 노치로 드래그할 때 AirDrop 및 트레이 대상을 표시합니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra le destinazioni AirDrop e Vassoio quando trascini file sul notch."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokaż cele AirDrop i Tacki po przeciągnięciu plików na notch."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiển thị các mục tiêu AirDrop và Khay khi kéo tệp vào notch."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tampilkan target AirDrop dan Baki saat menyeret file ke notch."
          }
        }
      }
    },
