          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vis en advarsel når Spareblussmodus er aktivert eller batteriet er kritisk lavt."
          }
        },
        "nl" : {
          "stringUnit" : {
