            "state": "translated",
            "value": "Точная настройка высоты выреза или Dynamic Island."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "微调刘海或 Dynamic Island 的高度。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çentiğin veya Dynamic Island'ın yüksekliğine ince ayar yapın."
