    "settings.notifications.appleMail.systemNotifications.desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لتجنب تكرار التنبيهات، أوقف تشغيل إشعارات تطبيق البريد في إعدادات النظام."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "За да избегнете дублиране, изключете известията за Поща в Системни настройки."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ডুপ্লিকেট সতর্কতা এড়াতে, সিস্টেম সেটিংসে মেলের জন্য ব্যানার বন্ধ করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per evitar avisos duplicats, desactiveu les notificacions del Correu als Paràmetres del sistema."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chcete-li se vyhnout duplicitním upozorněním, vypněte bannery pro Poštu v Nastavení systému."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For at undgå dobbelte notifikationer kan du slå bannere fra for Mail i Systemindstillinger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um doppelte Hinweise zu vermeiden, deaktivieren Sie Banner für Mail in den Systemeinstellungen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Για να αποφύγετε διπλές ειδοποιήσεις, απενεργοποιήστε τα banner για το Mail στις Ρυθμίσεις συστήματος."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To avoid duplicate alerts, turn off banners for Mail in System Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para evitar alertas duplicadas, desactiva las tiras de Mail en Ajustes del Sistema."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای جلوگیری از اعلان‌های تکراری، بنرهای برنامه Mail را در تنظیمات سیستم خاموش کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vältä päällekkäiset ilmoitukset poistamalla Mail-bannerit käytöstä Järjestelmäasetuksissa."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upang maiwasan ang dobleng alerto, i-off ang mga banner para sa Mail sa Mga Setting ng System."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour éviter les alertes en double, désactivez les bannières de Mail dans les Réglages Système."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כדי למנוע התראות כפולות, כבה באנרים עבור דואר בהגדרות המערכת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दोहरे अलर्ट से बचने के लिए, सिस्टम सेटिंग्स में मेल के लिए बैनर बंद करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kako biste izbjegli dvostruke obavijesti, isključite natpise za Mail u Postavkama sustava."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A kettős értesítések elkerülése érdekében kapcsolja ki a Mail szalaghirdetéseit a Rendszerbeállításokban."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untuk menghindari peringatan ganda, matikan banner untuk Mail di Pengaturan Sistem."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per evitare avvisi duplicati, disattiva i banner per Mail nelle Impostazioni di Sistema."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通知の重複を防ぐため、システム設定で「メール」のバナー通知をオフにしてください。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Қайталанатын ескертулерді болдырмау үшін Жүйелік параметрлерде Пошта баннерлерін өшіріңіз."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "중복 알림을 방지하려면 시스템 설정에서 Mail 배너를 끄세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untuk mengelakkan amaran pendua, matikan sepanduk untuk Mail dalam Tetapan Sistem."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For å unngå doble varsler kan du slå av bannere for Mail i Systeminnstillinger."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schakel stroken voor Mail uit in Systeeminstellingen om dubbele meldingen te voorkomen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby uniknąć duplikatów, wyłącz banery dla aplikacji Poczta w Ustawieniach systemowych."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para evitar avisos duplicados, desative os banners do Mail nas Definições do Sistema."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pentru a evita alertele duplicate, dezactivați bannerele pentru Mail în Configurări de sistem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы избежать дублирования, отключите баннеры для Почты в Системных настройках."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ak sa chcete vyhnúť duplicitným upozorneniam, vypnite bannery pre Mail v Nastaveniach systému."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Да бисте избегли дуплирање обавештења, искључите банере за Пошту у Системским подешавањима."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "För att undvika dubbla notiser, stäng av banderoller för Mail i Systeminställningar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เพื่อหลีกเลี่ยงการแจ้งเตือนซ้ำ ให้ปิดแบนเนอร์สำหรับเมลในการตั้งค่าระบบ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yinelenen uyarıları önlemek için Sistem Ayarları'nda Mail başlıklarını kapatın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щоб уникнути дублювання, вимкніть банери для Пошти в Системних параметрах."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Để tránh thông báo trùng lặp, hãy tắt biểu ngữ cho Mail trong Cài đặt hệ thống."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为避免重复提醒，请在系统设置中关闭“邮件”的横幅通知。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為避免重複提醒，請在系統設定中關閉「郵件」的橫幅通知。"
          }
        }
      }
    },
