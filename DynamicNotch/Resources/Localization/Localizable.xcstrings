    "settings.notch.gestures.hoverHaptic.desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تشغيل ردود اللمس عند تحريك المؤشر فوق الشق."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Възпроизвеждане на тактилна обратна връзка при посочване на ноча."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "নচের উপর মাউস ঘোরালে হ্যাপটিক প্রতিক্রিয়া বাজান।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reprodueix resposta hàptica en passar el cursor sobre el notch."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Generovat jemnou haptickou odezvu, když ukazatel vstoupí do zavřeného výřezu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afspil haptisk feedback, når markøren føres over notchen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sanftes haptisches Feedback erzeugen, wenn der Zeiger in die geschlossene Notch eintritt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αναπαραγωγή απτικής ανάδρασης κατά την αιώρηση πάνω από το notch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Produce a soft haptic tick when the cursor enters the collapsed notch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Producir un toque háptico suave cuando el cursor entra en la muesca contraída."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پخش بازخورد لمسی هنگام نگه داشتن نشانگر روی ناچ."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toista haptinen palaute, kun osoitin viedään notchin päälle."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magpatugtog ng haptic feedback kapag nag-hover sa ibabaw ng notch."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Produire un léger retour haptique lorsque le curseur entre dans l'encoche fermée."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הפעל משוב רטט בעת ריחוף מעל המגרעת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
