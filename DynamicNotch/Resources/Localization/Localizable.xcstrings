    "settings.lockScreen.customSound.lock.desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Played when your Mac locks."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se reproduce al bloquear el Mac."
          }
        },
