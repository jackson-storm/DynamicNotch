    "settings.screenRecording.autoDismiss.desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إغلاق إشعار لقطة الشاشة تلقائياً بعد فترة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Автоматично затваряне на известието за екранна снимка след закъснение."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "বিলম্বের পরে স্ক্রিনশট বিজ্ঞপ্তি স্বয়ংক্রিয়ভাবে বন্ধ করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tanca automàticament la notificació de captura de pantalla després d'un retard."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automaticky zavřít oznámení o snímku obrazovky po uplynutí časového limitu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luk automatisk skærmbillednotifikationen efter en forsinkelse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screenshot-Benachrichtigung nach einer Verzögerung automatisch schließen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτόματο κλείσιμο της ειδοποίησης στιγμιότυπου οθόνης μετά από καθυστέρηση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatically close the screenshot notification after a delay."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cerrar automáticamente la notificación de captura de pantalla tras un retraso."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بستن خودکار اعلان اسکرین‌شات پس از یک تأخیر."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sulje kuvakaappausilmoitus automaattisesti viiveen jälkeen."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Awtomatikong isara ang abiso ng screenshot pagkatapos ng pagkaantala."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fermer automatiquement la notification de capture d'écran après un délai."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "סגור אוטומטית את התראת צילום המסך לאחר השהיה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "देरी के बाद स्क्रीनशॉट सूचना को स्वचालित रूप से बंद करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatski zatvori obavijest o snimci zaslona nakon odgode."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A képernyőkép-értesítés automatikus bezárása késleltetés után."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutup notifikasi tangkapan layar secara otomatis setelah beberapa saat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiudi automaticamente la notifica dello screenshot dopo un intervallo di tempo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一定時間後にスクリーンショット通知を自動的に閉じます。"
