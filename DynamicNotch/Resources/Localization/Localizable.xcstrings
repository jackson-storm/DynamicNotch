    "settings.lockScreen.activity.desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إظهار نشاط القفل المباشر عند قفل Mac."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показване на дейност на живо за заключен екран, когато вашият Mac е заключен."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac লক থাকলে লক স্ক্রিন লাইভ অ্যাক্টিভিটি দেখান।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra l'activitat en directe de la pantalla de bloqueig quan el Mac està bloquejat."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobrazit živou aktivitu zamčené obrazovky při uzamčení a odemčení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vis låseskærmens liveaktivitet, når Mac'en er låst."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sperrbildschirm-Live-Aktivität bei Sperr- und Entsperrübergängen anzeigen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εμφάνιση ζωντανής δραστηριότητας οθόνης κλειδώματος όταν το Mac κλειδώνει."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Show the lock-screen live activity during lock and unlock transitions."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrar la actividad en vivo al bloquear y desbloquear."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نمایش فعالیت زنده صفحه قفل هنگام قفل بودن مک."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näytä lukitusnäytön live-toiminta, kun Mac on lukittu."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magpakita ng live activity ng lock screen kapag naka-lock ang Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afficher l'activité en direct de l'écran verrouillé lors du verrouillage et du déverrouillage."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הצג פעילות מסך נעילה חיה כאשר ה-Mac נעול."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac लॉक होने पर लॉक स्क्रीन लाइव गतिविधि दिखाएं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prikaži aktivnost zaključanog zaslona uživo kada je Mac zaključan."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zárolási képernyő élő tevékenység megjelenítése a Mac zárolásakor."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tampilkan aktivitas langsung layar kunci saat mengunci dan membuka kunci."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra l'attività in tempo reale della schermata di blocco durante il blocco e lo sblocco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ロックおよびロック解除時にロック画面のライブアクティビティを表示します。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac құлыпталған кезде құлыптау экранының тікелей әрекетін көрсету."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "화면 잠금 및 잠금 해제 시 잠금 화면 실시간 활동을 표시합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tunjukkan aktiviti langsung skrin kunci apabila Mac dikunci."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vis låseskjermens direkteaktivitet når Mac-en er låst."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toon de live activiteit op het toegangsscherm tijdens vergrendelen en ontgrendelen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokaż aktywność na żywo ekranu blokady podczas blokowania i odblokowywania."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrar a atividade em tempo real do ecrã bloqueado ao bloquear e desbloquear."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afișați activitatea live a ecranului de blocare când Mac-ul este blocat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывать активность при блокировке и разблокировке экрана."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobraziť živú aktivitu zamknutej obrazovky, keď je Mac zamknutý."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прикажи активност закључаног екрана уживо када је Mac закључан."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visa låsskärmens liveaktivitet vid låsning och upplåsning."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แสดงกิจกรรมสดของหน้าจอล็อคเมื่อ Mac ถูกล็อค"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kilitleme ve kilit açma geçişlerinde kilit ekranı canlı etkinliğini göster."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показувати активність наживо на екрані блокування під час блокування та розблокування."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiển thị hoạt động trực tiếp của màn hình khóa khi khóa và mở khóa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在锁定和解锁转换期间显示锁屏实时活动。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在鎖定與解鎖時顯示鎖定畫面的即時活動。"
