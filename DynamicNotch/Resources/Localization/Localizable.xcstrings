        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ойық немесе Dynamic Island биіктігін дәл баптаңыз."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "노치 또는 Dynamic Island의 높이를 미세 조정합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perhalusi ketinggian notch atau Dynamic Island."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finjuster høyden på notchen eller Dynamic Island."
          }
        },
        "nl" : {
