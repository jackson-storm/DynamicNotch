    "settings.drop.trayUsage.desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose whether Tray keeps file copies or moves originals into Tray storage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige si la Bandeja guarda copias o mueve los originales al almacenamiento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите, копирует ли Лоток файлы или перемещает оригиналы в хранилище."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择托盘是保留文件副本还是将原始文件移到托盘存储。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tepsi'nin dosya kopyalarını mı saklayacağını yoksa orijinalleri Tepsi deposuna mı taşıyacağını seçin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle, ob die Dateiablage Dateikopien behält oder die Originale in den Ablagespeicher verschiebt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez si le bac conserve des copies des fichiers ou déplace les originaux dans le stockage du bac."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha se a bandeja guarda cópias dos ficheiros ou move os originais para o armazenamento da bandeja."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トレイがファイルのコピーを保持するか、元のファイルをトレイに移動するかを選択します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "트레이가 파일 복사본을 유지할지 원본 파일을 트레이 저장소로 이동할지 선택하세요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli se il vassoio conserva copie dei file o sposta gli originali nello spazio del vassoio."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz, czy tacka przechowuje kopie plików, czy przenosi oryginały do pamięci tacki."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn xem khay giữ bản sao của tệp hay di chuyển bản gốc vào bộ nhớ khay."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih apakah baki menyimpan salinan file atau memindahkan file asli ke penyimpanan baki."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies of de lade kopieën van bestanden bewaart of de originelen verplaatst naar de ladeopslag."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇托盤是保留檔案複本還是將原始檔移動至托盤儲存區。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть, чи зберігає лоток копії файлів, чи переміщує оригінали до сховища лотка."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj om brickan behåller kopior av filer eller flyttar originalen till brickans lagring."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvolte, zda přihrádka uchovává kopie souborů, nebo přesouvá originály do úložiště přihrádky."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose whether Tray keeps file copies or moves originals into Tray storage."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose whether Tray keeps file copies or moves originals into Tray storage."
          }
        }
      }
    },
