    "settings.general.blueNightMode.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تطبيق نظام ألوان أزرق داكن على واجهة الإعدادات."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прилагане на тъмносиня цветова схема към интерфейса с настройки."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সেটিংস ইন্টারফেসে গাঢ় নীল রঙের স্কিম প্রয়োগ করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplica una combinació de colors blau fosc a la interfície de configuració."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapněte teplejší tóny, abyste v noci snížili únavu očí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anvend et mørkeblåt farveskema på indstillingsgrænsefladen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warme Farbtöne für entspanntes Arbeiten am Abend aktivieren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εφαρμογή σκούρου μπλε συνδυασμού χρωμάτων στη διεπαφή ρυθμίσεων."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apply a dark blue color scheme to the settings interface."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplicar un esquema de color azul oscuro a la interfaz de configuración."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اعمال طرح رنگی آبی تیره به رابط کاربری تنظیمات."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käytä tummansinistä värimaailmaa asetusliittymässä."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maglapat ng madilim na asul na color scheme sa interface ng mga setting."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activer des tons plus chauds pour réduire la fatigue oculaire en soirée."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "החל ערכת צבעים כחולה כהה בממשק ההגדרות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सेटिंग्स इंटरफ़ेस पर डार्क ब्लू रंग योजना लागू करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Primijenite tamnoplavu shemu boja na sučelje postavki."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sötétkék színséma alkalmazása a beállítások felületére."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktifkan nada yang lebih hangat untuk mengurangi ketegangan mata di malam hari."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abilita toni più caldi per ridurre l'affaticamento degli occhi durante la notte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "夜間の目の疲れを軽減するために暖色系のトーンを有効にします。"
