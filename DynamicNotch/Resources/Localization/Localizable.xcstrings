    "settings.system.dockIcon.desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إبقاء التطبيق مرئياً في الـ Dock للتبديل السريع والوصول للنوافذ."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запазване на приложението видимо в Dock за по-бързо превключване."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "উইন্ডোগুলির মধ্যে দ্রুত স্যুইচ করার জন্য অ্যাপটিকে ডকে দৃশ্যমান রাখুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén l'aplicació visible al Dock per canviar i accedir a les finestres més ràpidament."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ponechat aplikaci viditelnou v Docku pro rychlý přístup k oknům."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold appen synlig i Dock for hurtigere skift og vinduesadgang."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App im Dock sichtbar lassen für schnelleres Wechseln und Fensterzugriff."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Διατηρήστε την εφαρμογή ορατή στο Dock για ταχύτερη εναλλαγή και πρόσβαση σε παράθυρα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep the app visible in the Dock for faster switching and window access."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantener la app visible en el Dock para un acceso más rápido."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نمایان نگه داشتن برنامه در داک برای جابجایی سریع‌تر بین پنجره‌ها."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pidä sovellus näkyvissä Dockissa nopeampaa vaihtamista ja ikkunoiden käyttöä varten."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Panatilihing nakikita ang app sa Dock para sa mas mabilis na paglipat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Garder l'application visible dans le Dock pour un accès rapide aux fenêtres."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "השאר את האפליקציה גלויה ב-Dock להחלפה מהירה וגישה לחלונות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तेज़ स्विचिंग और विंडो एक्सेस के लिए ऐप को डॉक में दृश्यमान रखें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zadržite aplikaciju vidljivom u Docku za brže prebacivanje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tartsa láthatóan az alkalmazást a Dockban a gyorsabb váltáshoz és ablakeléréshez."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biarkan aplikasi tetap terlihat di Dock untuk akses cepat ke jendela."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantieni l'app visibile nel Dock per un accesso rapido alle finestre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ウィンドウにすばやくアクセスできるようにDockにアプリを表示したままにします。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Терезелерді жылдам ауыстыру үшін қолданбаны Dock-та ұстау."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "창에 빠르게 접근할 수 있도록 Dock에 앱 아이콘을 유지합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kekalkan aplikasi kelihatan dalam Dock untuk penukaran dan akses tetingkap lebih pantas."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold appen synlig i Dock for raskere veksling og vindutilgang."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd de app zichtbaar in het Dock voor snelle toegang tot vensters."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zachowaj aplikację widoczną w Docku, aby mieć szybki dostęp do okien."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manter a aplicação visível no Dock para acesso rápido às janelas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Păstrează aplicația vizibilă în Dock pentru comutare și acces rapid la ferestre."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отображать приложение в Dock для быстрого переключения и доступа к окнам."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ponechať aplikáciu viditeľnú v Docku pre rýchlejšie prepínanie."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Задржите апликацију видљивом у Dock-у за брже пребацивање."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Håll appen synlig i Dock för snabb åtkomst till fönster."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แสดงแอปไว้ใน Dock เพื่อการสลับและการเข้าถึงหน้าต่างที่รวดเร็วขึ้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daha hızlı geçiş ve pencere erişimi için uygulamayı Dock'ta görünür tut."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зберігати значок програми в Dock для швидкого доступу до вікон."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giữ ứng dụng hiển thị trong Dock để truy cập nhanh vào các cửa sổ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 Dock 中显示应用以便快速切换和窗口访问。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 Dock 中保留應用程式以快速存取視窗。"
          }
        }
      }
