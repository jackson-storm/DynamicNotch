    "settings.focus.autoHide.desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إظهار نشاط التركيز لفترة وجيزة عند تفعيله بدلاً من إبقائه مرئياً طوال الوقت."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показване на действието за Фокус за кратко при включване, вместо да остава постоянно видимо."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সারাক্ষণ দৃশ্যমান না রেখে চালু করার সময় ফোকাস অ্যাক্টিভিটি সংক্ষিপ্তভাবে দেখান।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra l'activitat de Concentració breument quan s'activa en lloc de mantenir-la visible constantment."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobrazit aktivitu Soustředění krátce při aktivaci místo trvalého zobrazení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vis Fokus-aktiviteten kort, når den slås til, i stedet for at holde den synlig hele tiden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fokus-Aktivität beim Einschalten nur kurz einblenden, anstatt sie dauerhaft sichtbar zu halten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εμφάνιση της δραστηριότητας Συγκέντρωσης σύντομα κατά την ενεργοποίηση αντί να παραμένει ορατή συνεχώς."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Show the Focus activity briefly when Focus turns on instead of keeping it visible the whole time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrar brevemente la actividad de Enfoque al activarlo en lugar de mantenerla visible todo el tiempo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نمایش کوتاه فعالیت تمرکز هنگام روشن شدن به جای نمایش مداوم."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näytä Keskittymistoiminta lyhyesti käyttöönotettaessa sen sijaan, että se olisi aina näkyvissä."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ipakita ang aktibidad ng Focus nang panandalian kapag binuksan sa halip na panatilihing nakikita."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afficher brièvement l'activité Concentration lors de l'activation au lieu de la garder visible en permanence."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הצג את פעילות הפוקוס לזמן קצר בעת הפעלתה במקום להשאיר אותה גלויה כל הזמן."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फ़ोकस चालू होने पर पूरे समय दिखाने के बजाय संक्षेप में दिखाएं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prikažite aktivnost Fokusa kratko prilikom uključivanja umjesto stalne vidljivosti."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Fókusz tevékenység rövid megjelenítése bekapcsoláskor a folyamatos megjelenítés helyett."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tampilkan aktivitas Fokus secara singkat saat aktif daripada tetap terlihat sepanjang waktu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra brevemente l'attività di Full immersion all'attivazione invece di mantenerla sempre visibile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "集中モードを常に表示するのではなく、有効化時に短時間だけ表示します。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зейін қою әрекетін үнемі көрсетпей, қосылғанда қысқаша көрсету."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "항상 표시하지 않고 활성화 시 잠시 동안만 집중 모드 활동을 표시합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tunjukkan aktiviti Fokus secara ringkas apabila dihidupkan daripada kekal kelihatan sepanjang masa."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vis Fokus-aktiviteten kort når den slås på, i stedet for å holde den synlig hele tiden."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toon de Focus-activiteit kort bij activering in plaats van deze altijd zichtbaar te houden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokazuj krótko aktywność Skupienia po włączeniu, zamiast utrzymywać ją stale widoczną."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrar brevemente a atividade de Concentração ao ativar em vez de a manter sempre visível."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afișați activitatea Focalizare scurt când este activată, în loc să o păstrați vizibilă tot timpul."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывать активность Фокусирования кратко при включении вместо постоянного отображения."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobraziť aktivitu Môj čas krátko pri zapnutí namiesto trvalého zobrazenia."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прикажите активност Фокуса кратко приликом укључивања уместо сталне видљивости."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visa fokusaktiviteten kort vid aktivering istället för att hålla den synlig hela tiden."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แสดงกิจกรรมโฟกัสชั่วคราวเมื่อเปิดใช้งานแทนที่จะแสดงค้างไว้ตลอดเวลา"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odak etkinliğini sürekli göstermek yerine Odak açıldığında kısa süre göster."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коротко показувати активність Фокусування при увімкненні, замість постійного відображення."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiển thị ngắn gọn hoạt động Tập trung khi bật thay vì luôn hiển thị."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "专注模式开启时短暂显示活动，而非始终可见。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "啟用時短暫顯示專注模式活動，而不是保持一直可見。"
          }
        }
      }
    },
