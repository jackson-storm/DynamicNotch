    "settings.permissions.fullDiskAccess.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Full Disk Access to display real names and custom icons of Focus modes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите полный доступ к диску для отображения настоящих названий и значков режимов Фокусирования."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite el acceso total al disco para mostrar nombres reales e iconos personalizados del modo Enfoque."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许完全磁盘访问权限以显示专注模式的真实名称和自定义图标。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odak modlarının gerçek adlarını ve özel simgelerini göstermek için Tam Disk Erişimi'ne izin verin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Festplattenvollzugriff erlauben, um tatsächliche Namen und eigene Symbole von Fokusmodi anzuzeigen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autoriser l'Accès complet au disque pour afficher les noms réels et les icônes personnalisées des modes Concentration."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir Acesso Total ao Disco para apresentar nomes reais e ícones personalizados dos modos de Concentração."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "集中モードの実際の名前とカスタムアイコンを表示するためにフルディスクアクセスを許可します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "집중 모드의 실제 이름과 맞춤 아이콘을 표시하기 위해 전체 디스크 접근 권한을 허용합니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti Accesso completo al disco per mostrare i nomi reali e le icone personalizzate delle modalità di Full immersion."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zezwól na Pełny dostęp do dysku, aby wyświetlać rzeczywiste nazwy i niestandardowe ikony trybów Skupienia."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho phép Quyền truy cập đĩa đầy đủ để hiển thị tên thật và biểu tượng tùy chỉnh của các chế độ Tập trung."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izinkan Akses Disk Penuh untuk menampilkan nama asli dan ikon khusus dari mode Fokus."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verleen Volledige schijftoegang om echte namen en aangepaste symbolen van Focus-modi weer te geven."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許完全磁碟存取權限以顯示專注模式的真實名稱與自訂圖示。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Надайте повний доступ до диска для показу справжніх назв та власних значків режимів Фокусування."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ge full skivtillgång för att visa riktiga namn och anpassade ikoner för fokuslägen."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Povolte plný přístup k disku pro zobrazení skutečných názvů a vlastních ikon režimů Soustředění."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "السماح بالوصول الكامل للقرص لعرض الأسماء الحقيقية والأيقونات المخصصة لأوضاع التركيز."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोकस मोड के वास्तविक नाम और कस्टम आइकन प्रदर्शित करने के लिए पूर्ण डिस्क एक्सेस की अनुमति दें।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อนุญาตการเข้าถึงดิสก์เต็มรูปแบบเพื่อแสดงชื่อจริงและไอคอนที่กำหนดเองของโหมดโฟกัส"
          }
        }
      }
    },
