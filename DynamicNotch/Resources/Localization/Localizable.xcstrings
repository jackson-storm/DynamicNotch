          "stringUnit" : {
            "state" : "translated",
            "value" : "Надайте повний доступ до диска для показу сповіщень Mail і Повідомлень, а також справжніх назв і власних значків режимів Фокусування."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cho phép Quyền truy cập đĩa đầy đủ để hiển thị thông báo Mail và Tin nhắn, cũng như tên thật và biểu tượng tùy chỉnh của các chế độ Tập trung."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许完全磁盘访问权限，以显示“邮件”和“信息”通知，以及专注模式的真实名称和自定义图标。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允許完全磁碟存取權限，以顯示「郵件」和「訊息」通知，以及專注模式的真實名稱和自訂圖示。"
          }
        }
      }
    },
