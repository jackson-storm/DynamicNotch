    "settings.homePage.pages.reorderHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسحب لإعادة ترتيب الصفحات. الصفحات المعطّلة ستكون مخفية."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Плъзнете, за да пренаредите страниците. Деактивираните страници ще останат скрити."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "পৃষ্ঠাগুলি পুনরায় সাজানোর জন্য টেনে আনুন। অক্ষম করা পৃষ্ঠাগুলি লুকানো থাকবে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrossega per reordenar les pàgines. Les pàgines desactivades romandran amagades."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přetažením změňte pořadí stránek. Vypnuté stránky budou skryty."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Træk for at omarrangere sider. Deaktiverede sider skjules."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
