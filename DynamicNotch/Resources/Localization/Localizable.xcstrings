    "settings.hud.volume.desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replace the system volume overlay with a custom HUD in the notch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reemplazar la superposición de volumen del sistema con un HUD personalizado en la muesca."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заменить системное наложение громкости пользовательским HUD в вырезе."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用刘海中的自定义 HUD 替换系统音量叠加层。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem ses düzeyi göstergesini çentikteki özel HUD ile değiştir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "System-Lautstärkeanzeige durch die Notch ersetzen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplacer l'affichage système du volume par un HUD personnalisé dans l'encoche."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Substituir a apresentação de volume do sistema por um HUD personalizado no notch."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム標準の音量オーバーレイをカスタムノッチHUDに置き換えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 음량 표시를 노치 맞춤 HUD로 대체합니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sostituisci la visualizzazione del volume di sistema con un HUD personalizzato nel notch."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zastąp systemowy wskaźnik głośności niestandardowym HUD-em w notchu."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thay thế hiển thị âm lượng hệ thống bằng HUD tùy chỉnh trong notch."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ganti tampilan volume sistem dengan HUD khusus di notch."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vervang de volumeweergave van het systeem door een aangepaste HUD in de notch."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將系統音量顯示替換為「瀏海」自訂 HUD。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Замінити системний індикатор гучності на спеціальний HUD у вирізі notch."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ersätt systemets volymvisning med en anpassad HUD i flärpen."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nahradit systémový indikátor hlasitosti vlastním HUDem ve výřezu."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استبدال تراكب مستوى صوت النظام بعرض مخصص في الشق."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिस्टम वॉल्यूम ओवरले को नॉच में कस्टम HUD से बदलें।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แทนที่โอเวอร์เลย์ระดับเสียงของระบบด้วย HUD ในรอยบาก"
          }
        }
      }
    },
