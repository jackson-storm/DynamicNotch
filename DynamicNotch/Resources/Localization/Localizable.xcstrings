    "settings.nowPlaying.artwork3D.desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Animate artwork with a 3D flip when the track cover changes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Animar la carátula con un giro 3D al cambiar la portada de la pista."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Анимировать обложку 3D-переворотом при смене трека."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "曲目封面更改时以 3D 翻转动画显示封面。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parça kapağı değiştiğinde kapak görselini 3B çevirme ile canlandır."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "3D-Drehanimation für das Albumcover bei Titelwechsel aktivieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Animer la pochette avec un effet 3D lors du changement de piste."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Animar a capa com um efeito 3D ao mudar de faixa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トラック変更時にアートワークを3Dエフェクトでアニメーション表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "트랙 변경 시 3D 효과로 앨범 아트를 애니메이션화합니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Anima la copertina con un effetto 3D quando cambi traccia."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Animuj okładkę z efektem 3D podczas zmiany utworu."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Làm sinh động ảnh bìa với hiệu ứng 3D khi chuyển bài hát."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Animasikan sampul album dengan efek 3D saat berganti trek."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Animeer de albumhoes met een 3D-effect bij het wisselen van nummer."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "切換曲目時以 3D 效果為專輯插圖增添動畫。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Анімувати обкладинку альбому з 3D-ефектом при зміні треку."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Animera omslaget med en 3D-effekt vid spårbyte."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Animovat přebal alba s 3D efektem při změně skladby."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحريك الغلاف بتأثير ثلاثي الأبعاد عند تغيير غلاف المسار."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ट्रैक कवर बदलने पर 3D फ्लिप प्रभाव के साथ कलाकृति को एनिमेट करें।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สร้างภาพเคลื่อนไหว 3D พลิกเมื่อภาพหน้าปกเปลี่ยน"
          }
        }
      }
    },
