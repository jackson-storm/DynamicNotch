    "settings.reset.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This will restore default values only for the current tab. This action cannot be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto restaurará los valores predeterminados solo para la pestaña actual. Esta acción no se puede deshacer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это восстановит значения по умолчанию только для текущей вкладки. Это действие нельзя отменить."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将仅恢复当前选项卡的默认值。此操作无法撤消。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu işlem yalnızca geçerli sekmedeki değerleri varsayılana döndürür. Bu işlem geri alınamaz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden die Standardwerte nur für die aktuelle Registerkarte wiederhergestellt. Diese Aktion kann nicht rückgängig gemacht werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action rétablira les valeurs par défaut uniquement pour l'onglet actif. Cette opération est irréversible."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta ação irá repor os valores predefinidos apenas para o separador ativo. Esta operação é irreversível."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この操作により、現在のアクティブなタブの設定のみがデフォルト値に戻ります。この操作は元に戻せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 작업을 수행하면 현재 활성 탭의 설정만 기본값으로 복원됩니다. 이 작업은 취소할 수 없습니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa azione ripristinerà i valori predefiniti solo per la scheda attiva. Questa operazione non può essere annullata."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta czynność przywróci wartości domyślne tylko dla aktywnej karty. Tej operacji nie można cofnąć."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thao tác này sẽ khôi phục các giá trị mặc định chỉ cho tab hiện đang hoạt động. Thao tác này không thể hoàn tác."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tindakan ini akan mengembalikan nilai default hanya untuk tab yang aktif saat ini. Tindakan ini tidak dapat diurungkan."
          }
        }
      }
    },
