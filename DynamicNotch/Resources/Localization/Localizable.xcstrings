    "settings.bluetooth.duration2.desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose how long the Bluetooth connection notification stays visible."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige cuánto tiempo permanece visible la notificación de conexión Bluetooth."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите, как долго отображается уведомление о подключении Bluetooth."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择蓝牙连接通知的显示时长。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth bağlantı bildiriminin ne kadar süre görünür kalacağını seçin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle, wie lange die Bluetooth-Verbindungsbenachrichtigung sichtbar bleibt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez combien de temps la notification de connexion Bluetooth reste visible."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha quanto tempo a notificação de ligação Bluetooth permanece visível."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth接続通知を表示し続ける時間を選択します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth 연결 알림이 표시되는 지속 시간을 선택하세요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli per quanto tempo la notifica di connessione Bluetooth rimane visibile."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz, jak długo powiadomienie o połączeniu Bluetooth pozostaje widoczne."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn thời gian thông báo kết nối Bluetooth hiển thị."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih berapa lama notifikasi koneksi Bluetooth tetap terlihat."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies hoe lang de Bluetooth-verbindingsmelding zichtbaar blijft."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇藍牙連線通知保持可見的時間。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть, як довго сповіщення про підключення Bluetooth залишатиметься видимим."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj hur länge aviseringen om Bluetooth-anslutning ska vara synlig."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvolte, jak dlouho zůstane oznámení o připojení Bluetooth viditelné."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر مدة بقاء إشعار اتصال البلوتوث مرئياً."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चुनें कि ब्लूटूथ कनेक्शन सूचना कितने समय तक दिखाई देगी।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกระยะเวลาที่การแจ้งเตือนการเชื่อมต่อบลูทูธจะแสดงอยู่"
          }
        }
      }
    },
    "settings.bluetooth.style.headerDesc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose between a device-focused layout or full device details."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige entre un diseño centrado en el dispositivo o detalles completos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите между компактным отображением устройства или полной детализацией."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在以设备为中心的布局或完整设备详情之间选择。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aygıt odaklı bir düzen ile tüm aygıt ayrıntıları arasında seçim yapın."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle zwischen einem geräteorientierten Layout oder vollständigen Gerätedetails."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez entre une disposition épurée ou les détails complets de l'appareil."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha entre uma apresentação simples ou detalhes completos do dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シンプルなレイアウトか詳細なデバイス情報かを選択します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "깔끔한 레이아웃 또는 기기 세부 정보 표시 중 선택하세요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli tra un layout semplice o i dettagli completi del dispositivo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz między przejrzystym układem a pełnymi szczegółami urządzenia."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn giữa bố cục gọn gàng hoặc chi tiết thiết bị đầy đủ."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih antara tata letak bersih atau detail perangkat lengkap."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies tussen een eenvoudige indeling of volledige apparaatdetails."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在簡潔版面配置或完整裝置詳細資訊之間選擇。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть між лаконічним макетом або повними даними пристрою."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj mellan en ren layout eller fullständiga enhetsdetaljer."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte si mezi čistým rozvržením nebo úplnými podrobnostmi o zařízení."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر بين تخطيط يركز على الجهاز أو تفاصيل الجهاز الكاملة."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डिवाइस-केंद्रित लेआउट या पूर्ण डिवाइस विवरण के बीच चुनें।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกระหว่างเลย์เอาต์ที่เน้นอุปกรณ์หรือรายละเอียดอุปกรณ์ทั้งหมด"
          }
        }
      }
    },
