    "settings.hud.indicatorGlow.desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable subtle glow effect around HUD progress indicator."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Habilitar efecto de brillo sutil en el indicador de HUD."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включить эффекты свечения вокруг полосы прогресса HUD."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 HUD 进度指示器周围开启发光效果。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "HUD ilerleme göstergesinin çevresinde hafif ışıma efektini etkinleştir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dezenten Leuchteffekt um den HUD-Fortschrittsbalken aktivieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activer un léger effet de lueur autour de la barre de progression du HUD."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativar um efeito subtil de brilho à volta da barra de progresso do HUD."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "HUDプログレスバーの周囲に微細なグロー効果を有効にします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "HUD 진행률 바 주변에 은은한 글로우 효과를 활성화합니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abilita un leggero effetto bagliore attorno alla barra di avanzamento dell'HUD."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włącz subtelny efekt poświaty wokół paska postępu HUD."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật hiệu ứng phát sáng nhẹ xung quanh thanh tiến trình HUD."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktifkan efek cahaya halus di sekitar bilah kemajuan HUD."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakel een zacht gloeieffect in rond de HUD-voortgangsbalk."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 HUD 進度列周圍啟用微光效果。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увімкніть м'яке світіння навколо смуги прогресу HUD."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivera en mjuk glödeffekt runt HUD-förloppsindikatorn."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapněte jemný efekt záře kolem indikátoru průběhu HUD."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تفعيل تأثير توهج خفيف حول مؤشر تقدم العرض."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "HUD प्रगति संकेतक के चारों ओर सूक्ष्म चमक प्रभाव सक्षम करें।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดใช้เอฟเฟกต์เรืองแสงรอบตัวระบุความคืบหน้า HUD"
          }
        }
      }
    },
