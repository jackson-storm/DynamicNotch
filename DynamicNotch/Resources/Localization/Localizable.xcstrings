    "settings.general.display.specificPicker.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pin Dynamic Notch to one display instead of following the system main display."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fija Dynamic Notch en una sola pantalla en lugar de seguir la pantalla principal del sistema."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закрепить Dynamic Notch за одним дисплеем вместо следования за системным основным дисплеем."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
