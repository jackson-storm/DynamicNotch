    "Apply a full battery sample and show the completion notification." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تطبيق عينة بطارية ممتلئة وإظهار إشعار الاكتمال."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приложете примерен пълен заряд на батерията и покажете известие за завършване."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সম্পূর্ণ ব্যাটারির নমুনা প্রয়োগ করুন এবং সমাপ্তির বিজ্ঞপ্তি দেখান।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplica una mostra de bateria plena i mostra la notificació de finalització."
