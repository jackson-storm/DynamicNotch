    "settings.wifi.duration.desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose how long the Wi-Fi reconnect notification stays visible."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige cuánto tiempo permanece visible la notificación de reconexión Wi-Fi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите, как долго отображается уведомление о переподключении Wi-Fi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择 Wi-Fi 重连通知的显示时长。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi yeniden bağlanma bildiriminin ne kadar süre görünür kalacağını seçin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle, wie lange die WLAN-Wiederverbindungsbenachrichtigung sichtbar bleibt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez combien de temps la notification de reconnexion Wi-Fi reste visible."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha quanto tempo a notificação de religação ao Wi-Fi permanece visível."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi再接続通知を表示し続ける時間を選択します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi 재연결 알림이 표시되는 지속 시간을 선택하세요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli per quanto tempo la notifica di riconnessione Wi-Fi rimane visibile."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz, jak długo powiadomienie o ponownym połączeniu Wi-Fi pozostaje widoczne."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn thời gian thông báo kết nối lại Wi-Fi hiển thị."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih berapa lama notifikasi sambungan ulang Wi-Fi tetap terlihat."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies hoe lang de wifi-herverbindingsmelding zichtbaar blijft."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇重新連接 Wi-Fi 通知保持可見的時間。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть, як довго сповіщення про повторне підключення до Wi-Fi залишатиметься видимим."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj hur länge aviseringen om återanslutning till Wi-Fi ska vara synlig."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvolte, jak dlouho zůstane oznámení o opětovném připojení k Wi-Fi viditelné."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر مدة بقاء إشعار إعادة اتصال Wi-Fi مرئياً."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चुनें कि Wi-Fi पुन: कनेक्ट सूचना कितने समय तक दिखाई देगी।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกระยะเวลาที่การแจ้งเตือนเชื่อมต่อ Wi-Fi ใหม่จะแสดงอยู่"
          }
        }
      }
    },
