    "settings.reset.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيؤدي هذا لاستعادة القيم الافتراضية للتبويب الحالي فقط. لا يمكن التراجع عن هذا الإجراء."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Това ще възстанови стойностите по подразбиране само за текущия раздел. Това действие не може да бъде отменено."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এটি কেবল বর্তমান ট্যাবের জন্য ডিফল্ট মান পুনরুদ্ধার করবে। এই ক্রিয়াটি পূর্বাবস্থায় ফেরানো যাবে না।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Això restaurarà els valors per defecte només per a la pestanya actual. Aquesta acció no es pot desfer."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tato akce obnoví výchozí hodnoty pouze pro aktuálně aktivní kartu. Tuto akci nelze vrátit zpět."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette gendanner kun standardværdierne for den aktuelle fane. Denne handling kan ikke fortrydes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch werden die Standardwerte nur für die aktuelle Registerkarte wiederhergestellt. Diese Aktion kann nicht rückgängig gemacht werden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτό θα επαναφέρει τις προεπιλεγμένες τιμές μόνο για την τρέχουσα καρτέλα. Αυτή η ενέργεια δεν μπορεί να αναιρεθεί."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This will restore default values only for the current tab. This action cannot be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto restaurará los valores predeterminados solo para la pestaña actual. Esta acción no se puede deshacer."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "این کار مقادیر پیش‌فرض را فقط برای برگه فعلی بازیابی می‌کند. این عمل قابل بازگشت نیست."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä palauttaa oletusarvot vain nykyiselle välilehdelle. Tätä toimintoa ei voi kumota."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ibabalik nito ang mga default na halaga para lamang sa kasalukuyang tab. Hindi na maaaring bawiin ang aksyong ito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette action rétablira les valeurs par défaut uniquement pour l'onglet actif. Cette opération est irréversible."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "פעולה זו תשחזר את ערכי ברירת המחדל רק עבור הכרטיסייה הנוכחית. לא ניתן לבטל פעולה זו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह केवल वर्तमान टैब के लिए डिफ़ॉल्ट मान पुनर्स्थापित करेगा। इस क्रिया को पूर्ववत नहीं किया जा सकता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovo će vratiti zadane vrijednosti samo za trenutnu karticu. Ova se radnja ne može poništiti."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez csak az aktuális lap alapértelmezett értékeit állítja vissza. Ez a művelet nem vonható vissza."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tindakan ini akan mengembalikan nilai default hanya untuk tab yang aktif saat ini. Tindakan ini tidak dapat diurungkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
