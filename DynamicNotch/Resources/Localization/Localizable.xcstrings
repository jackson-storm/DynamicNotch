    "settings.notch.gestures.pressHoldTiming.desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ضبط سرعة تفعيل الضغط المطوّل وتوسيع التحويم."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Регулирайте колко бързо се задействат натискането със задържане и посочването."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "চাপুন এবং ধরে রাখুন এবং হোভার প্রসারণের গতি সামঞ্জস্য করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajusta la rapidesa amb què s'activa el mantenir premut i l'expansió en passar el cursor."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upravte odezvu stisknutí a podržení a najetí myší."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Juster, hvor hurtigt tryk-og-hold og markøroverførselsudvidelse udløses."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auslöseverzögerung für Gedrückthalten und Überfahren anpassen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ρυθμίστε πόσο γρήγορα ενεργοποιούνται το παρατεταμένο πάτημα και η επέκταση αιώρησης."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adjust how quickly press-and-hold and hover expansion trigger."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajustar la rapidez con la que se activa la expansión por pulsación prolongada y al pasar el cursor."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تنظیم سرعت راه‌اندازی فشردن و نگه‌داشتن و گسترش با نشانگر."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Säädä kuinka nopeasti painallus ja pito sekä osoituslaajennus laukeavat."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayusin ang bilis ng pag-trigger ng press at hold at pagpapalawak sa pag-hover."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajuster la réactivité de l'appui prolongé et du survol."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כוונן את מהירות ההפעלה של לחיצה ממושכת והרחבת ריחוף."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "समायोजित करें कि प्रेस-एंड-होल्ड और होवर विस्तार कितनी जल्दी ट्रिगर होते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prilagodite brzinu pokretanja pritiska i držanja te proširenja prelaskom."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Állítsa be a nyomva tartás és a rámutatásos kibontás gyorsaságát."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesuaikan responsivitas tekan tahan dan arahkan kursor."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regola la reattività della pressione prolungata e del passaggio del mouse."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "長押しおよびホバーの反応タイミングを調整します。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Басып тұру және меңзерді апару арқылы кеңейту уақытын реттеңіз."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "길게 누르기 및 마우스 올리기 반응 속도를 조정합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laras kepantasan pencetus tekan-dan-tahan dan pengembangan tudingan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Juster hvor raskt trykk-og-hold og pekeroverføringsutvidelse utløses."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas de reactietijd voor ingedrukt houden en aanwijzen aan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dostosuj szybkość reakcji na naciśnięcie i przytrzymanie oraz najechanie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajustar a sensibilidade do gesto de premir sem soltar e passagem do cursor."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajustați cât de rapid se declanșează apăsarea lungă și extinderea la survolare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Настроить, как быстро срабатывает развёртывание при удержании и наведении."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upraviť rýchlosť spustenia stlačenia a podržania a rozbalenia prejdením."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прилагодите брзину покретања притиска и задржавања и проширења преласком."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Justera responsen för tryck och håll samt hovring."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ปรับความเร็วของการกดค้างและการขยายเมื่อชี้เมาส์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basılı tutma ve üzerine gelme ile genişletmenin ne kadar hızlı tetikleneceğini ayarlayın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Налаштуйте чутливість натискання з утриманням та наведення."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Điều chỉnh độ nhạy của thao tác nhấn giữ và di chuột."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "调整长按和悬停展开的触发速度。"
