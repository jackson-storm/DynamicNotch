    "Turn off every persistent preview and close any temporary content.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle dauerhaften Vorschauen ausschalten und temporäre Inhalte schließen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactiver tous les aperçus persistants et fermer tout contenu temporaire."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativar todas as pré-visualizações persistentes e fechar qualquer conteúdo temporário."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての永続プレビューをオフにし、一時コンテンツを閉じます。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn off every persistent preview and close any temporary content."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отключить все постоянные предпросмотры и закрыть любое временное содержимое."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivar todas las vistas previas persistentes y cerrar cualquier contenido temporal."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭所有持续预览并关闭任何临时内容。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her kalıcı önizlemeyi kapatın ve geçici içerikleri kapatın."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 지속적 미리보기를 끄고 모든 임시 콘텐츠를 닫습니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattiva ogni anteprima persistente e chiudi qualsiasi contenuto temporaneo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyłącz wszystkie stałe podglądy i zamknij wszelkie tymczasowe treści."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tắt tất cả bản xem trước liên tục và đóng mọi nội dung tạm thời."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Matikan setiap pratinjau persisten dan tutup konten sementara apa pun."
          }
        }
      }
    },
