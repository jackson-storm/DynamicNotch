          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velg om Bluetooth-batteriinformasjon vises som en prosentandel eller sirkel."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toon het batterijniveau van verbonden Bluetooth-apparaten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokaż poziom baterii podłączonych urządzeń Bluetooth."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrar o nível de bateria dos dispositivos Bluetooth ligados."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
