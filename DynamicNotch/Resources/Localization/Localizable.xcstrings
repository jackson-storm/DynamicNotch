    "settings.hud.brightness.desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استبدال تراكب سطوع النظام بعرض مخصص في الشق."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заменете системното наслагване за яркост с персонализиран HUD в ноча."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সিস্টেম উজ্জ্বলতা ওভারলেটিকে নচে একটি কাস্টম HUD দিয়ে প্রতিস্থাপন করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Substitueix la superposició de brillantor del sistema per un HUD personalitzat al notch."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobrazit nastavení jasu ve výřezu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erstat systemets lysstyrkeoverlay med en tilpasset HUD i notchen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Helligkeitsänderungen in der Notch anzeigen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αντικατάσταση της επικάλυψης φωτεινότητας συστήματος με προσαρμοσμένο HUD στο notch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Replace the system brightness overlay with a custom HUD in the notch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reemplazar la superposición de brillo del sistema con un HUD personalizado en la muesca."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جایگزینی اعلان روشنایی سیستم با HUD سفارشی در ناچ."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Korvaa järjestelmän kirkkauspeitto mukautetulla HUDilla notchissa."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palitan ang overlay ng liwanag ng system ng custom na HUD sa notch."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afficher les réglages de luminosité dans l'encoche."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "החלף את שכבת הבהירות של המערכת ב-HUD מותאם אישית במגרעת."
          }
        },
        "hi" : {
          "stringUnit" : {
