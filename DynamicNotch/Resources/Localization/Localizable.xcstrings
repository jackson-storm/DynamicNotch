    "settings.notch.display.hideInFullScreen.desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically hide live activity while the selected display is showing a full-screen space."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocultar automáticamente la actividad en vivo cuando la pantalla seleccionada muestre un espacio a pantalla completa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматически скрывать живую активность, когда выбранный дисплей показывает полноэкранное пространство."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当选定的显示器显示全屏空间时自动隐藏实时活动。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçilen ekranda tam ekran bir alan gösterilirken canlı etkinliği otomatik olarak gizle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Live-Aktivität automatisch ausblenden, während auf dem Display ein Vollbildmodus aktiv ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masquer automatiquement l'activité en direct lorsque l'écran sélectionné affiche un espace en plein écran."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocultar automaticamente a atividade em tempo real quando o ecrã selecionado estiver em modo de ecrã inteiro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したディスプレイに全画面スペースが表示されている場合、ライブアクティビティを自動的に非表示にします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 디스플레이가 전체 화면 공간을 표시할 때 실시간 활동을 자동으로 숨깁니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nascondi automaticamente l'attività in tempo reale quando lo schermo selezionato visualizza uno spazio a schermo intero."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatycznie ukrywaj aktywność na żywo, gdy wybrany ekran wyświetla przestrzeń pełnoekranową."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tự động ẩn hoạt động trực tiếp khi màn hình đã chọn hiển thị không gian toàn màn hình."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sembunyikan aktivitas langsung secara otomatis saat layar yang dipilih menampilkan ruang layar penuh."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verberg live activiteiten automatisch wanneer het geselecteerde scherm een schermvullende ruimte weergeeft."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當所選顯示器顯示全螢幕空間時自動隱藏即時活動。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматично приховувати активність наживо, коли вибраний екран перебуває в повноекранному режимі."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dölj liveaktiviteter automatiskt när den valda skärmen visar ett helskärmsutrymme."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Automaticky skrýt živou aktivitu, když vybraný monitor zobrazuje celoobrazovkový prostor."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically hide live activity while the selected display is showing a full-screen space."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically hide live activity while the selected display is showing a full-screen space."
          }
        }
      }
    },
