    "settings.vpn.temporaryActivity2.desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show a short notification when a VPN connection becomes active."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar una notificación breve cuando una conexión VPN se activa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показать короткое уведомление при активации VPN-подключения."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN 连接激活时显示短暂通知。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir VPN bağlantısı etkin hale geldiğinde kısa bir bildirim göster."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurze Benachrichtigung anzeigen, wenn eine VPN-Verbindung aktiv wird."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher une courte notification lorsqu'une connexion VPN devient active."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar uma notificação curta quando uma ligação VPN ficar ativa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN接続がアクティブになったときに短い通知を表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN 연결이 활성화될 때 짧은 알림을 표시합니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra una breve notifica quando una connessione VPN diventa attiva."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokaż krótkie powiadomienie, gdy połączenie VPN stanie się aktywne."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiển thị thông báo ngắn khi kết nối VPN hoạt động."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tampilkan notifikasi singkat saat koneksi VPN menjadi aktif."
          }
        }
      }
    },
    "settings.wifi.appearance.headerDesc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose whether the hotspot activity stays minimal or shows more status."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige si la actividad del punto de acceso se mantiene mínima o muestra más estado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите, остаётся ли активность точки доступа минимальной или показывает больше информации."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择热点活动是保持简约还是显示更多状态。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Erişim noktası etkinliğinin minimal mi kalacağını yoksa daha fazla durum mu göstereceğini seçin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle, ob die Hotspot-Aktivität minimal bleibt oder mehr Status anzeigt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez si l'activité de partage de connexion reste minimale ou affiche plus de détails."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha se a atividade de partilha de internet permanece mínima ou apresenta mais detalhes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インターネット共有のアクティビティを最小限にするか、詳細を表示するかを選択します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개인용 핫스팟 활동을 미니멀하게 유지할지 더 많은 세부 정보를 표시할지 선택하세요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli se l'attività di hotspot rimane minimale o mostra maggiori dettagli."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz, czy aktywność hotspotu ma pozostać minimalna, czy pokazywać więcej szczegółów."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn xem hoạt động điểm phát sóng vẫn tối giản hay hiển thị thêm chi tiết."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih apakah aktivitas hotspot tetap minimal atau menampilkan lebih banyak detail."
          }
        }
      }
    },
