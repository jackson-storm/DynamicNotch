    "Apply a full battery sample and show the completion notification.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Muster für vollen Akku anwenden und Abschlussbenachrichtigung anzeigen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appliquer un échantillon de batterie pleine et afficher la notification de fin."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicar uma amostra de bateria cheia e mostrar a notificação de conclusão."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フル充電のサンプルを適用し、完了通知を表示します。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apply a full battery sample and show the completion notification."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Применить образец полного заряда батареи и показать уведомление о завершении."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicar una muestra de batería llena y mostrar la notificación de finalización."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用完全充满电的示例并显示完成通知。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tam pil örneğini uygulayın ve tamamlanma bildirimini gösterin."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완충 샘플을 적용하고 완료 알림을 표시합니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Applica un campione di batteria carica e mostra la notifica di completamento."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zastosuj próbkę pełnej baterii i pokaż powiadomienie o ukończeniu."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Áp dụng mẫu pin đầy và hiển thị thông báo hoàn tất."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terapkan sampel baterai penuh dan tampilkan notifikasi selesai."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas een volle batterij-sample toe en toon de voltooiingsmelding."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "套用充滿電範例並顯示完成通知。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Застосувати зразок повного заряду та показати сповіщення про завершення."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillämpa ett fullt batteri-exempel och visa slutförandeaviseringen."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Použít vzorek plné baterie a zobrazit oznámení o dokončení."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تطبيق عينة بطارية ممتلئة وإظهار إشعار الاكتمال."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पूर्ण बैटरी नमूना लागू करें और पूर्णता सूचना दिखाएं।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้ตัวอย่างแบตเตอรี่เต็มและแสดงการแจ้งเตือนเสร็จสิ้น"
          }
        }
      }
    },
    "Apply a low battery sample and show the low-power alert.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Muster für niedrigen Akkustand anwenden und Energiesparwarnung anzeigen."
