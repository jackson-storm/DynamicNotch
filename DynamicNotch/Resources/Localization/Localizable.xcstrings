    "settings.nowPlaying.progressBarTint.desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose how to color the progress bar and timer labels."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige cómo colorear la barra de progreso y las etiquetas del temporizador."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите, как окрашивать полосу прогресса и метки таймера."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择进度条和计时器标签的着色方式。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlerleme çubuğunun ve süre etiketlerinin nasıl renklendirileceğini seçin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Farbe für Fortschrittsbalken und Zeitanzeige festlegen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisir la couleur de la barre de progression et des durées."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolher a cor da barra de progresso e das durações."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プログレスバーと時間のカラーを選択します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "진행률 바 및 재생 시간 색상을 선택하세요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli il colore della barra di avanzamento e dei tempi."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz kolor paska postępu i czasów trwania."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn màu của thanh tiến trình và thời lượng."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih warna bilah kemajuan dan durasi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies de kleur van de voortgangsbalk en tijden."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇進度列與時間的顏色。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть колір смуги прогресу та тривалості."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj färg på förloppsindikatorn och tidsangivelserna."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvolte barvu indikátoru průběhu a časových údajů."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر كيفية تلوين شريط التقدم وعبارات المؤقت."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रगति बार और टाइमर लेबल को रंगने का तरीका चुनें।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกวิธีการใส่สีแถบความคืบหน้าและตัวเลขตัวจับเวลา"
          }
        }
      }
    },
