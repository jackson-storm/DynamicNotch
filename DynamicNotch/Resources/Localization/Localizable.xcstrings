    "settings.lockScreen.widgetBrightness.desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adjust brightness for widgets on the lock screen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustar el brillo de los widgets en la pantalla de bloqueo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настроить яркость виджетов на экране блокировки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调整锁屏上小组件的亮度。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kilit ekranındaki widget'ların parlaklığını ayarlayın."
          }
