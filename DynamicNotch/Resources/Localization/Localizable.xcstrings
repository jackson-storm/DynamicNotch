    "settings.nowPlaying.liveActivity.desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show the Now Playing live activity while audio or video playback is active."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar la actividad en vivo de Reproducción durante la reproducción de audio o vídeo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывать живую активность Сейчас играет при воспроизведении аудио или видео."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "音频或视频播放时显示正在播放实时活动。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses veya video oynatılırken Çalınıyor canlı etkinliğini göster."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktuelle-Wiedergabe-Live-Aktivität bei laufender Audio- oder Videowiedergabe anzeigen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher l'activité en direct À l'écoute lors de la lecture d'audio ou de vidéo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar a atividade em tempo real A reproduzir ao reproduzir áudio ou vídeo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声または動画の再生中に「再生中」ライブアクティビティを表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오디오 또는 비디오를 재생할 때 지금 재생 중 실시간 활동을 표시합니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra l'attività in tempo reale In riproduzione durante la riproduzione di audio o video."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokaż aktywność na żywo Teraz odtwarzane podczas odtwarzania dźwięku lub wideo."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiển thị hoạt động trực tiếp Đang phát khi phát âm thanh hoặc video."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tampilkan aktivitas langsung Sedang Diputar saat memutar audio atau video."
          }
        }
      }
    },
