          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salli järjestelmätapahtumien hallinta esikatseluikkunoiden automaattiseen keskittämiseen."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
