    "settings.hud.brightness.desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replace the system brightness overlay with a custom HUD in the notch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reemplazar la superposición de brillo del sistema con un HUD personalizado en la muesca."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заменить системное наложение яркости пользовательским HUD в вырезе."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用刘海中的自定义 HUD 替换系统亮度叠加层。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem parlaklık göstergesini çentikteki özel HUD ile değiştir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Helligkeitsänderungen in der Notch anzeigen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher les réglages de luminosité dans l'encoche."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar os ajustes de brilho no notch."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノッチに輝度調整HUDを表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노치에 화면 밝기 조정 HUD를 표시합니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra le regolazioni della luminosità nel notch."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokaż regulację jasności w notchu."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiển thị điều chỉnh độ sáng trong notch."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tampilkan penyesuaian kecerahan di notch."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toon helderheidsaanpassingen in de notch."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在「瀏海」中顯示亮度調整。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показувати регулювання яскравості у вирізі notch."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visa ljusstyrkejusteringar i flärpen."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazit nastavení jasu ve výřezu."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استبدال تراكب سطوع النظام بعرض مخصص في الشق."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिस्टम चमक ओवरले को नॉच में कस्टम HUD से बदलें।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แทนที่โอเวอร์เลย์ความสว่างของระบบด้วย HUD แบบกำหนดเองในรอยบาก"
          }
        }
      }
    },
