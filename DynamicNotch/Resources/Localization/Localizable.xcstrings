    "settings.notch.gestures.collapseGesture.desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose whether expanded content closes on click or when the cursor leaves the notch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige si el contenido expandido se cierra al hacer clic o cuando el cursor abandona la muesca."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите, закрывается ли расширенный вид по клику или при уходе курсора с выреза."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择展开内容是通过点击还是光标离开刘海时关闭。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Genişletilmiş içeriğin tıklamayla mı yoksa imleç çentikten ayrıldığında mı kapanacağını seçin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle, ob geöffnete Inhalte per Klick oder beim Verlassen des Mauszeigers schließen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisir si le contenu agrandi se ferme d'un clic ou lorsque le curseur quitte l'encoche."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolher se o conteúdo expandido fecha com um clique ou quando o cursor sai do notch."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "展開したコンテンツをクリックで閉じるか、カーソルがノッチを離れたときに閉じるかを選択します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확장된 콘텐츠가 클릭으로 닫힐지 커서가 노치를 벗어날 때 닫힐지 선택하세요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli se il contenuto espanso si chiude con un clic o quando il cursore lascia il notch."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz, czy rozwinięta zawartość zamyka się po kliknięciu, czy po opuszczeniu notcha przez kursor."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn xem nội dung mở rộng đóng bằng một cú nhấp chuột hay khi con trỏ rời khỏi notch."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih apakah konten yang diperluas ditutup dengan klik atau saat kursor meninggalkan notch."
          }
        }
      }
    },
