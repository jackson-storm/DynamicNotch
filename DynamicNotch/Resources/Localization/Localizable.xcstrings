    "settings.homePage.pages.reorderHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag to reorder pages. Disabled pages will be hidden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra para reordenar las páginas. Las páginas desactivadas se ocultarán."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетащите для изменения порядка. Отключённые страницы будут скрыты."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动以重新排列页面。禁用的页面将被隐藏。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayfaları yeniden sıralamak için sürükleyin. Kapatılan sayfalar gizlenir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehen, um Seiten neu anzuordnen. Deaktivierte Seiten werden ausgeblendet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Glissez pour réorganiser les pages. Les pages désactivées seront masquées."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste para reorganizar as páginas. As páginas desativadas ficarão ocultas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドラッグしてページを並べ替えます。無効にしたページは非表示になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "드래그하여 페이지 순서를 변경하세요. 비활성화된 페이지는 숨겨집니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina per riordinare le pagine. Le pagine disabilitate saranno nascoste."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeciągaj, aby zmienić kolejność stron. Wyłączone strony zostaną ukryte."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kéo để sắp xếp lại các trang. Các trang bị tắt sẽ bị ẩn."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seret untuk mengatur ulang halaman. Halaman yang dinonaktifkan akan disembunyikan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep om pagina's opnieuw te ordenen. Uitgeschakelde pagina's worden verborgen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖移以重新排序頁面。已停用的頁面將會隱藏。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетягуйте для зміни порядку сторінок. Вимкнені сторінки будуть сховані."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dra för att ändra ordning på sidorna. Inaktiverade sidor döljs."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přetažením změňte pořadí stránek. Vypnuté stránky budou skryty."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحب لإعادة ترتيب الصفحات. الصفحات المعطّلة ستكون مخفية."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पेज पुनर्व्यवस्थित करने के लिए खींचें। अक्षम पेज छिपे रहेंगे।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลากเพื่อจัดลำดับหน้าใหม่ หน้าที่ปิดใช้งานจะถูกซ่อน"
          }
        }
      }
    },
