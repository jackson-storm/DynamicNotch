        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノッチまたはDynamic Islandの高さを細かく調整します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노치 또는 Dynamic Island의 높이를 미세 조정합니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Regola con precisione l'altezza del notch o della Dynamic Island."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Precyzyjnie dostosuj wysokość notcha lub Dynamic Island."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tinh chỉnh chiều cao của notch hoặc Dynamic Island."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesuaikan ketinggian notch atau Dynamic Island secara presisi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verfijn de hoogte van de notch of het Dynamic Island."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "微調「瀏海」或動態島的高度。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Точно відрегулюйте висоту вирізу notch або Dynamic Island."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Finjustera höjden på flärpen eller Dynamic Island."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jemně dolaďte výšku výřezu nebo Dynamic Island."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ضبط ارتفاع الشق أو الجزيرة الديناميكية بدقة."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नॉच या डायनामिक आइलैंड की ऊंचाई को सटीक रूप से समायोजित करें।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปรับแต่งความสูงของรอยบากหรือ Dynamic Island อย่างละเอียด"
          }
        }
      }
    },
