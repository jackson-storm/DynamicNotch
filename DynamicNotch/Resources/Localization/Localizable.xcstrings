    "Send the Now Playing playback-state changed event for pause.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktuelle-Wiedergabe-Ereignis für Pause senden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoyer l'événement d'état de lecture À l'écoute pour la pause."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviar o evento de estado de reprodução A reproduzir para pausa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再生中の一時停止の再生状態変更イベントを送信します。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send the Now Playing playback-state changed event for pause."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправить событие изменения состояния «Исполняется» для паузы."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviar el evento de cambio de estado de En reproducción para pausa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发送正在播放播放状态更改事件以暂停。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Duraklatma için Şu An Çalınan çalma durumu değişti olayını gönderin."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일시정지를 위해 지금 재생 중 재생 상태 변경 이벤트를 보냅니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Invia l'evento di cambio stato di riproduzione per la pausa."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyślij zdarzenie zmiany stanu odtwarzania Teraz odtwarzane dla pauzy."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gửi sự kiện thay đổi trạng thái phát Đang phát để tạm dừng."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirim peristiwa perubahan status pemutaran Sedang Diputar untuk jeda."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuur de afspeelstatus-gewijzigd-gebeurtenis van Huidige voor pauzeren."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為暫停傳送「播放中」播放狀態變更事件。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Надіслати подію зміни стану відтворення «Зараз грає» для паузи."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skicka händelsen för ändrat uppspelningsläge för 'Spelas nu' för paus."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odeslat událost změny stavu přehrávání 'Právě hraje' pro pozastavení."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إرسال حدث تغيير حالة التشغيل للإيقاف المؤقت."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रोकने के लिए प्लेबैक-स्थिति परिवर्तित ईवेंट भेजें।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ส่งเหตุการณ์เปลี่ยนสถานะการเล่นสำหรับหยุดชั่วคราว"
          }
        }
      }
    },
