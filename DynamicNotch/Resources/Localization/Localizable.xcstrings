    "settings.about.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حوّل شق MacBook الخاص بك إلى سطح تفاعلي حي. تحكم بالوسائط وتتبع التنزيلات واعرض الأحداث والمزيد — كل ذلك مباشرة من الشق."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Превърнете ноча на вашия MacBook в жива, интерактивна повърхност. Управлявайте медии, следете изтегляния, вижте събития и много повече — директно от ноча."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার ম্যাকবুকের নচকে একটি জীবন্ত, ইন্টারেক্টিভ পৃষ্ঠে রূপান্তর করুন। মিডিয়া নিয়ন্ত্রণ করুন, ডাউনলোড ট্র্যাক করুন, ইভেন্ট দেখুন এবং আরও অনেক কিছু — সরাসরি নচ থেকে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transforma el notch del teu MacBook en una superfície viva i interactiva. Controla els mitjans, fes el seguiment de les descàrregues, consulta esdeveniments i molt més — directament des del notch."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DynamicNotch je open-source aplikace pro macOS, která promění výřez vašeho MacBooku v dynamický a interaktivní prostor."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gør dit MacBook-notch til en levende, interaktiv overflade. Styr medier, spor downloads, se begivenheder og meget mere — direkte fra notchen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DynamicNotch ist eine Open-Source-macOS-App, die dynamische Insel-Funktionalität und interaktive Aktivitäten auf deinen Mac bringt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μετατρέψτε το notch του MacBook σας σε μια ζωντανή διαδραστική επιφάνεια. Ελέγξτε πολυμέσα, παρακολουθήστε λήψεις, δείτε συμβάντα και πολλά άλλα — απευθείας από το notch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn your MacBook notch into a live interactive surface. Control media, track downloads, manage timers, and monitor system events with fluid animations."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Convierta la muesca de su MacBook en una superficie interactiva en vivo. Controle la reproducción de medios, realice el seguimiento de las descargas, gestione temporizadores y supervise los eventos del sistema con animaciones fluidas."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ناچ مک‌بوک خود را به سطحی زنده و تعاملی تبدیل کنید. رسانه‌ها را کنترل کنید، دانلودها را پیگیری کنید، رویدادها را ببینید و موارد دیگر — مستقیماً از ناچ."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muuta MacBookisi notch eläväksi, interaktiiviseksi pinnaksi. Hallitse mediaa, seuraa latauksia, katso tapahtumia ja paljon muuta — suoraan notchista."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gawing buhay at interactive na surface ang notch ng iyong MacBook. Kontrolin ang media, subaybayan ang mga download, tingnan ang mga kaganapan, at marami pang iba — direkta mula sa notch."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DynamicNotch est une application macOS open-source qui transforme l'encoche de votre MacBook en une surface dynamique et interactive."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הפוך את מגרעת ה-MacBook שלך למשטח אינטראקטיבי מלא חיים. שלוט במדיה, עקוב אחר הורדות, צפה באירועים ועוד — ישירות מהמגרעת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपने MacBook नॉच को एक सजीव इंटरैक्टिव सतह में बदलें। मीडिया नियंत्रित करें, डाउनलोड ट्रैक करें, ईवेंट देखें और बहुत कुछ — सीधे नॉच से।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pretvorite urez svog MacBooka u živu, interaktivnu površinu. Upravljajte medijima, pratite preuzimanja, pregledavajte događaje i još mnogo toga — izravno iz ureza."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Változtassa MacBookja notch-át élő, interaktív felületté. Vezérelje a médiát, kövesse a letöltéseket, tekintse meg az eseményeket és még sok mást — közvetlenül a notch-ból."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DynamicNotch adalah aplikasi macOS sumber terbuka yang mengubah notch MacBook Anda menjadi permukaan yang dinamis dan interaktif."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DynamicNotch è un'app macOS open-source che trasforma il notch del tuo MacBook in una superficie dinamica e interattiva."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DynamicNotchはMacBookのノッチをダイナミックでインタラクティブなスペースに変えるオープンソースのmacOSアプリです。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MacBook ойығын жанды әрі интерактивті кеңістікке айналдырыңыз. Медианы басқарыңыз, жүктеулерді қадағалаңыз, оқиғаларды көріңіз және т.б. — тікелей ойықтан."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DynamicNotch는 MacBook의 노치를 역동적이고 대화형 공간으로 바꿔주는 오픈 소스 macOS 앱입니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ubah notch MacBook anda menjadi permukaan interaktif yang hidup. Kawal media, jejaki muat turun, lihat acara dan banyak lagi — terus dari notch."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gjør MacBook-notchen din om til en levende, interaktiv overflate. Kontroller medier, spor nedlastinger, se hendelser og mye mer — direkte fra notchen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DynamicNotch is een opensource macOS-app die de notch van je MacBook transformeert in een dynamisch, interactief oppervlak."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DynamicNotch to otwartoźródłowa aplikacja dla macOS, która przekształca notch MacBooka w dynamiczną i interaktywną przestrzeń."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O DynamicNotch é uma aplicação macOS de código aberto que transforma o notch do seu MacBook numa superfície dinâmica e interativa."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transformă notch-ul MacBook-ului tău într-o suprafață interactivă vie. Controlează media, urmărește descărcările, vizualizează evenimentele și multe altele — direct din notch."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Превратите вырез вашего MacBook в живой интерактивный элемент. Управляйте медиа, отслеживайте загрузки, таймеры и системные события с плавными анимациями."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premeňte výrez svojho MacBooku na živú, interaktívnu plochu. Ovládajte médiá, sledujte sťahovanie, prezerajte si udalosti a oveľa viac — priamo z výrezu."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Претворите ноч свог MacBook-а у живу, интерактивну површину. Контролишите медије, пратите преузимања, гледајте догађаје и још много тога — директно из ноча."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DynamicNotch är en macOS-app med öppen källkod som förvandlar din MacBooks flärp till en dynamisk och interaktiv yta."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เปลี่ยนรอยบากของ MacBook ของคุณให้เป็นพื้นผิวแบบโต้ตอบสด ควบคุมสื่อ ติดตามการดาวน์โหลด ดูกิจกรรม และอื่นๆ อีกมากมาย — ทั้งหมดทำได้จากรอยบากโดยตรง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MacBook çentiğinizi canlı ve etkileşimli bir yüzeye dönüştürün. Akıcı animasyonlarla ortamı denetleyin, indirmeleri izleyin, zamanlayıcıları yönetin ve sistem olaylarını takip edin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DynamicNotch — це програма з відкритим кодом для macOS, яка перетворює notch вашого MacBook на динамічний інтерактивний простір."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DynamicNotch là một ứng dụng macOS mã nguồn mở giúp biến notch trên MacBook của bạn thành một không gian động và tương tác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将您的 MacBook 齐刘海转变为实时交互界面。通过流畅的动画控制媒体、跟踪下载、管理计时器并监控系统事件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DynamicNotch 是一款開源 macOS 應用程式，將 MacBook 的「瀏海」轉變為動態且互動的介面。"
          }
        }
      }
    },
