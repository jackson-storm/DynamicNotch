    "settings.general.display.unavailable.autoSwitchDisabled" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الشاشة المحددة غير متاحة حالياً. سيبقى Dynamic Notch مخفياً حتى عودة تلك الشاشة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Избраният дисплей не е достъпен в момента. Dynamic Notch ще остане скрит."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "নির্বাচিত ডিসপ্লে এই মুহূর্তে অনুপলব্ধ। Dynamic Notch লুকানো থাকবে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La pantalla seleccionada no està disponible ara mateix. Dynamic Notch romandrà amagat."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vybraný displej není momentálně k dispozici. Dynamic Notch zůstane skrytý, dokud se tento monitor znovu nepřipojí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den valgte skærm er ikke tilgængelig i øjeblikket. Dynamic Notch forbliver skjult."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das ausgewählte Display ist derzeit nicht verfügbar. Dynamic Notch bleibt ausgeblendet, bis das Display wieder verbunden wird."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η επιλεγμένη οθόνη δεν είναι διαθέσιμη αυτή τη στιγμή. Το Dynamic Notch θα παραμείνει κρυφό."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The selected display is unavailable right now. Dynamic Notch will stay hidden until that display returns."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La pantalla seleccionada no está disponible ahora mismo. Dynamic Notch permanecerá oculto hasta que vuelva."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صفحه نمایش انتخابی در حال حاضر در دسترس نیست. Dynamic Notch پنهان خواهد ماند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valittu näyttö ei ole juuri nyt käytettävissä. Dynamic Notch pysyy piilossa."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindi available ang napiling display sa ngayon. Mananatiling nakatago ang Dynamic Notch."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'écran sélectionné est actuellement indisponible. Dynamic Notch restera masqué jusqu'au retour de cet écran."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הצג שנבחר אינו זמין כעת. Dynamic Notch יישאר מוסתר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चयनित डिस्प्ले अभी अनुपलब्ध है। Dynamic Notch तब तक छिपा रहेगा जब तक वह डिस्प्ले वापस नहीं आ जाता।"
