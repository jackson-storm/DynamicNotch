    "settings.vpn.disconnectedDuration2.desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose how long the VPN disconnection notification stays visible."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige cuánto tiempo permanece visible la notificación de desconexión VPN."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите, как долго отображается уведомление об отключении VPN."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择 VPN 断开通知的显示时长。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN bağlantı kesilme bildiriminin ne kadar süre görünür kalacağını seçin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle, wie lange die VPN-Trennungsbenachrichtigung sichtbar bleibt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez combien de temps la notification de déconnexion VPN reste visible."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha quanto tempo a notificação de VPN desligada permanece visível."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN切断通知を表示し続ける時間を選択します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN 연결 해제 알림이 표시되는 지속 시간을 선택하세요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli per quanto tempo la notifica di disconnessione VPN rimane visibile."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz, jak długo powiadomienie o rozłączeniu VPN pozostaje widoczne."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn thời gian thông báo ngắt kết nối VPN hiển thị."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih berapa lama notifikasi VPN terputus tetap terlihat."
          }
        }
      }
    },
