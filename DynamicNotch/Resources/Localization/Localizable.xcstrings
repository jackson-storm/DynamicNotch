    "Run every debug event in sequence, keep each item visible for its configured duration, and wait 1 second between items.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Debug-Ereignis nacheinander ausführen, jedes Element für die konfigurierte Dauer anzeigen und 1 Sekunde zwischen Elementen warten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exécuter chaque événement de débogage en séquence, garder chaque élément visible pendant sa durée configurée et attendre 1 seconde entre les éléments."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Executar todos os eventos de depuração em sequência, mantendo cada item visível durante o tempo configurado e aguardando 1 segundo entre itens."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各デバッグイベントを順番に実行し、設定された時間表示した後に1秒間待機します。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run every debug event in sequence, keep each item visible for its configured duration, and wait 1 second between items."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запустить каждое событие отладки по очереди, удерживать каждый элемент видимым в течение заданного времени и ждать 1 секунду между элементами."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejecutar cada evento de depuración en secuencia, mantener cada elemento visible durante su duración configurada y esperar 1 segundo entre elementos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按顺序运行每个调试事件，在配置的持续时间内保持每个项目可见，并在项目之间等待 1 秒。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her hata ayıklama olayını sırayla çalıştırın, her öğeyi yapılandırılan süre boyunca görünür tutun ve öğeler arasında 1 saniye bekleyin."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 디버그 이벤트를 순차적으로 실행하고, 각 항목을 설정된 시간 동안 표시하며, 항목 사이에 1초 동안 대기합니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esegui ogni evento di debug in sequenza, mantieni visibile ciascun elemento per la durata configurata e attendi 1 secondo tra gli elementi."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uruchom każde zdarzenie debugowania po kolei, utrzymuj każdy element widoczny przez skonfigurowany czas i odczekaj 1 sekundę między elementami."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạy từng sự kiện gỡ lỗi theo trình tự, giữ mỗi mục hiển thị trong khoảng thời gian đã định cấu hình và đợi 1 giây giữa các mục."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jalankan setiap peristiwa debug secara berurutan, biarkan setiap item terlihat selama durasi yang dikonfigurasi, dan tunggu 1 detik di antara item."
          }
        }
      }
    },
