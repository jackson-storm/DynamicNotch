    "settings.notch.showStroke.desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show a subtle outline that adapts to the active content color."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar un borde sutil que se adapta al color del contenido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывать акуратный контур, подстраивающийся под цвет контента."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示自适应于活动内容颜色的细微轮廓。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etkin içerik rengine uyum sağlayan hafif bir kenarlık göster."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Feine Konturlinie anzeigen, die sich an die Inhaltsfarbe anpasst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher un contour fin qui s'adapte à la couleur du contenu actif."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar um contorno fino que se adapta à cor do conteúdo ativo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクティブなコンテンツの色に適応する細い枠線を表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "활성 콘텐츠의 색상에 반응하는 얇은 테두리를 표시합니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra un bordo sottile che si adatta al colore del contenuto attivo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokaż cienki obrys, który dopasowuje się do koloru aktywnej zawartości."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiển thị đường viền mỏng thích ứng với màu của nội dung đang hoạt động."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tampilkan batas tipis yang menyesuaikan dengan warna konten aktif."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toon een dunne rand die zich aanpast aan de kleur van de actieve inhoud."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示與使用中內容色彩相適應的細邊框。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показувати тонкий контур, що адаптується до кольору активного вмісту."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visa en tunn ram som anpassar sig till färgen på det aktiva innehållet."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazit tenké ohraničení, které se přizpůsobuje barvě aktivního obsahu."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إظهار حد خفيف يتكيف مع لون المحتوى النشط."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक सूक्ष्म रूपरेखा दिखाएं जो सक्रिय सामग्री के रंग के अनुकूल होती है।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงเส้นขอบที่ปรับตามสีเนื้อหาที่ใช้งานอยู่"
          }
        }
      }
    },
