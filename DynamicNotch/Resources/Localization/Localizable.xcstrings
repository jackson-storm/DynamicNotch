    "settings.bluetooth.batteryColoredStroke.desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تلوين أنماط بطارية البلوتوث باستخدام لون مستوى البطارية الحالي."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оцветяване на рамката на батерията според текущото ниво на заряд."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "বর্তমান স্তরের উপর ভিত্তি করে ব্লুটুথ ব্যাটারি স্ট্রোক রঙ করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
