          "stringUnit": {
            "state": "translated",
            "value": "Pilih berapa lama notifikasi baterai penuh tetap terlihat."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies hoe lang de melding van een volle batterij zichtbaar blijft."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇充滿電通知保持可見的時間。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть, як довго сповіщення про повний заряд залишатиметься видимим."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
