        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चुनें कि ब्लूटूथ बैटरी जानकारी प्रतिशत के रूप में दिखाई जाए या सर्कल के रूप में।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odaberite prikazuju li se podaci o bateriji Bluetootha u postocima ili u krugu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Válassza ki, hogy a Bluetooth akkumulátor információi százalékként vagy körként jelenjenek meg."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tampilkan level baterai perangkat Bluetooth yang terhubung."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra il livello della batteria dei dispositivi Bluetooth collegati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接続されたBluetoothデバイスのバッテリー残量を表示します。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bluetooth батареясының пайызы немесе шеңбер түрінде көрсетілуін таңдаңыз."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
