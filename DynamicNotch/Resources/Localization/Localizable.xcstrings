    "settings.general.blueNightMode.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apply a dark blue color scheme to the settings interface."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicar un esquema de color azul oscuro a la interfaz de configuración."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Применить темно-синюю цветовую схему к интерфейсу настроек."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将深蓝色配色方案应用于设置界面。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarlar arayüzüne koyu mavi bir renk şeması uygula."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warme Farbtöne für entspanntes Arbeiten am Abend aktivieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activer des tons plus chauds pour réduire la fatigue oculaire en soirée."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativar tons mais quentes para reduzir o cansaço visual durante a noite."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "夜間の目の疲れを軽減するために暖色系のトーンを有効にします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "야간 눈의 피로를 줄이기 위해 따뜻한 톤을 활성화합니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abilita toni più caldi per ridurre l'affaticamento degli occhi durante la notte."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włącz cieplejsze tony, aby zmniejszyć zmęczenie oczu w nocy."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật tông màu ấm hơn để giảm mỏi mắt vào ban đêm."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktifkan nada yang lebih hangat untuk mengurangi ketegangan mata di malam hari."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakel warmere tinten in om vermoeidheid van de ogen 's nachts te verminderen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "啟用較暖的色調以減少夜間眼睛疲勞。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увімкніть тепліші тони, щоб зменшити напругу очей уночі."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivera varmare toner för att minska ögontrötthet på natten."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapněte teplejší tóny, abyste v noci snížili únavu očí."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تطبيق نظام ألوان أزرق داكن على واجهة الإعدادات."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सेटिंग्स इंटरफ़ेस पर डार्क ब्लू रंग योजना लागू करें।"
          }
        },
        "th": {
