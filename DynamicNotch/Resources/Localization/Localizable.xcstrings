            "value": "Select the preferred VPN connection and configure behavior."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбор предпочитаемого VPN-подключения и настройка."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
