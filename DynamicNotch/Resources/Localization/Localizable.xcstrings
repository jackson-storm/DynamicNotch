    "settings.support.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DynamicNotch is a free, open-source project. If you like the app, support its development! Donations motivate to develop the project further."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "DynamicNotch es un proyecto gratuito y de código abierto. Si te gusta la aplicación, ¡apoya su desarrollo! Las donaciones motivan a seguir desarrollando el proyecto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "DynamicNotch — бесплатный проект с открытым исходным кодом. Если вам нравится приложение, поддержите его разработку! Донаты мотивируют развивать проект дальше."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "DynamicNotch 是一个免费且开源的项目。如果你喜欢这个应用，请支持它的开发！您的捐赠是继续开发该项目的动力。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "DynamicNotch ücretsiz ve açık kaynaklı bir projedir. Uygulamayı beğendiyseniz geliştirilmesine destek olun! Bağışlar projeyi daha da ileri taşımak için motivasyon sağlar."
          }
        }
      }
    },
