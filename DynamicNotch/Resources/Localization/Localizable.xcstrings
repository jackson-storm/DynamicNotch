    "settings.nowPlaying.playbackSource.desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose which media app can show Now Playing in the notch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige qué aplicación puede mostrar Reproducción en la muesca."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите, какое приложение может показывать Сейчас играет в вырезе."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择哪个媒体应用可以在刘海中显示正在播放。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çentikte Çalınıyor'u hangi ortam uygulamasının gösterebileceğini seçin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle, welche Medien-App Aktuelle Wiedergabe in der Notch anzeigen darf."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisir quelle application multimédia peut afficher À l'écoute dans l'encoche."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolher que aplicação multimédia pode apresentar A reproduzir no notch."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノッチに「再生中」を表示できるメディアアプリを選択します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노치에 지금 재생 중을 표시할 수 있는 미디어 앱을 선택하세요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli quale app multimediale può mostrare In riproduzione nel notch."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz aplikację multimedialną, która może wyświetlać Teraz odtwarzane w notchu."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn ứng dụng phương tiện nào có thể hiển thị Đang phát trong notch."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih aplikasi media mana yang dapat menampilkan Sedang Diputar di notch."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies welke media-app Huidige in de notch mag tonen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇可以在「瀏海」中顯示「播放中」的媒體應用程式。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть, яка медіапрограма може показувати «Зараз грає» у вирізі notch."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj vilken medieapp som får visa 'Spelas nu' i flärpen."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte, která mediální aplikace může zobrazovat 'Právě hraje' ve výřezu."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر تطبيق الوسائط الذي يمكنه إظهار \"يُعرض الآن\" في الشق."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चुनें कि कौन सा मीडिया ऐप नॉच में 'अब चल रहा है' दिखा सकता है।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกแอปสื่อที่สามารถแสดงกำลังเล่นในรอยบากได้"
          }
        }
      }
    },
