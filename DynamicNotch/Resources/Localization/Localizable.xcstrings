    "settings.bluetooth.batteryIndicator2.desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر ما إذا كانت معلومات بطارية البلوتوث تُعرض كنسبة مئوية أو مؤشر دائري."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изберете дали информацията за батерията да се показва в проценти или като кръг."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ব্লুটুথ ব্যাটারি তথ্য শতাংশ বা বৃত্ত হিসাবে দেখানো হবে কিনা তা চয়ন করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tria si la informació de la bateria de Bluetooth es mostra com a percentatge o cercle."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobrazit úroveň baterie připojených zařízení Bluetooth."
