    "settings.battery.charging.desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إظهار نشاط مؤقت عند بدء شحن Mac."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показване на временна дейност, когато вашият Mac започне да се зарежда."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার Mac চার্জ হতে শুরু করলে একটি অস্থায়ী অ্যাক্টিভিটি দেখান।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra una activitat temporal quan el Mac comença a carregar-se."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobrazit oznámení při připojení nabíječky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vis en midlertidig aktivitet, når din Mac begynder at oplade."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ladebenachrichtigung anzeigen, wenn das Netzteil angeschlossen wird."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εμφάνιση προσωρινής δραστηριότητας όταν το Mac ξεκινά τη φόρτιση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Show a temporary activity when your Mac starts charging."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrar una actividad temporal cuando el Mac comience a cargar."
