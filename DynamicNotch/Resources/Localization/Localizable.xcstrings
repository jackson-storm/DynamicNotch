          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reemplazar la superposición de brillo del teclado con un HUD personalizado."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
