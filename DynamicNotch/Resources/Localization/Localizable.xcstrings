        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz, jak długo powiadomienie o ładowaniu pozostaje widoczne."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn thời gian thông báo sạc hiển thị."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
