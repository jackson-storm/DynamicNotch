    "settings.focus.autoHide.desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show the Focus activity briefly when Focus turns on instead of keeping it visible the whole time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar brevemente la actividad de Enfoque al activarlo en lugar de mantenerla visible todo el tiempo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывать активность Фокусирования кратко при включении вместо постоянного отображения."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "专注模式开启时短暂显示活动，而非始终可见。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odak etkinliğini sürekli göstermek yerine Odak açıldığında kısa süre göster."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fokus-Aktivität beim Einschalten nur kurz einblenden, anstatt sie dauerhaft sichtbar zu halten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher brièvement l'activité Concentration lors de l'activation au lieu de la garder visible en permanence."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar brevemente a atividade de Concentração ao ativar em vez de a manter sempre visível."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "集中モードを常に表示するのではなく、有効化時に短時間だけ表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "항상 표시하지 않고 활성화 시 잠시 동안만 집중 모드 활동을 표시합니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra brevemente l'attività di Full immersion all'attivazione invece di mantenerla sempre visibile."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokazuj krótko aktywność Skupienia po włączeniu, zamiast utrzymywać ją stale widoczną."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiển thị ngắn gọn hoạt động Tập trung khi bật thay vì luôn hiển thị."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tampilkan aktivitas Fokus secara singkat saat aktif daripada tetap terlihat sepanjang waktu."
          }
        }
      }
    },
