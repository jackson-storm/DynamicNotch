    "settings.general.display.autoSwitch.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدام الشاشة الرئيسية أثناء عدم توفر الشاشة المحددة، ثم نقل Dynamic Notch مرة أخرى عند توفرها."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Използване на главния дисплей, когато избраният дисплей не е наличен."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "নির্বাচিত ডিসপ্লে অনুপলব্ধ থাকাকালীন প্রধান ডিসপ্লে ব্যবহার করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilitza la pantalla principal mentre la pantalla seleccionada no estigui disponible."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automaticky přepínat na monitor obsahující aktivní okno."
          }
