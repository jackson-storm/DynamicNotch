    "settings.permissions.fullDiskAccess.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Full Disk Access to display real names and custom icons of Focus modes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите полный доступ к диску для отображения настоящих названий и значков режимов Фокусирования."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite el acceso total al disco para mostrar nombres reales e iconos personalizados del modo Enfoque."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许完全磁盘访问权限以显示专注模式的真实名称和自定义图标。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odak modlarının gerçek adlarını ve özel simgelerini göstermek için Tam Disk Erişimi'ne izin verin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Festplattenvollzugriff erlauben, um tatsächliche Namen und eigene Symbole von Fokusmodi anzuzeigen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autoriser l'Accès complet au disque pour afficher les noms réels et les icônes personnalisées des modes Concentration."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir Acesso Total ao Disco para apresentar nomes reais e ícones personalizados dos modos de Concentração."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "集中モードの実際の名前とカスタムアイコンを表示するためにフルディスクアクセスを許可します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "집중 모드의 실제 이름과 맞춤 아이콘을 표시하기 위해 전체 디스크 접근 권한을 허용합니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti Accesso completo al disco per mostrare i nomi reali e le icone personalizzate delle modalità di Full immersion."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zezwól na Pełny dostęp do dysku, aby wyświetlać rzeczywiste nazwy i niestandardowe ikony trybów Skupienia."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho phép Quyền truy cập đĩa đầy đủ để hiển thị tên thật và biểu tượng tùy chỉnh của các chế độ Tập trung."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izinkan Akses Disk Penuh untuk menampilkan nama asli dan ikon khusus dari mode Fokus."
          }
        }
      }
    },
