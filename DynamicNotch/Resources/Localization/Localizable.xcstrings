    "settings.permissions.calendar.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Calendar access to display your upcoming events."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите доступ к Календарю для отображения предстоящих событий."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite el acceso al Calendario para mostrar tus próximos eventos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许日历权限以显示即将到来的事件。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yaklaşan etkinliklerinizi göstermek için Takvim erişimine izin verin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalender-Zugriff erlauben, um bevorstehende Termine anzuzeigen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autoriser l'accès au Calendrier pour afficher vos événements à venir."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir acesso ao Calendário para apresentar os seus próximos eventos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今後の予定を表示するためにカレンダーへのアクセスを許可します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예정된 일정을 표시하기 위해 캘린더 접근 권한을 허용합니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti l'accesso a Calendario per visualizzare i tuoi prossimi eventi."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zezwól na dostęp do Kalendarza, aby wyświetlać nadchodzące wydarzenia."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho phép truy cập Lịch để hiển thị các sự kiện sắp tới của bạn."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izinkan akses ke Kalender untuk menampilkan acara mendatang Anda."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verleen toegang tot Agenda om je komende activiteiten weer te geven."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許存取行事曆以顯示即將到來的行程。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Надайте доступ до Календаря для відображення найближчих подій."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ge åtkomst till Kalender för att visa dina kommande händelser."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Povolte přístup ke Kalendáři pro zobrazení nadcházejících událostí."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "السماح بالوصول للتقويم لعرض أحداثك القادمة."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने आगामी ईवेंट प्रदर्शित करने के लिए कैलेंडर एक्सेस की अनुमति दें।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อนุญาตการเข้าถึงปฏิทินเพื่อแสดงกิจกรรมที่จะเกิดขึ้นของคุณ"
          }
        }
      }
    },
