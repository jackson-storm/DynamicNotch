    "settings.hud.style.desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر نمط العرض المرئي لعروض مستوى الصوت والسطوع ولوحة المفاتيح."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изберете визуален стил на представяне за HUD за сила на звука, яркост и клавиатура."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ভলিউম, উজ্জ্বলতা এবং কীবোর্ড HUD-এর জন্য ভিজ্যুয়াল উপস্থাপনা শৈলী চয়ন করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tria l'estil de presentació visual per als HUD de volum, brillantor i teclat."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyberte styl vzhledu HUD pro hlasitost, jas a klávesnici."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg visuel præsentationsstil for lydstyrke-, lysstyrke- og tastatur-HUD'er."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erscheinungsbild für Lautstärke-, Helligkeits- und Tastatur-HUDs wählen."
