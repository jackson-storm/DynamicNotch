    "settings.battery.lowPower2.desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show a warning when Low Power Mode is enabled or the battery is critically low."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar una advertencia cuando el modo de bajo consumo está activado o la batería está críticamente baja."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показать предупреждение при включении режима экономии энергии или критически низком заряде."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "低电量模式启用或电池电量严重不足时显示警告。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Düşük Güç Modu etkinleştirildiğinde veya pil kritik düzeyde azaldığında uyarı göster."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warnung anzeigen, wenn der Akkustand unter den Schwellenwert fällt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher une alerte lorsque la batterie passe sous le seuil défini."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar um alerta quando a bateria descer abaixo do limite definido."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バッテリーが設定値未満になったときにアラートを表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "배터리가 설정된 기준값 이하로 떨어지면 경고를 표시합니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra un avviso quando la batteria scende sotto la soglia definita."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokaż alert, gdy bateria spadnie poniżej zdefiniowanego progu."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiển thị cảnh báo khi pin xuống dưới ngưỡng đã đặt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tampilkan peringatan saat baterai turun di bawah ambang batas yang ditentukan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toon een waarschuwing wanneer de batterij onder de ingestelde drempel zakt."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當電池電量低於設定閾值時顯示警示。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показувати попередження, коли заряд опускається нижче заданого порогу."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visa en varning när batteriet sjunker under den angivna tröskeln."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazit upozornění, když baterie klesne pod stanovený práh."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إظهار تحذير عند تفعيل وضع الطاقة المنخفضة أو عند انخفاض البطارية بشكل حرج."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कम पावर मोड सक्षम होने पर या बैटरी गंभीर रूप से कम होने पर चेतावनी दिखाएं।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงคำเตือนเมื่อเปิดโหมดพลังงานต่ำหรือแบตเตอรี่ต่ำวิกฤต"
          }
        }
      }
    },
