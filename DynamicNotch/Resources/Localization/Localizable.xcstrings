    "settings.battery.fullBatteryStyle.headerDesc" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر ما إذا كان التنبيه يستخدم البطاقة المفصلة الحالية أو نمط شحن مضغوط."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изберете дали сигналът използва подробна карта или компактен стил на зареждане."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সতর্কতা বিস্তারিত কার্ড বা কমপ্যাক্ট চার্জিং শৈলী ব্যবহার করবে কিনা তা চয়ন করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tria si l'alerta utilitza una targeta detallada o un estil de càrrega compacte."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyberte styl oznámení o plně nabité baterii."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg, om advarslen bruger det detaljerede kort eller en kompakt opladningsstil."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle den Stil der Benachrichtigung bei vollständiger Ladung."
