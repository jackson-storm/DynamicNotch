    "settings.nowPlaying.hideFavorite.desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove the favorite button from the expanded player controls."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quitar el botón de favorito de los controles del reproductor expandido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Убрать кнопку избранного из расширенных элементов управления плеером."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从展开的播放器控件中移除收藏按钮。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Favori düğmesini genişletilmiş oynatıcı denetimlerinden kaldır."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Favoriten-Schaltfläche aus den erweiterten Player-Bedienelementen entfernen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masquer le bouton Favori des commandes agrandies du lecteur."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocultar o botão de Favorito dos controlos expandidos do leitor."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "展開したプレーヤーコントロールから「お気に入り」ボタンを非表示にします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확장된 플레이어 컨트롤에서 즐겨찾기 버튼을 숨깁니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nascondi il pulsante Preferiti dai controlli espansi del lettore."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukryj przycisk Ulubione w rozwiniętych elementach sterujących odtwarzacza."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ẩn nút Yêu thích khỏi các điều khiển trình phát mở rộng."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sembunyikan tombol Favorit dari kontrol pemutar yang diperluas."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verberg de favorietenknop in de uitgebreide spelerbediening."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在展開的播放器控制項中隱藏喜好項目按鈕。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Приховати кнопку «Улюблене» в розгорнутому плеєрі."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dölj favoritknappen i de expanderade spelarkontrollerna."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrýt tlačítko oblíbených v rozbalených ovládacích prvcích přehrávače."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إزالة زر المفضلة من عناصر تحكم المشغّل الموسّع."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "विस्तारित प्लेयर नियंत्रणों से पसंदीदा बटन हटाएं।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบปุ่มรายการโปรดออกจากการควบคุมเครื่องเล่นแบบขยาย"
          }
        }
      }
    },
