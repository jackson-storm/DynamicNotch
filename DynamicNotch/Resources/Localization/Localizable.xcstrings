    "settings.permissions.automation.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow controlling System Events to automatically center screenshot and recording preview windows on screen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите управление System Events для автоматического центрирования окон предварительного просмотра на экране."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite el control de System Events para centrar automáticamente las ventanas de vista previa en la pantalla."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许控制 System Events 以在屏幕上自动居中显示截图和录制预览窗口。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran görüntüsü ve kayıt önizleme pencerelerini ekranda otomatik olarak ortalamak için System Events denetimine izin verin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Steuerung von Systemeignissen erlauben, um Vorschaufenster von Screenshots und Aufnahmen auf dem Bildschirm zu zentrieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autoriser le contrôle des Événements système pour centrer automatiquement les fenêtres d'aperçu d'enregistrements et captures à l'écran."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir o controlo de Eventos do Sistema para centrar automaticamente janelas de pré-visualização de gravações e capturas no ecrã."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面上で録画やスクリーンショットのプレビューウィンドウを自動的に中央配置するために、システムイベントの制御を許可します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면에서 녹화 및 스크린샷 미리보기 창을 자동으로 중앙에 배치하도록 시스템 이벤트를 제어할 수 있는 권한을 허용합니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti il controllo di Eventi di sistema per centrare automaticamente le finestre di anteprima di registrazioni e screenshot sullo schermo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zezwól na sterowanie Zdarzeniami systemowymi, aby automatycznie wyśrodkowywać okna podglądu nagrań i zrzutów na ekranie."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho phép kiểm soát Sự kiện hệ thống để tự động căn giữa các cửa sổ xem trước bản ghi và ảnh chụp màn hình."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izinkan kontrol Peristiwa Sistem untuk secara otomatis memusatkan jendela pratinjau rekaman dan tangkapan layar."
          }
        }
      }
    },
