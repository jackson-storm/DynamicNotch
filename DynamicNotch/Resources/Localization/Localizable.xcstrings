    "settings.battery.fullBatteryStyle.headerDesc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose whether the alert uses the current detailed card or a compact charging-like layout."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige si la alerta usa la tarjeta detallada o un diseño compacto tipo carga."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите, использует ли уведомление подробную карточку или компактный стиль зарядки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择警报使用当前详细卡片还是紧凑的充电式布局。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uyarının ayrıntılı kartı mı yoksa şarj benzeri kompakt bir düzeni mi kullanacağını seçin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle den Stil der Benachrichtigung bei vollständiger Ladung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez le style de notification lorsque la batterie est pleine."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha o estilo de notificação para bateria cheia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フル充電時の通知スタイルを選択します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완충 시 알림 스타일을 선택하세요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli lo stile di notifica per la batteria carica."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz styl powiadomienia o pełnej baterii."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn kiểu thông báo khi pin đầy."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih gaya notifikasi saat baterai penuh."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies de stijl voor de melding van een volle batterij."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇充滿電時的通知樣式。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть стиль сповіщення про повний заряд."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj aviseringsstil för fullt batteri."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte styl oznámení o plně nabité baterii."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر ما إذا كان التنبيه يستخدم البطاقة المفصلة الحالية أو نمط شحن مضغوط."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चुनें कि चेतावनी विस्तृत कार्ड का उपयोग करे या कॉम्पैक्ट शैली का।"
