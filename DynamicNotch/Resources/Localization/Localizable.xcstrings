    "settings.wifi.duration.desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر مدة بقاء إشعار إعادة اتصال Wi-Fi مرئياً."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изберете колко време известието за повторно свързване с Wi-Fi да остане видимо."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wi-Fi পুনঃসংযোগ বিজ্ঞপ্তি কতক্ষণ দৃশ্যমান থাকবে তা চয়ন করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tria quant de temps es manté visible la notificació de reconexió a Wi-Fi."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zvolte, jak dlouho zůstane oznámení o opětovném připojení k Wi-Fi viditelné."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg, hvor længe Wi-Fi-genforbindelsesnotifikationen skal være synlig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle, wie lange die WLAN-Wiederverbindungsbenachrichtigung sichtbar bleibt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιλέξτε πόση ώρα θα παραμένει ορατή η ειδοποίηση επανασύνδεσης Wi-Fi."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose how long the Wi-Fi reconnect notification stays visible."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige cuánto tiempo permanece visible la notificación de reconexión Wi-Fi."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مدت زمان نمایان ماندن اعلان اتصال مجدد Wi-Fi را انتخاب کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valitse, kuinka kauan Wi-Fi-uudelleenyhdistämisilmoitus pysyy näkyvissä."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piliin kung gaano katagal mananatiling nakikita ang abiso ng muling pagkonekta sa Wi-Fi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez combien de temps la notification de reconnexion Wi-Fi reste visible."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בחר כמה זמן התראת חיבור מחדש ל-Wi-Fi תישאר גלויה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चुनें कि Wi-Fi पुन: कनेक्ट सूचना कितने समय तक दिखाई देगी।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odaberite koliko dugo obavijest o ponovnom povezivanju s Wi-Fi mrežom ostaje vidljiva."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Válassza ki, mennyi ideig maradjon látható a Wi-Fi újracsatlakozási értesítés."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
