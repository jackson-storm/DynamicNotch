          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz, jak długo powiadomienie o rozłączeniu VPN pozostaje widoczne."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn thời gian thông báo ngắt kết nối VPN hiển thị."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih berapa lama notifikasi VPN terputus tetap terlihat."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies hoe lang de melding van een verbroken VPN-verbinding zichtbaar blijft."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇 VPN 中斷連線通知保持可見的時間。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть, як довго сповіщення про відключення VPN залишатиметься видимим."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj hur länge aviseringen om frånkopplad VPN ska vara synlig."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvolte, jak dlouho zůstane oznámení o odpojení VPN viditelné."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر مدة بقاء إشعار قطع اتصال VPN مرئياً."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चुनें कि VPN डिस्कनेक्शन सूचना कितने समय तक दिखाई देगी।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกระยะเวลาที่การแจ้งเตือนตัดการเชื่อมต่อ VPN จะแสดงอยู่"
          }
