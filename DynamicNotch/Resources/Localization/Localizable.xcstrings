            "value": "Teñir el borde de la muesca con el color del nivel de HUD en lugar del blanco predeterminado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Окрашивать обводку выреза в цвет уровня HUD вместо белого по умолчанию."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用当前 HUD 等级颜色为刘海描边着色，而非默认的白色描边。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çentik kenarlığını varsayılan beyaz yerine geçerli HUD düzeyi rengiyle renklendir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Notch-Kontur in der aktuellen HUD-Pegelfarbe statt des standardmäßigen Weiß färben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Teinter le contour de l'encoche avec la couleur de niveau actuelle du HUD au lieu du blanc par défaut."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Colorir o contorno do notch com a cor do nível atual do HUD em vez do branco padrão."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デフォルトの白の代わりに、現在のHUDレベルカラーでノッチの枠線を色付けします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본 흰색 대신 현재 HUD 레벨 색상으로 노치 테두리를 칠합니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Colora il bordo del notch con il colore del livello attuale dell'HUD invece del bianco predefinito."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zabarw obrys notcha bieżącym kolorem poziomu HUD zamiast domyślnej bieli."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tô màu viền notch bằng màu mức HUD hiện tại thay vì màu trắng mặc định."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Warnai batas notch dengan warna level HUD saat ini alih-alih warna putih default."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kleur de rand van de notch met de huidige HUD-niveaukleur in plaats van standaard wit."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用目前的 HUD 等級顏色為「瀏海」邊框著色，而非預設的白色。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Фарбувати контур notch кольором поточного рівня HUD замість стандартного білого."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Färglägg flärpens ram med den aktuella HUD-nivåfärgen istället för standardvitt."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zbarvit ohraničení výřezu aktuální barvou úrovně HUD namísto výchozí bílé."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تلوين حد الشق باستخدام لون مستوى العرض الحالي بدلاً من الحد الأبيض الافتراضي."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डिफ़ॉल्ट सफेद स्ट्रोक के बजाय वर्तमान HUD स्तर के रंग का उपयोग करके नॉच स्ट्रोक को टिंट करें।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ย้อมสีเส้นขอบรอยบากตามสีระดับ HUD ปัจจุบันแทนเส้นขอบสีขาวเริ่มต้น"
          }
        }
      }
    },
