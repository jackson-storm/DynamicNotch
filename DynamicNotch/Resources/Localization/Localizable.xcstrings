    "settings.focus.style.headerDesc" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر ما إذا كان التركيز يعرض عبارات التشغيل والإيقاف أو أيقونة القمر فقط."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изберете дали Фокус показва етикети Вкл./Изкл. или само икона на луна."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ফোকাস চালু/বন্ধ লেবেল বা শুধুমাত্র চাঁদের আইকন প্রদর্শন করবে কিনা তা চয়ন করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tria si Concentració mostra etiquetes d'Activat/Desactivat o només la icona de la lluna."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zvolte, zda režim Soustředění zobrazuje štítky Zapnuto/Vypnuto, nebo pouze ikonu měsíce."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg, om Fokus viser Til/Fra-tekst eller kun måneikonet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle, ob Fokus die Beschriftungen „Ein“ und „Aus“ oder nur das Mondsymbol anzeigt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιλέξτε αν η Συγκέντρωση θα εμφανίζει ετικέτες Ενεργό/Ανενεργό ή μόνο το εικονίδιο φεγγαριού."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose whether Focus shows the On and Off labels or only the moon icon."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige si Enfoque muestra las etiquetas de activado/desactivado o solo el icono de luna."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انتخاب کنید که تمرکز برچسب‌های روشن/خاموش را نمایش دهد یا فقط آیکون ماه."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valitse, näyttääkö Keskittyminen Päällä/Pois-tekstit vai vain kuukuvakkeen."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piliin kung magpapakita ang Focus ng mga label na On/Off o icon lamang ng buwan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez si Concentration affiche les libellés Activé/Désactivé ou uniquement l'icône de lune."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בחר אם פוקוס מציג תוויות פועל/כבוי או רק את סמל הירח."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चुनें कि क्या फ़ोकस चालू/बंद लेबल दिखाए या केवल चंद्रमा आइकन।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odaberite prikazuje li Fokus oznake Uključeno/Isključeno ili samo ikonu mjeseca."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Válassza ki, hogy a Fókusz megjelenítse-e a Be/Ki feliratokat vagy csak a hold ikont."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih apakah Fokus menampilkan label Nyala/Mati atau hanya ikon bulan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli se Full immersion mostra le etichette Attiva/Non attiva o solo l'icona della luna."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "集中モードでオン/オフラベルを表示するか、月のアイコンのみを表示するかを選択します。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зейін қою режимінде Қосу/Өшіру жазулары немесе тек ай белгішесі көрсетілуін таңдаңыз."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "집중 모드에서 켬/끔 텍스트를 표시할지 달 아이콘만 표시할지 선택하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih sama ada Fokus memaparkan label Hidup/Mati atau hanya ikon bulan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velg om Fokus viser På/Av-etiketter eller bare måneikonet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies of Focus de labels Aan/Uit toont of alleen het maansymbool."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz, czy tryb Skupienia ma wyświetlać etykiety Wł./Wył., czy tylko ikonę księżyca."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha se a Concentração mostra etiquetas Ativado/Desativado ou apenas o ícone da lua."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alegeți dacă Focalizarea afișează etichetele Pornit/Oprit sau doar pictograma lunii."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите, показывает ли Фокусирование надписи Вкл/Выкл или только значок луны."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyberte, či Môj čas zobrazuje štítky Zap/Vyp alebo iba ikonu mesiaca."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изаберите да ли Фокус приказује ознаке Укључено/Искључено или само икону месеца."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Välj om fokusläget ska visa etiketter för På/Av eller bara månikonen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เลือกว่าจะให้โฟกัสแสดงป้ายกำกับเปิด/ปิดหรือแสดงเฉพาะไอคอนดวงจันทร์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odak'ın Açık ve Kapalı etiketlerini mi yoksa yalnızca ay simgesini mi göstereceğini seçin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Виберіть, чи показувати в режимі Фокусування написи Увімк/Вимк, або лише значок місяця."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chọn xem Tập trung có hiển thị nhãn Bật/Tắt hay chỉ biểu tượng mặt trăng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择专注模式是显示开/关标签还是仅显示月亮图标。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選擇專注模式顯示開/關標籤或僅顯示月亮圖示。"
          }
        }
      }
    },
