    "settings.general.display.closeAtFocus.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إخفاء عرض النشاط المباشر عندما يصبح التطبيق المستهدف نشطاً."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скрива изгледа на дейността на живо, когато целевото приложение стане активно."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "টার্গেট অ্যাপ সক্রিয় হলে লাইভ অ্যাক্টিভিটি ভিউ লুকিয়ে রাখে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amaga la vista de l'activitat en directe quan l'aplicació de destinació s'activa."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zavřít výřez při přepnutí fokusu na jinou aplikaci."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skjuler liveaktivitetsvisningen, når målprogrammet bliver aktivt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Notch schließen, wenn der Fokus zu einer anderen App wechselt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Απόκρυψη της εμφάνισης ζωντανής δραστηριότητας όταν η εφαρμογή προορισμού γίνεται ενεργή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hides the live activity display when the target application becomes active."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oculta la visualización de la actividad en vivo cuando la aplicación de destino se vuelve activa."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پنهان کردن نمای فعالیت زنده هنگام فعال شدن برنامه هدف."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piilottaa live-toiminnan näytön, kun kohdesovellus tulee aktiiviseksi."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Itinatago ang view ng live activity kapag naging aktibo ang target na app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fermer l'encoche lorsque le focus passe à une autre application."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
