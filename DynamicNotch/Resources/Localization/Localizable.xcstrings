    "settings.battery.lowBatteryStyle.headerDesc" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر ما إذا كان التنبيه يستخدم البطاقة المفصلة الحالية أو نمط شحن مضغوط."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изберете дали сигналът използва подробна карта или компактен стил."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সতর্কতা বিস্তারিত কার্ড বা কমপ্যাক্ট শৈলী ব্যবহার করবে কিনা তা চয়ন করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tria si l'alerta utilitza una targeta detallada o un estil compacte."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyberte styl upozornění na slabou baterii."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg, om advarslen bruger det detaljerede kort eller en kompakt stil."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle den Stil der Warnung bei niedrigem Akkustand."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιλέξτε αν η ειδοποίηση θα χρησιμοποιεί αναλυτική κάρτα ή συμπαγές στυλ."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose whether the alert uses the current detailed card or a compact charging-like layout."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige si la alerta usa la tarjeta detallada actual o un diseño compacto tipo carga."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انتخاب کنید که هشدار از کارت دقیق یا سبک فشرده استفاده کند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
