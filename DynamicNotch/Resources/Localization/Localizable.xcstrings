    "settings.bluetooth.batteryIndicator2.desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose whether Bluetooth battery information is shown as a percentage or a circular indicator."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige si la información de batería Bluetooth se muestra como porcentaje o indicador circular."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите, отображается ли заряд Bluetooth в процентах или кольцевым индикатором."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择蓝牙电池信息以百分比还是圆形指示器显示。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth pil bilgisinin yüzde olarak mı yoksa dairesel gösterge olarak mı gösterileceğini seçin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Akkustandsanzeige für verbundene Bluetooth-Geräte anzeigen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher le niveau de batterie des appareils Bluetooth connectés."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar o nível de bateria dos dispositivos Bluetooth ligados."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続されたBluetoothデバイスのバッテリー残量を表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결된 Bluetooth 기기의 배터리 잔량을 표시합니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra il livello della batteria dei dispositivi Bluetooth collegati."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokaż poziom baterii podłączonych urządzeń Bluetooth."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiển thị mức pin của các thiết bị Bluetooth đã kết nối."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tampilkan level baterai perangkat Bluetooth yang terhubung."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toon het batterijniveau van verbonden Bluetooth-apparaten."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示已連接藍牙裝置的電池電量。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показувати рівень заряду підключених Bluetooth-пристроїв."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visa batterinivån för anslutna Bluetooth-enheter."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazit úroveň baterie připojených zařízení Bluetooth."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر ما إذا كانت معلومات بطارية البلوتوث تُعرض كنسبة مئوية أو مؤشر دائري."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चुनें कि ब्लूटूथ बैटरी जानकारी प्रतिशत के रूप में दिखाई जाए या सर्कल के रूप में।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกว่าจะแสดงข้อมูลแบตเตอรี่บลูทูธเป็นเปอร์เซ็นต์หรือวงกลม"
          }
        }
      }
    },
