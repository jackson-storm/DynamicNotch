    "settings.notch.width.desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fine-tune the width of the notch or Dynamic Island."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustar el ancho de la muesca o Dynamic Island."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Точная настройка ширины выреза или Dynamic Island."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "微调刘海或 Dynamic Island 的宽度。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çentiğin veya Dynamic Island'ın genişliğine ince ayar yapın."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Breite der Notch oder Dynamic Island feinjustieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuster précisément la largeur de l'encoche ou de la Dynamic Island."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustar com precisão a largura do notch ou da Dynamic Island."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノッチまたはDynamic Islandの幅を細かく調整します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노치 또는 Dynamic Island의 너비를 미세 조정합니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Regola con precisione la larghezza del notch o della Dynamic Island."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Precyzyjnie dostosuj szerokość notcha lub Dynamic Island."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tinh chỉnh chiều rộng của notch hoặc Dynamic Island."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesuaikan lebar notch atau Dynamic Island secara presisi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verfijn de breedte van de notch of het Dynamic Island."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "微調「瀏海」或動態島的寬度。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Точно відрегулюйте ширину вирізу notch або Dynamic Island."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Finjustera bredden på flärpen eller Dynamic Island."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jemně dolaďte šířku výřezu nebo Dynamic Island."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ضبط عرض الشق أو الجزيرة الديناميكية بدقة."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नॉच या डायनामिक आइलैंड की चौड़ाई को सटीक रूप से समायोजित करें।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปรับแต่งความกว้างของรอยบากหรือ Dynamic Island อย่างละเอียด"
          }
        }
      }
