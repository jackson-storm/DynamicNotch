    "settings.notch.showStroke.desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إظهار حد خفيف يتكيف مع لون المحتوى النشط."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показване на фин контур, който се адаптира към цвета на активното съдържание."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "একটি সূক্ষ্ম রূপরেখা দেখান যা সক্রিয় বিষয়বস্তুর রঙের সাথে খাপ খায়।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra un contorn subtil que s'adapta al color del contingut actiu."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobrazit tenké ohraničení, které se přizpůsobuje barvě aktivního obsahu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vis en subtil omrids, der tilpasser sig det aktive indholds farve."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feine Konturlinie anzeigen, die sich an die Inhaltsfarbe anpasst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εμφάνιση διακριτικού περιγράμματος που προσαρμόζεται στο χρώμα του ενεργού περιεχομένου."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Show a subtle outline that adapts to the active content color."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrar un borde sutil que se adapta al color del contenido."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
