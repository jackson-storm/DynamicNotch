    "settings.nowPlaying.artwork3D.desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Animate artwork with a 3D flip when the track cover changes."
          }
        },
