    "settings.system.menuBarIcon.desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show a menu bar shortcut for quick access to Settings and Quit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar un acceso rápido en la barra de menús para Ajustes y Salir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показать ярлык в строке меню для быстрого доступа к Настройкам и выходу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在菜单栏中显示快捷方式以快速访问设置和退出。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarlar ve Çık'a hızlı erişim için menü çubuğu kısayolunu göster."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Symbol in der Menüleiste für schnellen Zugriff auf Einstellungen und Beenden anzeigen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher une icône dans la barre des menus pour un accès rapide aux réglages et pour quitter."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Apresentar um ícone na barra de menus para aceder rapidamente às definições e encerrar a aplicação."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定へのクイックアクセスおよび終了のためにメニューバーにアイコンを表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정에 빠르게 접근하고 앱을 종료할 수 있도록 메뉴 막대에 아이콘을 표시합니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra un'icona nella barra dei menu per accedere rapidamente alle impostazioni e uscire."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokaż ikonę na pasku menu, aby mieć szybki dostęp do ustawień i wyjścia."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiển thị biểu tượng trên thanh menu để truy cập nhanh vào cài đặt và thoát."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tampilkan ikon di bilah menu untuk akses cepat ke pengaturan dan keluar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toon een symbool in de menubalk om snel naar instellingen te gaan en te stoppen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在選單列中顯示圖示以快速存取設定並結束。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показувати значок у рядку меню для швидкого доступу до налаштувань та виходу."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visa en ikon i menyraden för snabb åtkomst till inställningar och avsluta."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazit ikonu v řádku nabídek pro rychlý přístup k nastavení a ukončení."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إظهار اختصار في شريط القوائم للوصول السريع للإعدادات والإنهاء."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सेटिंग्स और छोड़ने के लिए त्वरित पहुंच के लिए मेनू बार शॉर्टकट दिखाएं।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงทางลัดบนแถบเมนูเพื่อการเข้าถึงการตั้งค่าและออกจากโปรแกรมได้อย่างรวดเร็ว"
          }
        }
      }
    },
