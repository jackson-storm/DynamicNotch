    "settings.calendar.privacyMode.desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide event titles and show only time blocks."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocultar títulos de eventos y mostrar solo bloques de tiempo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скрыть названия событий и показывать только временные блоки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐藏事件标题，仅显示时间块。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etkinlik başlıklarını gizle, yalnızca zaman bloklarını göster."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ereignistitel verbergen und nur Zeitblöcke anzeigen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masquer les titres des événements et afficher uniquement les plages horaires."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocultar os títulos dos eventos e apresentar apenas os horários."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "イベント名を非表示にし、時間のみを表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이벤트 제목을 숨기고 시간 범위만 표시합니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nascondi i titoli degli eventi e mostra solo gli orari."
          }
