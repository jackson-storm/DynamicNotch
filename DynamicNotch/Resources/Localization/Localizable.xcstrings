        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatycznie zamykaj powiadomienie o zrzucie ekranu po upływie określonego czasu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
