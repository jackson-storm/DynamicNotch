    "settings.battery.lowBatteryThreshold.desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر نسبة البطارية التي تُفعّل إشعار البطارية المنخفضة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изберете процента на батерията, който задейства известието за нисък заряд."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কম ব্যাটারির বিজ্ঞপ্তি ট্রিগার করে এমন ব্যাটারি শতাংশ চয়ন করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tria el percentatge de bateria que activa la notificació de bateria baixa."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Procentuální úroveň baterie, která spustí upozornění."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
