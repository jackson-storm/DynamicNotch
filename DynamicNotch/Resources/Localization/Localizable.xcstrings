    "settings.vpn.disconnectedActivity2.desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show a short notification when a VPN connection becomes inactive."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar una notificación breve cuando una conexión VPN se desactiva."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показать короткое уведомление при деактивации VPN-подключения."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN 连接停用时显示短暂通知。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir VPN bağlantısı pasif hale geldiğinde kısa bir bildirim göster."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurze Benachrichtigung anzeigen, wenn eine VPN-Verbindung getrennt wird."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher une courte notification lorsqu'une connexion VPN devient inactive."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar uma notificação curta quando uma ligação VPN ficar inativa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN接続が非アクティブになったときに短い通知を表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN 연결이 비활성화될 때 짧은 알림을 표시합니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra una breve notifica quando una connessione VPN diventa inattiva."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokaż krótkie powiadomienie, gdy połączenie VPN stanie się nieaktywne."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiển thị thông báo ngắn khi kết nối VPN không hoạt động."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tampilkan notifikasi singkat saat koneksi VPN menjadi tidak aktif."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toon een korte melding wanneer een VPN-verbinding inactief wordt."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當 VPN 連線變為非使用中時顯示簡短通知。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показувати коротке сповіщення, коли VPN-з'єднання стає неактивним."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visa en kort avisering när en VPN-anslutning blir inaktiv."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazit krátké oznámení při neaktivitě připojení VPN."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إظهار إشعار قصير عند توقف اتصال VPN."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN कनेक्शन निष्क्रिय होने पर संक्षिप्त सूचना दिखाएं।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงการแจ้งเตือนสั้นๆ เมื่อการเชื่อมต่อ VPN หยุดทำงาน"
          }
        }
      }
    },
