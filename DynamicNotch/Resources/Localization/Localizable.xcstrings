    "settings.general.display.autoSwitch.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the main display while the selected display is unavailable, then move Dynamic Notch back when it returns."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa la pantalla principal mientras la pantalla seleccionada no esté disponible y devuelve Dynamic Notch cuando vuelva."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Использовать основной дисплей, пока выбранный дисплей недоступен, и возвращать Dynamic Notch обратно, когда он появится."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当所选显示屏不可用时使用主显示屏，并在其恢复后将 Dynamic Notch 移回去。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçilen ekran kullanılamazken ana ekranı kullan, ekran geri döndüğünde Dynamic Notch'u ona taşı."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisch zum Bildschirm mit dem aktiven Fenster wechseln."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Basculer automatiquement vers l'écran contenant la fenêtre active."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mudar automaticamente para o ecrã que contém a janela ativa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクティブなウィンドウがあるディスプレイに自動的に切り替えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "활성 창이 있는 디스플레이로 자동 전환합니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Passa automaticamente allo schermo contenente la finestra attiva."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatycznie przełączaj na ekran zawierający aktywne okno."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tự động chuyển sang màn hình chứa cửa sổ đang hoạt động."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Beralih secara otomatis ke layar yang berisi jendela aktif."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakel automatisch over naar het scherm met het actieve venster."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自動切換到包含使用中視窗的顯示器。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматично перемикатися на екран з активним вікном."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Växla automatiskt till skärmen som innehåller det aktiva fönstret."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Automaticky přepínat na monitor obsahující aktivní okno."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدام الشاشة الرئيسية أثناء عدم توفر الشاشة المحددة، ثم نقل Dynamic Notch مرة أخرى عند توفرها."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चयनित डिस्प्ले अनुपलब्ध होने पर मुख्य डिस्प्ले का उपयोग करें।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้จอแสดงผลหลักขณะที่จอแสดงผลที่เลือกไม่พร้อมใช้งาน"
          }
        }
      }
    },
