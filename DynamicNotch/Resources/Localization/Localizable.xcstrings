    "settings.notch.priorities.customOrder.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسحب العناصر لإعادة ترتيب الأولوية. العناصر العليا لها أولوية أعلى."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Плъзнете елементи за пренареждане на приоритетите. Горните елементи имат по-висок приоритет."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অগ্রাধিকার পুনর্বিন্যাস করতে আইটেমগুলি টেনে আনুন। উপরের আইটেমগুলির অগ্রাধিকার বেশি।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrossega elements per reordenar la prioritat. Els elements superiors tenen més prioritat."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přetažením změňte pořadí priorit. Položky nahoře mají přednost."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Træk elementer for at omarrangere prioritet. Øverste elementer har højere prioritet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elemente ziehen, um Prioritäten neu anzuordnen. Obere Elemente haben Vorrang."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σύρετε στοιχεία για αναδιάταξη προτεραιότητας. Τα ανώτερα στοιχεία έχουν υψηλότερη προτεραιότητα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drag items to reorder priority. Upper items have higher priority."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra los elementos для reordenar la prioridad. Los elementos superiores tienen mayor prioridad."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای تغییر اولویت موارد را بکشید. موارد بالایی اولویت بیشتری دارند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vedä kohteita järjestääksesi tärkeysjärjestyksen. Ylemmillä kohteilla on korkeampi prioriteetti."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I-drag ang mga item upang muling isaayos ang prayoridad. Ang mga nasa itaas ay may mas mataas na prayoridad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser pour réorganiser les priorités. Les éléments du haut sont prioritaires."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "גרור פריטים כדי לסדר מחדש עדיפויות. פריטים עליונים מקבלים עדיפות גבוהה יותר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्राथमिकता पुनर्व्यवस्थित करने के लिए आइटम खींचें। ऊपरी आइटमों की प्राथमिकता अधिक है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povucite stavke za promjenu redoslijeda prioriteta. Gornje stavke imaju veći prioritet."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Húzza az elemeket a prioritás átrendezéséhez. A felső elemek magasabb prioritásúak."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seret untuk mengatur ulang prioritas. Item di bagian atas memiliki prioritas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina per riordinare le priorità. Gli elementi in alto hanno la priorità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ドラッグして優先順位を変更します。上位の項目が優先されます。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Басымдық ретін өзгерту үшін элементтерді сүйреңіз. Жоғарғы элементтер басымдыққа ие."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "드래그하여 우선순위를 변경하세요. 상단 항목이 우선순위를 갖습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seret item untuk menyusun semula keutamaan. Item atas mempunyai keutamaan lebih tinggi."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dra elementer for å endre prioritering. Øverste elementer har høyere prioritet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sleep om prioriteiten opnieuw te ordenen. Bovenste items hebben voorrang."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przeciągaj, aby zmienić priorytety. Elementy u góry mają pierwszeństwo."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arraste para reorganizar prioridades. Os itens no topo têm prioridade."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trageți elementele pentru a reordona prioritatea. Elementele superioare au prioritate mai mare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перетащите элементы для изменения приоритета. Элементы выше имеют более высокий приоритет."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potiahnutím zmeníte poradie priorít. Horné položky majú vyššiu prioritu."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Превуците ставке за промену редоследа приоритета. Горње ставке имају већи приоритет."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dra för att ändra prioritetsordning. Översta objekten har företräde."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ลากรายการเพื่อจัดลำดับความสำคัญ รายการด้านบนจะมีลำดับความสำคัญสูงกว่า"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Önceliği değiştirmek için öğeleri sürükleyin. Üstteki öğelerin önceliği daha yüksektir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перетягуйте, щоб змінити пріоритети. Верхні елементи мають перевагу."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kéo để sắp xếp lại mức độ ưu tiên. Các mục ở trên cùng được ưu tiên."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖动项目以重新排列优先级。上面的项目具有更高的优先级。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖移以重新排列優先順序。頂部項目具有優先權。"
          }
        }
      }
    },
