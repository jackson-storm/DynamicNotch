    "settings.general.display.closeAtFocus.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hides the live activity display when the target application becomes active."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculta la visualización de la actividad en vivo cuando la aplicación de destino se vuelve activa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скрывает отображение live activity, когда целевое приложение становится активным."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当目标应用程序处于活动状态时隐藏实时活动显示。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hedef uygulama etkin hale geldiğinde canlı etkinlik göstergesini gizler."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Notch schließen, wenn der Fokus zu einer anderen App wechselt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fermer l'encoche lorsque le focus passe à une autre application."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Fechar o notch quando o foco mudar para outra aplicação."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "他のアプリケーションにフォーカスが移ったときにノッチを閉じます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 앱으로 포커스가 이동하면 노치를 닫습니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiudi il notch quando lo stato attivo passa a un'altra applicazione."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamknij notch, gdy fokus przejdzie do innej aplikacji."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đóng notch khi tiêu điểm chuyển sang ứng dụng khác."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutup notch saat fokus berpindah ke aplikasi lain."
          }
        }
      }
    },
