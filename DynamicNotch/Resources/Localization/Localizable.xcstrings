    "settings.hud.keyboard.desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استبدال تراكب سطوع لوحة المفاتيح بعرض مخصص في الشق."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заменете системното наслагване за осветление на клавиатурата с HUD в ноча."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কীবোর্ড ব্যাকলাইট ওভারলেটিকে নচে HUD দিয়ে প্রতিস্থাপন করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Substitueix la superposició de retroil·luminació del teclat per un HUD al notch."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nahradit systémový indikátor jasu klávesnice HUDem ve výřezu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erstat tastaturbaggrundsbelysningens overlay med en HUD i notchen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "System-Tastaturbeleuchtungsanzeige durch einen eigenen HUD in der Notch ersetzen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αντικατάσταση της επικάλυψης φωτεινότητας πληκτρολογίου με HUD στο notch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
