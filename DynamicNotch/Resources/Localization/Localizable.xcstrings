    "settings.permissions.bluetooth.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Bluetooth access to read battery levels from supported accessories."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите доступ к Bluetooth для чтения уровня заряда поддерживаемых аксессуаров."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite el acceso a Bluetooth para leer los niveles de batería de accesorios compatibles."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许蓝牙权限以读取受支持配件的电量。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Desteklenen aksesuarlardan pil düzeylerini okumak için Bluetooth erişimine izin verin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth-Zugriff erlauben, um Batteriestände unterstützter Zubehörgeräte auszulesen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autoriser l'accès Bluetooth pour lire les niveaux de batterie des accessoires pris en charge."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir acesso Bluetooth para ler os níveis de bateria de acessórios suportados."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "対応アクセサリのバッテリー残量を読み取るためにBluetoothへのアクセスを許可します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지원되는 액세서리의 배터리 잔량을 읽기 위해 Bluetooth 권한을 허용합니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti l'accesso Bluetooth per leggere i livelli della batteria degli accessori supportati."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zezwól na dostęp do Bluetooth, aby odczytywać poziom naładowania baterii obsługiwanych akcesoriów."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho phép truy cập Bluetooth để đọc mức pin của các phụ kiện được hỗ trợ."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izinkan akses Bluetooth untuk membaca level baterai aksesori yang didukung."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verleen Bluetooth-toegang om het batterijniveau van ondersteunde accessoires te lezen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許藍牙存取權限以讀取支援配件的電量。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Надайте доступ до Bluetooth для зчитування рівня заряду підтримуваних аксесуарів."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ge Bluetooth-åtkomst för att läsa batterinivån för tillbehör som stöds."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Povolte přístup k Bluetooth pro čtení úrovně baterie podporovaného příslušenství."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "السماح بالوصول للبلوتوث لقراءة مستويات بطارية الملحقات المدعومة."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समर्थित एक्सेसरीज़ से बैटरी स्तर पढ़ने के लिए ब्लूटूथ एक्सेस की अनुमति दें।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อนุญาตการเข้าถึงบลูทูธเพื่ออ่านระดับแบตเตอรี่จากอุปกรณ์เสริมที่รองรับ"
          }
        }
      }
    },
