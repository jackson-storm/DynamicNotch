    "settings.battery.lowPower2.desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إظهار تحذير عند تفعيل وضع الطاقة المنخفضة أو عند انخفاض البطارية بشكل حرج."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показване на предупреждение, когато Режимът за ниска консумация на енергия е активиран или батерията е критично ниска."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কম পাওয়ার মোড চালু থাকলে বা ব্যাটারি অত্যন্ত কম হলে একটি সতর্কতা দেখান।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra una alerta quan el Mode de baix consum està activat o la bateria és críticament baixa."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobrazit upozornění, když baterie klesne pod stanovený práh."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vis en advarsel, når Energisparefunktion er slået til, eller batteriet er kritisk lavt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warnung anzeigen, wenn der Akkustand unter den Schwellenwert fällt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εμφάνιση προειδοποίησης όταν είναι ενεργή η Λειτουργία χαμηλής ισχύος ή η μπαταρία είναι κρίσιμα χαμηλή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Show a warning when Low Power Mode is enabled or the battery is critically low."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrar una advertencia cuando el modo de bajo consumo está activado o la batería está críticamente baja."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نمایش هشدار هنگامی که حالت کم‌مصرف روشن است یا باتری به شدت ضعیف است."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näytä varoitus, kun Alhaisen virran tila on käytössä tai akku on kriittisen alhainen."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magpakita ng alerto kapag naka-on ang Low Power Mode o kritikal na mababa ang baterya."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afficher une alerte lorsque la batterie passe sous le seuil défini."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הצג התראה כאשר מצב חיסכון בחשמל מופעל או שהסוללה חלשה באופן קריטי."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कम पावर मोड सक्षम होने पर या बैटरी गंभीर रूप से कम होने पर चेतावनी दिखाएं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prikaži upozorenje kada je uključen Način rada niske potrošnje energije ili je baterija kritično slaba."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Figyelmeztetés megjelenítése, ha az Alacsony töltöttségű mód be van kapcsolva vagy az akkumulátor kritikusan alacsony."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tampilkan peringatan saat baterai turun di bawah ambang batas yang ditentukan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra un avviso quando la batteria scende sotto la soglia definita."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バッテリーが設定値未満になったときにアラートを表示します。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Төмен қуат режимі қосулы болғанда немесе батарея өте аз қалғанда ескерту көрсету."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "배터리가 설정된 기준값 이하로 떨어지면 경고를 표시합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
