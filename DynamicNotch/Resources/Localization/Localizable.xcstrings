    "settings.bluetooth.duration2.desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose how long the Bluetooth connection notification stays visible."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige cuánto tiempo permanece visible la notificación de conexión Bluetooth."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите, как долго отображается уведомление о подключении Bluetooth."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择蓝牙连接通知的显示时长。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth bağlantı bildiriminin ne kadar süre görünür kalacağını seçin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle, wie lange die Bluetooth-Verbindungsbenachrichtigung sichtbar bleibt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez combien de temps la notification de connexion Bluetooth reste visible."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha quanto tempo a notificação de ligação Bluetooth permanece visível."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth接続通知を表示し続ける時間を選択します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth 연결 알림이 표시되는 지속 시간을 선택하세요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli per quanto tempo la notifica di connessione Bluetooth rimane visibile."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz, jak długo powiadomienie o połączeniu Bluetooth pozostaje widoczne."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn thời gian thông báo kết nối Bluetooth hiển thị."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih berapa lama notifikasi koneksi Bluetooth tetap terlihat."
          }
        }
      }
    },
    "settings.bluetooth.style.headerDesc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose between a device-focused layout or full device details."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige entre un diseño centrado en el dispositivo o detalles completos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите между компактным отображением устройства или полной детализацией."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在以设备为中心的布局或完整设备详情之间选择。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aygıt odaklı bir düzen ile tüm aygıt ayrıntıları arasında seçim yapın."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle zwischen einem geräteorientierten Layout oder vollständigen Gerätedetails."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez entre une disposition épurée ou les détails complets de l'appareil."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha entre uma apresentação simples ou detalhes completos do dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シンプルなレイアウトか詳細なデバイス情報かを選択します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "깔끔한 레이아웃 또는 기기 세부 정보 표시 중 선택하세요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli tra un layout semplice o i dettagli completi del dispositivo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz między przejrzystym układem a pełnymi szczegółami urządzenia."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn giữa bố cục gọn gàng hoặc chi tiết thiết bị đầy đủ."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih antara tata letak bersih atau detail perangkat lengkap."
          }
        }
      }
    },
