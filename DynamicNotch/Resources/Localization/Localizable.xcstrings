    "settings.notch.gestures.hoverHaptic.desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Produce a soft haptic tick when the cursor enters the collapsed notch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Producir un toque háptico suave cuando el cursor entra en la muesca contraída."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Производить мягкий тактильный щелчок при наведении курсора на свёрнутый вырез."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "光标进入收起的刘海时产生轻柔的触觉反馈。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İmleç daraltılmış çentiğe girdiğinde hafif bir dokunsal geri bildirim ver."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sanftes haptisches Feedback erzeugen, wenn der Zeiger in die geschlossene Notch eintritt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Produire un léger retour haptique lorsque le curseur entre dans l'encoche fermée."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Produzir uma resposta háptica suave quando o cursor entra no notch fechado."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閉じているノッチにカーソルが入ったときに軽い触覚フィードバックを生成します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "커서가 닫힌 노치에 들어갈 때 가벼운 햅틱 피드백을 생성합니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Genera un leggero feedback aptico quando il cursore entra nel notch chiuso."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Generuj delikatną reakcję haptyczną, gdy kursor wejdzie w zamknięty notch."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tạo phản hồi xúc giác nhẹ khi con trỏ đi vào notch đang đóng."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasilkan umpan balik haptik halus saat kursor memasuki notch yang tertutup."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Genereer een lichte voelbare feedback wanneer de aanwijzer de gesloten notch binnengaat."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當游標進入關閉的「瀏海」時產生輕微的觸覺回饋。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Створювати легкий тактильний відгук, коли курсор заходить у закритий notch."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skapa en mjuk haptisk återkoppling när pekaren rör sig över den stängda flärpen."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Generovat jemnou haptickou odezvu, když ukazatel vstoupí do zavřeného výřezu."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تشغيل ردود اللمس عند تحريك المؤشر فوق الشق."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नॉच पर कर्सर ले जाने पर हैप्टिक फीडबैक चलाएं।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เล่นการตอบสนองแบบสัมผัสเมื่อเลื่อนเคอร์เซอร์ไปชี้รอยบาก"
          }
        }
      }
    },
