          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactiver tous les aperçus persistants et fermer tout contenu temporaire."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כבה כל תצוגה מקדימה קבועה וסגור תוכן זמני."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
