    "settings.bluetooth.duration2.desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر مدة بقاء إشعار اتصال البلوتوث مرئياً."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изберете колко време известието за Bluetooth връзка да остане видимо."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ব্লুটুথ সংযোগ বিজ্ঞপ্তি কতক্ষণ দৃশ্যমান থাকবে তা চয়ন করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tria quant de temps es manté visible la notificació de connexió Bluetooth."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zvolte, jak dlouho zůstane oznámení o připojení Bluetooth viditelné."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg, hvor længe Bluetooth-forbindelsesnotifikationen skal være synlig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle, wie lange die Bluetooth-Verbindungsbenachrichtigung sichtbar bleibt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιλέξτε πόση ώρα θα παραμένει ορατή η ειδοποίηση σύνδεσης Bluetooth."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose how long the Bluetooth connection notification stays visible."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige cuánto tiempo permanece visible la notificación de conexión Bluetooth."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مدت زمان نمایان ماندن اعلان اتصال بلوتوث را انتخاب کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valitse, kuinka kauan Bluetooth-yhteysilmoitus pysyy näkyvissä."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piliin kung gaano katagal mananatiling nakikita ang abiso ng koneksyon sa Bluetooth."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez combien de temps la notification de connexion Bluetooth reste visible."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בחר כמה זמן התראת חיבור ה-Bluetooth תישאר גלויה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चुनें कि ब्लूटूथ कनेक्शन सूचना कितने समय तक दिखाई देगी।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odaberite koliko dugo obavijest o povezivanju Bluetootha ostaje vidljiva."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Válassza ki, mennyi ideig maradjon látható a Bluetooth-kapcsolódási értesítés."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih berapa lama notifikasi koneksi Bluetooth tetap terlihat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli per quanto tempo la notifica di connessione Bluetooth rimane visibile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bluetooth接続通知を表示し続ける時間を選択します。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bluetooth қосылым хабарландыруы қанша уақыт көрінетінін таңдаңыз."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bluetooth 연결 알림이 표시되는 지속 시간을 선택하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih berapa lama pemberitahuan sambungan Bluetooth kekal kelihatan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velg hvor lenge Bluetooth-tilkoblingsvarselet skal være synlig."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies hoe lang de Bluetooth-verbindingsmelding zichtbaar blijft."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz, jak długo powiadomienie o połączeniu Bluetooth pozostaje widoczne."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha quanto tempo a notificação de ligação Bluetooth permanece visível."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alegeți cât timp rămâne vizibilă notificarea de conectare Bluetooth."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите, как долго отображается уведомление о подключении Bluetooth."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyberte, ako dlho zostane oznámenie o pripojení Bluetooth viditeľné."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изаберите колико дуго обавештење о повезивању Bluetooth-а остаје видљиво."
          }
        },
