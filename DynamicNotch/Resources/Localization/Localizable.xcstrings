    "settings.nowPlaying.closeDelay.desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر مدة بقاء المشغّل المتوقف مرئياً قبل إغلاق الشق."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изберете колко време плейърът на пауза да остане видим преди затваряне на ноча."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "নচ বন্ধ করার আগে বিরতি দেওয়া প্লেয়ার কতক্ষণ দৃশ্যমান থাকবে তা চয়ন করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tria quant de temps es manté visible el reproductor en pausa abans de tancar el notch."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zvolte, jak dlouho zůstane pozastavený přehrávač viditelný před zavřením výřezu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg, hvor længe den pausede afspiller forbliver synlig, før notchen lukker."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle, wie lange der pausierte Player sichtbar bleibt, bevor die Notch schließt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιλέξτε πόση ώρα θα παραμένει ορατό το πρόγραμμα αναπαραγωγής σε παύση πριν κλείσει το notch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose how long the paused player stays visible before the notch closes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige cuánto tiempo permanece visible el reproductor en pausa antes de cerrarse."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مدت زمان نمایان ماندن پخش‌کننده متوقف شده قبل از بستن ناچ را انتخاب کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valitse, kuinka kauan keskeytetty soitin pysyy näkyvissä ennen notchin sulkeutumista."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piliin kung gaano katagal mananatiling nakikita ang naka-pause na player bago isara ang notch."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez combien de temps le lecteur en pause reste visible avant la fermeture de l'encoche."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
