    "settings.notifications.messages.contacts.description" : {
      "comment" : "Description of the contacts permission for messages.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسمح بالوصول إلى جهات الاتصال لإظهار أسماء المرسلين وصورهم في إشعارات الرسائل."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешете достъп до контактите, за да се показват имената и снимките на подателите в известията от Messages."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Messages বিজ্ঞপ্তিতে প্রেরকের নাম ও ছবি দেখাতে পরিচিতিতে অ্যাক্সেসের অনুমতি দিন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permet l’accés als Contactes per mostrar els noms i les fotos dels remitents a les notificacions de Missatges."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povolte přístup ke Kontaktům, aby se v oznámeních ze Zpráv zobrazovala jména a fotky odesílatelů."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillad adgang til Kontakter for at vise afsendernes navne og billeder i notifikationer fra Beskeder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube den Zugriff auf Kontakte, um Namen und Fotos von Absendern in Mitteilungen von Nachrichten anzuzeigen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιτρέψτε την πρόσβαση στις Επαφές για εμφάνιση των ονομάτων και των φωτογραφιών των αποστολέων στις γνωστοποιήσεις των Μηνυμάτων."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow Contacts access to show sender names and photos in Messages notifications."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite el acceso a Contactos para mostrar los nombres y las fotos de los remitentes en las notificaciones de Mensajes."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای نمایش نام و عکس فرستندگان در اعلان‌های Messages، اجازهٔ دسترسی به مخاطبین را بدهید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salli Yhteystietojen käyttö, jotta lähettäjien nimet ja kuvat näkyvät Viestit-ilmoituksissa."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pahintulutan ang access sa Mga Contact upang ipakita ang mga pangalan at larawan ng nagpadala sa mga notification ng Messages."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisez l’accès aux Contacts pour afficher les noms et les photos des expéditeurs dans les notifications de Messages."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אפשר גישה לאנשי קשר כדי להציג שמות ותמונות של שולחים בעדכוני Messages."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Messages सूचनाओं में भेजने वालों के नाम और फ़ोटो दिखाने के लिए संपर्क ऐक्सेस की अनुमति दें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopustite pristup Kontaktima za prikaz imena i fotografija pošiljatelja u obavijestima aplikacije Poruke."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Engedélyezze a Kontaktok elérését, hogy a feladók neve és fotója megjelenjen az Üzenetek értesítéseiben."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izinkan akses Kontak untuk menampilkan nama dan foto pengirim di pemberitahuan Pesan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consenti l’accesso ai Contatti per mostrare i nomi e le foto dei mittenti nelle notifiche di Messaggi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「メッセージ」の通知に送信者の名前と写真を表示するために、連絡先へのアクセスを許可します。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Messages хабарландыруларында жіберушілердің аттары мен фотосуреттерін көрсету үшін Контактілерге кіруге рұқсат беріңіз."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메시지 알림에 보낸 사람의 이름과 사진을 표시하도록 연락처 접근을 허용합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benarkan akses Kenalan untuk memaparkan nama dan foto pengirim dalam pemberitahuan Mesej."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillat tilgang til Kontakter for å vise avsendernes navn og bilder i varslinger fra Meldinger."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sta toegang tot Contacten toe om namen en foto’s van afzenders in meldingen van Berichten weer te geven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zezwól na dostęp do Kontaktów, aby wyświetlać nazwy i zdjęcia nadawców w powiadomieniach z Wiadomości."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permita o acesso aos Contactos para mostrar os nomes e as fotografias dos remetentes nas notificações de Mensagens."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permiteți accesul la Contacte pentru a afișa numele și pozele expeditorilor în notificările Mesaje."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешите доступ к контактам, чтобы показывать имена и фотографии отправителей в уведомлениях «Сообщений»."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povoľte prístup ku Kontaktom, aby sa v hláseniach zo Správ zobrazovali mená a fotky odosielateľov."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дозволите приступ Контактима за приказ имена и фотографија пошиљалаца у обавештењима апликације Поруке."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillåt åtkomst till Kontakter för att visa avsändarnas namn och bilder i notiser från Meddelanden."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อนุญาตการเข้าถึงรายชื่อเพื่อแสดงชื่อและรูปภาพของผู้ส่งในการแจ้งเตือนแอปข้อความ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mesajlar bildirimlerinde gönderenlerin adlarını ve fotoğraflarını göstermek için Kişiler erişimine izin verin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Надайте доступ до Контактів, щоб показувати імена та фотографії відправників у сповіщеннях Повідомлень."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cho phép truy cập Danh bạ để hiển thị tên và ảnh của người gửi trong thông báo Tin nhắn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许访问通讯录，以便在“信息”通知中显示发件人姓名和照片。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允許取用聯絡人，以便在「訊息」通知中顯示傳送者姓名和照片。"
          }
        }
      }
    },
