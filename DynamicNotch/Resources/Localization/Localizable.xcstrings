    "settings.calendar.noticeMinutes.desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose how early an event notice appears before it starts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige con cuánta antelación aparece el aviso de un evento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите, за сколько минут до начала появляется уведомление."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择事件开始前多早显示提醒。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etkinlik uyarısının başlamadan ne kadar önce görüneceğini seçin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle, wie früh vor Beginn eine Ereigniserinnerung erscheint."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez combien de temps à l'avance la notification d'événement apparaît."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha com quanta antecedência deve surgir o aviso do evento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "イベント通知を表示する事前時間を選択します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이벤트 알림이 미리 표시될 시간을 선택하세요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli quanto tempo prima mostrare l'avviso dell'evento."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz, z jakim wyprzedzeniem ma pojawić się powiadomienie o wydarzeniu."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn thời gian hiển thị thông báo sự kiện trước."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih berapa lama sebelumnya notifikasi acara muncul."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies hoe lang van tevoren de gebeurteniswaarschuwing moet worden weergegeven."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇提前多久顯示行程提醒。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть, за скільки часу показувати сповіщення про подію."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj hur lång tid i förväg händelsevarningen ska visas."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvolte, s jakým předstihem zobrazit upozornění na událost."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر متى يظهر إشعار الحدث قبل بدايته."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चुनें कि ईवेंट शुरू होने से कितने समय पहले नोटिस दिखाई दे।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกว่าจะให้การแจ้งเตือนกิจกรรมปรากฏล่วงหน้านานเท่าใดก่อนเริ่ม"
          }
        }
      }
    },
