          "stringUnit": {
            "state": "translated",
            "value": "Tıklama, üzerine gelme ve kaydırma hareketlerini yapılandırın."
          }
        }
      }
    },
    "settings.notch.gestures.swipeDismissAndRestore.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow vertical swipe gestures over the notch to hide the active activity or restore the recently dismissed one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite gestos de deslizamiento vertical sobre la muesca para ocultar la actividad activa o restaurar la recientemente cerrada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешить вертикальные свайпы по вырезу для скрытия активной панели или восстановления недавно закрытой."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许在刘海上进行垂直滑动以隐藏活动内容或恢复最近关闭的内容。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çentik üzerindeki dikey kaydırma hareketlerinin etkin etkinliği gizlemesine veya son kapatılanı geri getirmesine izin ver."
          }
        }
      }
    },
    "settings.notch.gestures.swipeDismissAndRestore.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swipe up to hide / down to restore"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza hacia arriba para ocultar / abajo para restaurar"
          }
        },
