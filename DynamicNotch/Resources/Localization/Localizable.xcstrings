    "settings.nowPlaying.withoutCloseTimer.desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إبقاء \"يُعرض الآن\" مرئياً في الشق أثناء الإيقاف المؤقت."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запазване на Възпроизвежда се видимо в ноча, докато възпроизвеждането е на пауза."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "প্লেব্যাক বিরতি থাকা অবস্থায় নচে এখন বাজছে দৃশ্যমান রাখুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén Reproduint ara visible al notch mentre la reproducció està en pausa."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ponechat 'Právě hraje' viditelné ve výřezu i při pozastavení přehrávání."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold Afspiller nu synlig i notchen, mens afspilning er på pause."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktuelle Wiedergabe auch bei pausierter Wiedergabe in der Notch geöffnet lassen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Διατήρηση του Τώρα αναπαράγεται ορατού στο notch όταν η αναπαραγωγή είναι σε παύση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep Now Playing visible in the notch while playback is paused."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantener Reproducción visible en la muesca mientras la reproducción está en pausa."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نمایان نگه داشتن در حال پخش در ناچ هنگام توقف پخش."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pidä Nyt toistetaan näkyvissä notchissa toiston ollessa keskeytettynä."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Panatilihing nakikita ang Kasalukuyang Tumutugtog sa notch habang naka-pause ang playback."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Garder À l'écoute visible dans l'encoche même lorsque la lecture est en pause."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "השאר את מנגן כעת גלוי במגרעת בזמן שההשמעה מושהית."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्लेबैक रुकने पर 'अब चल रहा है' को नॉच में दृश्यमान रखें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zadržite Sada se reproducira vidljivim u urezu dok je reprodukcija pauzirana."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Most játszott láthatóan tartása a notch-ban szüneteltetés esetén is."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biarkan Sedang Diputar tetap terlihat di notch bahkan saat pemutaran dijeda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantieni In riproduzione visibile nel notch anche quando la riproduzione è in pausa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再生が一時停止されている場合でも、ノッチに「再生中」を表示したままにします。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ойнату кідіртілгенде Қазір ойналуда әрекетін ойықта ұстап тұру."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "재생이 일시정지된 경우에도 노치에 지금 재생 중을 계속 표시합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kekalkan Sedang Dimainkan kelihatan di notch semasa main balik dijeda."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold Spilles nå synlig i notchen mens avspilling er satt på pause."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd Huidige zichtbaar in de notch, zelfs wanneer het afspelen is gepauzeerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utrzymuj Teraz odtwarzane widoczne w notchu nawet po wstrzymaniu odtwarzania."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manter A reproduzir visível no notch mesmo quando a reprodução estiver pausada."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Păstrați În redare vizibil în notch când redarea este întreruptă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оставлять Сейчас играет видимым в вырезе при приостановке воспроизведения."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ponechať Práve hrá viditeľné vo výreze, kým je prehrávanie pozastavené."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Задржите Сада се пушта видљивим у ночу док је репродукција паузирана."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Håll 'Spelas nu' synlig i flärpen även när uppspelningen är pausad."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แสดงกำลังเล่นในรอยบากค้างไว้แม้จะหยุดเล่นชั่วคราว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oynatma duraklatıldığında Çalınıyor'u çentikte görünür tut."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Залишати «Зараз грає» видимим у вирізі notch навіть під час паузи."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giữ Đang phát hiển thị trong notch ngay cả khi quá trình phát lại bị tạm dừng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "播放暂停时保持正在播放在刘海中可见。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即使暫停播放，也讓「播放中」在「瀏海」中保持可見。"
          }
        }
      }
    },
