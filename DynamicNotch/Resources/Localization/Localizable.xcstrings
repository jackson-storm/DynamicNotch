          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piliin kung ang alerto ay gumagamit ng detalyadong card o compact na estilo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez le style de l'alerte de batterie faible."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בחר אם ההתראה משתמשת בכרטיס מפורט או בסגנון קומפקטי."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चुनें कि चेतावनी विस्तृत कार्ड का उपयोग करे या कॉम्पैक्ट शैली का।"
          }
        },
        "hr" : {
          "stringUnit" : {
