    "settings.screenRecording.duration.desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ضبط توقيت الإخفاء التلقائي لإشعار التسجيل."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Регулирайте времето за автоматично отхвърляне на известието за запис."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "রেকর্ডিং বিজ্ঞপ্তির স্বয়ংক্রিয় খারিজের সময় সামঞ্জস্য করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajusta el temps de descart automàtic de la notificació de gravació."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upravte dobu před automatickým zavřením oznámení o nahrávání."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Juster automatisk afvisningstid for optagelsesnotifikationen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dauer der Aufnahmebenachrichtigung vor automatischem Schließen einstellen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ρύθμιση χρόνου αυτόματης απόρριψης της ειδοποίησης εγγραφής."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adjust auto-dismiss timing of the recording notification."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajustar el tiempo de cierre automático de la notificación de grabación."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تنظیم زمان بستن خودکار اعلان ضبط."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Säädä tallennusilmoituksen automaattisen hylkäämisen ajoitusta."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayusin ang oras ng awtomatikong pag-dismiss ng abiso ng pag-record."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajuster le délai avant la fermeture automatique de la notification d'enregistrement."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כוונן את זמן הביטול האוטומטי של התראת ההקלטה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
