    "settings.wifi.hotspot.desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show a live activity while Personal Hotspot is enabled."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar actividad en vivo mientras el Punto de acceso personal está activado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывать живую активность при включённом Режиме модема."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "个人热点开启时显示实时活动。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kişisel Erişim Noktası etkinken canlı etkinlik göster."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Live-Aktivität anzeigen, während ein Persönlicher Hotspot aktiv ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher une activité en direct lorsque le partage de connexion est activé."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar uma atividade em tempo real quando a partilha de internet estiver ativa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インターネット共有が有効なときにライブアクティビティを表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개인용 핫스팟이 활성화되었을 때 실시간 활동을 표시합니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra un'attività in tempo reale quando l'hotspot è attivo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokaż aktywność na żywo, gdy hotspot jest aktywny."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiển thị hoạt động trực tiếp khi điểm phát sóng đang hoạt động."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tampilkan aktivitas langsung saat hotspot aktif."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toon een live activiteit wanneer de persoonlijke hotspot actief is."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當個人熱點處於作用中時顯示即時活動。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показувати активність наживо, коли увімкнено власну точку доступу."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visa en liveaktivitet när internetdelning är aktiv."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazit živou aktivitu při aktivním osobním hotspotu."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إظهار نشاط مباشر أثناء تفعيل نقطة الاتصال الشخصية."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "व्यक्तिगत हॉटस्पॉट सक्षम होने पर लाइव गतिविधि दिखाएं।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงกิจกรรมสดขณะเปิดใช้งานฮอตสปอตส่วนบุคคล"
          }
        }
      }
    },
